#!/usr/bin/env python3
"""Preview and run a bounded repository-policy pass over saved PR closure proposals."""

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _evidence import canonical, digest
from _triage import REPO


def script(name, *args):
    result = subprocess.run([str(Path(__file__).absolute().with_name(name)), *args], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or f"{name} failed")

    return json.loads(result.stdout)


def select(numbers):
    if not numbers or len(numbers) > 20 or len(numbers) != len(set(numbers)) or any(number < 1 for number in numbers):
        raise ValueError("select one to twenty distinct PR numbers")

    policy = script("action-policy", "status", "--expected-repo", REPO)
    settings = {row["name"]: row for row in policy["actions"]}
    listing = script("auto-close", "--expected-repo", REPO, "list")
    proposals = {row["number"]: row for row in listing["rows"]}
    chosen = []
    for number in numbers:
        row = proposals.get(number)
        if row is None or not row["active"] or not row.get("action"):
            raise ValueError(f"PR #{number} has no active action-bound closure proposal")

        setting = settings.get(row["action"])
        if setting is None or setting["operation"] != "close":
            raise ValueError(f"PR #{number} no longer has a configured close action")

        reviewed = script("auto-close", "--expected-repo", REPO, "review", "--number", str(number))
        exact = reviewed["plan"]["proposals"][0]
        if exact["checkpoint"] != row["checkpoint"] or exact["comment"] != row["comment"]:
            raise ValueError(f"PR #{number} changed during action preview")

        evidence = (row.get("inputs") or {}).get("evidence") or []
        complete_target = any(selected["kind"] == "pr" and selected["number"] == number and
                              all(component["status"] in ("complete", "not_applicable") for component in selected["components"].values())
                              for selected in evidence)
        eligible = complete_target and not row["inputs"].get("evidence_gaps") and not row.get("reconsideration")
        mode = "execute" if setting["mode"] == "execute" and setting["configured"] and eligible else "stage"
        chosen.append(dict(number=number, action=row["action"], operation="close", mode=mode,
                           policy_mode=setting["mode"], eligible=eligible, target=row["target"], comment=row["comment"],
                           proposal_checkpoint=row["checkpoint"], definition_sha256=setting["definition_sha256"],
                           evidence_gaps=row["inputs"].get("evidence_gaps", [])))

    plan = dict(version=1, repository=REPO, operation="pr-closure-action-pass", items=chosen)
    return dict(plan=plan, preview_sha256=digest(canonical(plan)), requests=0)


def run(numbers, preview_sha256):
    current = select(numbers)
    if current["preview_sha256"] != preview_sha256:
        raise ValueError("action proposals or policy changed; preview the selected pass again")

    executing = [item["number"] for item in current["plan"]["items"] if item["mode"] == "execute"]
    results = [dict(number=item["number"], status="staged") for item in current["plan"]["items"] if item["mode"] == "stage"]
    if executing:
        selection = [part for number in executing for part in ("--number", str(number))]
        reviewed = script("auto-close", "--expected-repo", REPO, "review", *selection)
        execution = script("auto-close", "--expected-repo", REPO, "execute", *selection, "--publish", "--approve", reviewed["approval"], "--automation")
        results.extend(execution["results"])

    return dict(repository=REPO, results=results)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("preview", "run"))
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--number", type=int, action="append", required=True)
    parser.add_argument("--preview-sha256")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        raise ValueError("configured repository changed; preview the action pass again")
    if args.command == "run" and not args.preview_sha256:
        raise ValueError("run requires the exact preview hash")
    if args.command == "preview" and args.preview_sha256:
        raise ValueError("preview does not accept a prior hash")

    result = select(args.number) if args.command == "preview" else run(args.number, args.preview_sha256)
    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        sys.exit(f"error: {error}")
