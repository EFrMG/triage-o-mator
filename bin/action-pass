#!/usr/bin/env python3
"""Preview and run a bounded repository-policy pass over saved action proposals."""

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _evidence import canonical, digest
from _triage import REPO, action_operation, load_taxonomy


def script(name, *args):
    result = subprocess.run([str(Path(__file__).absolute().with_name(name)), *args], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or f"{name} failed")

    return json.loads(result.stdout)


def selection(numbers, items):
    keys = [("pr", number) for number in numbers]
    for token in items:
        parts = token.split(":", 1)
        if len(parts) != 2 or parts[0] not in ("issue", "pr") or not parts[1].isdigit() or int(parts[1]) < 1:
            raise ValueError("select items as issue:NUMBER or pr:NUMBER")
        keys.append((parts[0], int(parts[1])))

    if not keys or len(keys) > 20 or len(keys) != len(set(keys)) or any(number < 1 for _, number in keys):
        raise ValueError("select one to twenty distinct item keys")

    return keys


def select(keys):
    policy = script("action-policy", "status", "--expected-repo", REPO)
    settings = {row["name"]: row for row in policy["actions"]}
    taxonomy = load_taxonomy()
    proposals = {(row["kind"], row["number"]): row for row in script("action-proposals", "--expected-repo", REPO, "list")["rows"]}
    chosen = []
    for kind, number in keys:
        row = proposals.get((kind, number))
        if row is None or not row["active"] or not row.get("action"):
            raise ValueError(f"{kind} #{number} has no active action-bound proposal")

        setting = settings.get(row["action"])
        operation = row["operation"]
        if setting is None and row["action"] not in taxonomy.get("actions", []) and action_operation(taxonomy, row["action"]) == operation:
            setting = dict(operation=operation, mode="stage", configured=False, definition_sha256="")
        if setting is None or setting["operation"] != operation:
            raise ValueError(f"{kind} #{number} no longer has the selected action operation")

        if not row.get("decision_question"):
            reviewed = script("action-proposals", "--expected-repo", REPO, "review", "--kind", kind, "--number", str(number))
            exact = reviewed["plan"]["proposals"][0]
            if exact["checkpoint"] != row["checkpoint"] or exact["comment"] != row["comment"]:
                raise ValueError(f"{kind} #{number} changed during action preview")

        evidence = (row.get("inputs") or {}).get("evidence") or []
        complete_target = any(selected["kind"] == kind and selected["number"] == number and
                              all(component["status"] in ("complete", "not_applicable") for component in selected["components"].values())
                              for selected in evidence)
        eligible = complete_target and not row["inputs"].get("evidence_gaps") and not row.get("reconsideration") and not row.get("decision_question")
        mode = "execute" if setting["mode"] == "execute" and setting["configured"] and eligible else "stage"
        chosen.append(dict(kind=kind, number=number, action=row["action"], operation=operation, mode=mode,
                           policy_mode=setting["mode"], eligible=eligible, target=row["target"], comment=row["comment"],
                           proposal_checkpoint=row["checkpoint"], definition_sha256=setting["definition_sha256"],
                           evidence_gaps=row["inputs"].get("evidence_gaps", []), decision_question=row.get("decision_question")))

    plan = dict(version=1, repository=REPO, operation="automated-actions", items=chosen)
    return dict(plan=plan, preview_sha256=digest(canonical(plan)), requests=0)


def run(keys, preview_sha256):
    current = select(keys)
    if current["preview_sha256"] != preview_sha256:
        raise ValueError("action proposals or policy changed; preview the selected pass again")

    results = []
    for item in current["plan"]["items"]:
        if item["mode"] == "stage":
            results.append(dict(kind=item["kind"], number=item["number"], status="staged"))
            continue

        target_args = ("--kind", item["kind"], "--number", str(item["number"]))
        reviewed = script("action-proposals", "--expected-repo", REPO, "review", *target_args)
        row = reviewed["plan"]["proposals"][0]
        if row["checkpoint"] != item["proposal_checkpoint"] or row["comment"] != item["comment"] or row.get("action") != item["action"]:
            raise ValueError("action proposal changed after the selected preview; stop before writing")

        outcome = script("action-proposals", "--expected-repo", REPO, "execute", *target_args, "--publish", "--approve", reviewed["approval"], "--automation")
        results.extend(outcome["results"])

    return dict(repository=REPO, results=results)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("preview", "run"))
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--number", type=int, action="append", default=[], help="PR number (alias for --item pr:NUMBER)")
    parser.add_argument("--item", action="append", default=[], help="explicit KIND:NUMBER item key")
    parser.add_argument("--preview-sha256")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        raise ValueError("configured repository changed; preview the action pass again")
    if args.command == "run" and not args.preview_sha256:
        raise ValueError("run requires the exact preview hash")
    if args.command == "preview" and args.preview_sha256:
        raise ValueError("preview does not accept a prior hash")

    keys = selection(args.number, args.item)
    result = select(keys) if args.command == "preview" else run(keys, args.preview_sha256)
    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        sys.exit(f"error: {error}")
