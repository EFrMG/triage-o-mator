#!/usr/bin/env python3
"""Save and execute exact issue and PR actions through comment-plus."""

import argparse
import json
import re
import subprocess
import sys
import uuid
from contextlib import nullcontext
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).absolute().parent))

from _action_proposal_records import feedback as proposal_feedback, load, proposal_path, valid_decision_hold
from _evidence import canonical, digest, validate_payload
from _item_context import ContextIndex, read as read_item_context
from _groups import load_group
from _storage import atomic_writer, locked
from _triage import DATA_DIR, action_operation, load_taxonomy, now_iso, read_repo


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    value.pop("checksum", None)
    value["checksum"] = digest(canonical(value))
    with atomic_writer(path) as out:
        out.write(canonical(value) + "\n")


def all_proposals(repo):
    directory = DATA_DIR / "action-proposals"
    if not directory.exists():
        return []
    if directory.is_symlink() or not directory.is_dir():
        raise ValueError("invalid action proposal directory")

    records = []
    for path in sorted(directory.iterdir()):
        if path.name == "local":
            continue
        if not re.fullmatch(r"(?:issue|pr)-[1-9][0-9]*\.json", path.name):
            raise ValueError(f"unrecognized action proposal file: {path.name}")
        records.append(load(path, repo))

    return records


def local_state(repo):
    path = DATA_DIR / "local" / "action-proposals-state.json"
    if path.parent.is_symlink() or path.is_symlink():
        raise ValueError("invalid action proposal presentation state")
    if not path.exists():
        return dict(repository=repo, rows={})

    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("repository") != repo or not isinstance(value.get("rows"), dict):
        raise ValueError("action proposal presentation state belongs to another repository")

    return value


def row(value, state):
    key = f"{value['kind']}:{value['number']}"
    presentation = state["rows"].get(key, {})
    visible = presentation.get("dismissed_checkpoint") != value["checksum"]
    active = value["status"] == "pending" and visible
    result = dict(kind=value["kind"], number=value["number"], title=value["title"], target=value["target"],
                  action=value.get("action"), operation=value["operation"], comment=value["comment"],
                  updated_at=value["updated_at"], head_sha=value.get("head_sha"), status=value["status"],
                  checkpoint=value["checksum"], active=active, needs_attention=visible and value["status"] in ("pending", "uncertain") and presentation.get("viewed_checkpoint") != value["checksum"],
                  dismissed=not visible, inputs=value["inputs"], outcome=value.get("outcome"), reference=value.get("reference"))
    if "decision_question" in value:
        result["decision_question"] = value["decision_question"]
    if "decision_resolution" in value:
        result["decision_resolution"] = value["decision_resolution"]
    for field in ("rejection", "reconsideration"):
        if field in value:
            result[field] = value[field]

    return result


def selected_evidence(cache, kind, number, snapshot_id):
    manifest = cache.load_manifest(snapshot_id)
    record = next((item for item in manifest["items"] if (item["identity"]["kind"], item["identity"]["number"]) == (kind, number)), None)
    if record is None:
        raise ValueError("selected evidence item is absent from its snapshot")

    for name, component in record["components"].items():
        if component["object"] is not None:
            validate_payload(name, component, kind, cache.read_object(component["object"]))

    return dict(kind=kind, number=number, snapshot_id=snapshot_id, repository=manifest["repository"],
                identity=record["identity"], revision=record["revision"],
                components={name: dict(status=component["status"], object=component["object"]) for name, component in record["components"].items()})


def evidence_selection(repo, host, tokens):
    if not tokens:
        return []

    from _cache import EvidenceCache
    from _evidence import repository

    cache = EvidenceCache(repository(repo, host=host))
    selected = []
    seen = set()
    for token in tokens:
        parts = token.split(":", 2)
        if len(parts) != 3 or parts[0] not in ("issue", "pr") or not parts[1].isdigit() or int(parts[1]) < 1:
            raise ValueError("invalid --evidence; expected KIND:NUMBER:SNAPSHOT_ID")
        key = (parts[0], int(parts[1]), parts[2])
        if key in seen:
            raise ValueError("repeated evidence selection")
        seen.add(key)
        selected.append(selected_evidence(cache, *key))

    return selected


def check_current(value, completed_batch=None):
    index = ContextIndex(completed_batch=completed_batch)
    current = index.collect(value["kind"], value["number"], include_rows=False)
    if current["checkpoint"] != value["inputs"]["context_checkpoint"]:
        raise ValueError("local item guidance changed; prepare a fresh action proposal")

    handoff = value["inputs"].get("group")
    if handoff is not None:
        group = load_group(handoff["id"])
        if group["status"] == "archived" or group["revision"] != handoff["revision"]:
            raise ValueError("group handoff changed; export it and review again")

        members = [(member["kind"], member["number"]) for member in group["members"]]
        declared = [(member["kind"], member["number"]) for member in handoff["members"]]
        if members != declared or (value["kind"], value["number"]) not in members:
            raise ValueError("group handoff members changed; export and review again")

        for member in handoff["members"]:
            observed = index.collect(member["kind"], member["number"], include_rows=False)
            if observed["checkpoint"] != member["checkpoint"]:
                raise ValueError(f"group member context changed for {member['kind']} #{member['number']}; prepare a fresh proposal")

    if value["inputs"]["evidence"]:
        from _cache import EvidenceCache
        from _evidence import repository

        cache = EvidenceCache(repository(value["repo"], host=value["host"]))
        for selected in value["inputs"]["evidence"]:
            try:
                verified = selected_evidence(cache, selected["kind"], selected["number"], selected["snapshot_id"])
            except (OSError, ValueError, KeyError, TypeError) as error:
                raise ValueError("selected evidence is unavailable; restore it or replace the proposal") from error
            if verified != selected:
                raise ValueError("selected action evidence changed; replace the proposal")


def inspect(repo, host, kind, number):
    if not re.fullmatch(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", host) or number < 1:
        raise ValueError("invalid action host or number")

    def get(endpoint):
        result = subprocess.run(["gh", "api", "--hostname", host, "--method", "GET", endpoint], capture_output=True, text=True, timeout=60)
        if result.returncode:
            raise ValueError(result.stderr.strip() or "GitHub read failed")
        return json.loads(result.stdout)

    target = f"https://{host}/{repo}/{'pull' if kind == 'pr' else 'issues'}/{number}"
    issue = get(f"repos/{repo}/issues/{number}")
    if not isinstance(issue, dict) or issue.get("html_url") != target or issue.get("number") != number or issue.get("state") not in ("open", "closed") or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", issue.get("updated_at") or "") or ("pull_request" in issue) != (kind == "pr"):
        raise ValueError("live item differs from the selected target")

    head = None
    title = issue.get("title")
    if kind == "pr":
        pull = get(f"repos/{repo}/pulls/{number}")
        head = (pull.get("head") or {}).get("sha") if isinstance(pull, dict) else None
        if not isinstance(pull, dict) or pull.get("html_url") != target or pull.get("number") != number or pull.get("state") != issue["state"] or not re.fullmatch(r"[0-9a-f]{40}", head or "") or pull.get("merged_at") is not None or pull.get("merged") is True:
            raise ValueError("pull request is merged or differs from the selected target")
        title = pull.get("title")

    if not isinstance(title, str) or not title.strip():
        raise ValueError("live item has no usable title")

    return dict(repository=repo, kind=kind, number=number, target=target, title=title, state=issue["state"],
                updated_at=issue["updated_at"], head_sha=head, requests=2 if kind == "pr" else 1)


def valid_comment(text):
    return bool(text.strip()) and len(text) <= 65536 and not any((ord(char) < 32 and char not in "\n\t") or 127 <= ord(char) <= 159 for char in text)


def valid_short_text(text, limit):
    return isinstance(text, str) and bool(text.strip()) and len(text) <= limit and not any((ord(char) < 32 and char not in "\n\t") or 127 <= ord(char) <= 159 for char in text)


def propose(args, repo):
    taxonomy = load_taxonomy()
    operation = action_operation(taxonomy, args.action) if args.action else args.operation
    retired_action = args.action is not None and args.action not in taxonomy.get("actions", [])
    if operation not in ("comment", "close", "reopen") or args.operation and args.operation != operation or retired_action and not args.replace_checkpoint:
        raise ValueError("selected action is not a configured writing type")
    if args.action is None and (args.kind != "pr" or operation != "close"):
        raise ValueError("only a PR closure recommendation may omit the saved ledger action")
    if args.number < 1 or not re.fullmatch(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", args.host) or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", args.updated_at):
        raise ValueError("invalid action target or observed update time")
    if args.kind == "pr" and not re.fullmatch(r"[0-9a-f]{40}", args.head_sha or "") or args.kind == "issue" and args.head_sha:
        raise ValueError("PR actions require a head SHA; issue actions cannot have one")
    if operation == "close" and args.observed_state != "open" or operation == "reopen" and args.observed_state != "closed":
        raise ValueError("observed state does not permit the selected action")
    if not valid_short_text(args.title, 1000) or not valid_short_text(args.by, 200):
        raise ValueError("title and proposer are required")
    if args.reconsideration_reason is not None and not valid_short_text(args.reconsideration_reason, 10000):
        raise ValueError("reconsideration needs a valid explanation")
    if args.decision_question is not None and not valid_short_text(args.decision_question, 2000):
        raise ValueError("human decision question must be valid text of at most 2000 characters")

    comment = args.comment_file.read_text(encoding="utf-8")
    if not valid_comment(comment):
        raise ValueError("action comment must contain valid text of at most 65536 characters")

    context = ContextIndex().collect(args.kind, args.number, include_rows=False)
    if context["checkpoint"] != args.context_checkpoint or args.action is not None and (context["ledger_guidance"] is None or context["ledger_guidance"]["action"] != args.action):
        raise ValueError("saved action or local guidance changed; read item-context again")

    reference = None
    if bool(args.reference_kind) != bool(args.reference_number) or args.reference_number is not None and args.reference_number < 1:
        raise ValueError("reference kind and positive number must be supplied together")
    if args.reference_kind:
        if args.kind != "pr" or operation != "close":
            raise ValueError("a reference belongs to a PR closure proposal")
        reference = dict(kind=args.reference_kind, number=args.reference_number)

    group_input = None
    if args.group_id is not None:
        if args.kind != "pr" or operation != "close":
            raise ValueError("a group handoff belongs to a PR closure proposal")
        group = load_group(args.group_id)
        if group["status"] == "archived" or not any(member["kind"] == "pr" and member["number"] == args.number for member in group["members"]):
            raise ValueError("selected PR is not in an active handoff group")

        declared = {}
        for token in args.member_context:
            parts = token.split(":", 2)
            if len(parts) != 3 or parts[0] not in ("pr", "issue") or not parts[1].isdigit() or int(parts[1]) < 1 or (parts[0], int(parts[1])) in declared:
                raise ValueError("invalid or repeated --member-context; expected KIND:NUMBER:CHECKPOINT")
            declared[(parts[0], int(parts[1]))] = parts[2]

        members = {(member["kind"], member["number"]) for member in group["members"]}
        if set(declared) != members:
            raise ValueError("declared group members differ from the current handoff")

        contexts = []
        for member in group["members"]:
            selected = ContextIndex().collect(member["kind"], member["number"], include_rows=False)
            if declared[(member["kind"], member["number"])] != selected["checkpoint"]:
                raise ValueError("group member context changed; export the group again")
            contexts.append(dict(kind=member["kind"], number=member["number"], context_revision=selected["context_revision"],
                                 feedback_checkpoint=selected["feedback_checkpoint"], checkpoint=selected["checkpoint"]))

        group_input = dict(id=group["id"], revision=group["revision"], members=contexts)
    elif args.member_context:
        raise ValueError("--member-context requires --group-id")

    evidence = evidence_selection(repo, args.host, args.evidence)
    if not evidence and not args.evidence_gap:
        raise ValueError("declare selected evidence or an explicit evidence gap")
    if any(not gap.strip() or len(gap) > 2000 for gap in args.evidence_gap):
        raise ValueError("evidence gaps must be nonempty text of at most 2000 characters")

    inputs = dict(context_checkpoint=context["checkpoint"], context_revision=context["context_revision"],
                  feedback_checkpoint=context["feedback_checkpoint"], group=group_input, evidence=evidence, evidence_gaps=args.evidence_gap)
    value = dict(schema_version=1, artifact="action-proposal", repo=repo, host=args.host, kind=args.kind, number=args.number,
                 target=f"https://{args.host}/{repo}/{'pull' if args.kind == 'pr' else 'issues'}/{args.number}",
                 title=args.title, action=args.action, operation=operation, comment=comment, updated_at=args.updated_at,
                 observed_state=args.observed_state, proposed_by=args.by, proposed_at=now_iso(), request_id=str(uuid.uuid4()),
                 status="pending", inputs=inputs)
    if args.kind == "pr":
        value["head_sha"] = args.head_sha
    if reference is not None:
        value["reference"] = reference
    if args.decision_question is not None:
        value["decision_question"] = args.decision_question

    path = proposal_path(args.kind, args.number)
    if path.parent.is_symlink():
        raise ValueError("invalid action proposal directory")
    guard = DATA_DIR / "action-proposals" / f"pr-{args.number}-selection" if args.kind == "pr" else path
    with (locked(guard) if args.kind == "pr" else nullcontext()), locked(path):
        if path.exists():
            previous = load(path, repo)
            receipt = DATA_DIR / "writes" / (previous["request_id"] + ".json")
            completed = previous["status"] == "executed"
            if args.replace_checkpoint != previous["checksum"] or previous["status"] not in ("pending", "rejected", "executed"):
                raise ValueError("action proposal changed or has an unresolved write attempt; inspect it before replacing")
            if completed:
                if receipt.parent.is_symlink() or receipt.is_symlink() or not receipt.is_file():
                    raise ValueError("completed action has no saved write receipt")
                saved = json.loads(receipt.read_text(encoding="utf-8"))
                plan = saved.get("plan") if isinstance(saved, dict) else None

                if (not isinstance(plan, dict) or plan.get("request_id") != previous["request_id"] or
                        plan.get("repo") != repo or plan.get("kind") != args.kind or plan.get("number") != args.number or
                        plan.get("target") != previous["target"] or plan.get("operation") != previous["operation"] or
                        plan.get("body") != previous["comment"] or
                        saved.get("comment") != previous["outcome"]["comment"] or
                        saved.get("state_change") != previous["outcome"]["state_change"]):
                    raise ValueError("completed action differs from its saved write receipt")
            elif receipt.exists() or receipt.is_symlink():
                raise ValueError("action proposal has a write attempt; inspect it before replacing")
            if retired_action and previous.get("action") != args.action:
                raise ValueError("a retired action can only edit its existing proposal")
            if completed:
                if args.reconsideration_reason:
                    raise ValueError("reconsideration applies only to a rejected proposal")
            elif previous.get("decision_question"):
                question = args.decision_question or previous["decision_question"]
                value["decision_question"] = question
                if question == previous["decision_question"]:
                    if "decision_review" in previous:
                        value["decision_review"] = previous["decision_review"]
                    if value["target"] == previous["target"] and value["operation"] == previous["operation"] and value["action"] == previous["action"] and "decision_resolution" in previous:
                        value["decision_resolution"] = previous["decision_resolution"]
            elif "decision_resolution" in previous and args.decision_question is None:
                value["decision_resolution"] = previous["decision_resolution"]
            if previous["status"] == "rejected":
                if not args.reconsideration_reason or not args.reconsideration_reason.strip():
                    raise ValueError("reconsidering a rejected action requires an attributed explanation")
                value["reconsideration"] = dict(by=args.by, at=value["proposed_at"], reason=args.reconsideration_reason,
                                                rejected_checkpoint=previous["checksum"])
            elif args.reconsideration_reason:
                raise ValueError("reconsideration requires a rejected action proposal")
            elif not completed and "reconsideration" in previous:
                value["reconsideration"] = previous["reconsideration"]

            value["history"] = previous.get("history", []) + [{key: item for key, item in previous.items() if key != "history"}]
        elif args.replace_checkpoint or args.reconsideration_reason:
            raise ValueError("there is no replaceable proposal at that checkpoint")

        if not valid_decision_hold(value):
            raise ValueError("human decision resolution does not bind the held proposal")
        save(path, value)

    return row(value, local_state(repo))


def edit(args, repo):
    previous = load(proposal_path(args.kind, args.number), repo)
    if previous["checksum"] != args.checkpoint or previous["status"] != "pending":
        raise ValueError("action proposal changed; reopen Notifications")
    if (DATA_DIR / "writes" / (previous["request_id"] + ".json")).exists():
        raise ValueError("action proposal has a write attempt; reconcile it before editing")

    text = args.comment_file.read_text(encoding="utf-8")
    if text == previous["comment"]:
        raise ValueError("action comment is unchanged")

    replacement = argparse.Namespace(kind=args.kind, number=args.number, action=previous["action"], title=previous["title"],
                                     host=previous["host"], updated_at=previous["updated_at"], head_sha=previous.get("head_sha"),
                                     observed_state=previous["observed_state"], comment_file=args.comment_file, by=args.by,
                                     context_checkpoint=previous["inputs"]["context_checkpoint"],
                                     evidence=[f"{item['kind']}:{item['number']}:{item['snapshot_id']}" for item in previous["inputs"]["evidence"]],
                                     evidence_gap=previous["inputs"]["evidence_gaps"], replace_checkpoint=args.checkpoint,
                                     reconsideration_reason=None, decision_question=previous.get("decision_question"),
                                     operation=previous["operation"], reference_kind=(previous.get("reference") or {}).get("kind"),
                                     reference_number=(previous.get("reference") or {}).get("number"),
                                     group_id=(previous["inputs"].get("group") or {}).get("id"),
                                     member_context=[f"{member['kind']}:{member['number']}:{member['checkpoint']}" for member in (previous["inputs"].get("group") or {}).get("members", [])])
    return propose(replacement, repo)


def answer(repo, kind, number, checkpoint, by, text):
    if not valid_short_text(by, 200) or not valid_short_text(text, 10000):
        raise ValueError("answer requires an attributed explanation of at most 10000 characters")

    path = proposal_path(kind, number)
    with locked(path):
        value = load(path, repo)
        if value["checksum"] != checkpoint or value["status"] != "pending" or not value.get("decision_question"):
            raise ValueError("questioned action proposal changed or is no longer pending")
        if (DATA_DIR / "writes" / (value["request_id"] + ".json")).exists():
            raise ValueError("action proposal has a write attempt; reconcile it before answering")

        previous = {key: item for key, item in value.items() if key != "history"}
        value["history"] = value.get("history", []) + [previous]
        value["request_id"] = str(uuid.uuid4())
        value["decision_resolution"] = dict(by=by, at=now_iso(), reason=text, held_checkpoint=checkpoint)
        if not valid_decision_hold(value):
            raise ValueError("answer does not bind the selected question")
        save(path, value)

    return row(value, local_state(repo))


def choose(repo, kind=None, number=None, items=(), all_pending=False, operation=None):
    state = local_state(repo)
    if all_pending:
        if number is not None or items:
            raise ValueError("--all cannot be combined with selected item numbers")
        values = [value for value in all_proposals(repo) if (kind is None or value["kind"] == kind) and
                  (operation is None or value["operation"] == operation) and row(value, state)["active"]]
    else:
        keys = []
        if number is not None:
            if kind is None:
                raise ValueError("--number requires --kind")
            keys.append((kind, number))
        for token in items:
            parts = token.split(":", 1)
            if len(parts) != 2 or parts[0] not in ("issue", "pr") or not parts[1].isdigit() or int(parts[1]) < 1:
                raise ValueError("select items as issue:NUMBER or pr:NUMBER")
            keys.append((parts[0], int(parts[1])))
        if not keys or len(keys) != len(set(keys)):
            raise ValueError("select one or more distinct items")
        values = [load(proposal_path(selected_kind, selected_number), repo) for selected_kind, selected_number in keys]
        if any(not row(value, state)["active"] or operation is not None and value["operation"] != operation for value in values):
            raise ValueError("selected item has no actionable proposal")

    if not values or len(values) > 20:
        raise ValueError("select one to twenty actionable proposals")
    return values, state


def review(repo, kind=None, number=None, items=(), all_pending=False, operation=None, check=True):
    values, state = choose(repo, kind, number, items, all_pending, operation)
    for value in values:
        if value.get("decision_question") and not value.get("decision_resolution"):
            raise ValueError("answer the staged action question before exact approval")
        if check:
            check_current(value)

    plan = dict(version=1, repo=repo, operation="conversation-or-state-action", proposals=[row(value, state) for value in values])
    return dict(plan=plan, approval=digest(canonical(plan)))


def automation_policy(repo, value):
    if not value.get("action"):
        raise ValueError("a recommendation without a saved ledger action requires human approval")
    if value.get("decision_question"):
        raise ValueError("human decision question keeps this action staged")

    inputs = value["inputs"]
    complete_target = any(selected["kind"] == value["kind"] and selected["number"] == value["number"] and
                          all(component["status"] in ("complete", "not_applicable") for component in selected["components"].values())
                          for selected in inputs["evidence"])
    if not complete_target or inputs["evidence_gaps"] or value.get("reconsideration"):
        raise ValueError("direct action needs complete selected target evidence and no unresolved gap or rejection")

    result = subprocess.run([str(Path(__file__).absolute().with_name("action-policy")), "status", "--expected-repo", repo], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or "could not read action automation policy")
    setting = next((row for row in json.loads(result.stdout)["actions"] if row["name"] == value["action"]), None)
    if setting is None or setting["operation"] != value["operation"] or setting["mode"] != "execute" or not setting["configured"]:
        raise ValueError("selected action is not enabled for direct execution in this repository")

    return setting["definition_sha256"]


def call_comment(repo, value):
    script = Path(__file__).absolute().with_name("comment-plus")
    base = [str(script), "--expected-repo", repo, "--host", value["host"], "--kind", value["kind"],
            "--number", str(value["number"]), "--body=" + value["comment"], "--request-id", value["request_id"],
            "--expected-updated-at", value["updated_at"]]
    if value["kind"] == "pr":
        base += ["--expected-head", value["head_sha"]]
    if value["operation"] in ("close", "reopen"):
        base.append("--" + value["operation"])

    preview = subprocess.run(base, capture_output=True, text=True)
    if preview.returncode:
        raise ValueError(preview.stderr.strip() or "comment plan failed")
    planned = json.loads(preview.stdout)
    if planned["plan"]["target"] != value["target"] or planned["plan"]["body"] != value["comment"] or planned["plan"]["operation"] != value["operation"]:
        raise ValueError("comment plan differs from the action proposal")

    result = subprocess.run(base + ["--publish", "--approve", planned["approval"]], capture_output=True, text=True)
    receipt = DATA_DIR / "writes" / (value["request_id"] + ".json")
    if receipt.exists():
        outcome = json.loads(receipt.read_text(encoding="utf-8"))
        if outcome.get("approval") != planned["approval"]:
            raise ValueError("saved write outcome differs from the action proposal")
        return outcome, result.returncode == 0
    if result.returncode:
        raise ValueError(result.stderr.strip() or "comment request failed before writing")

    raise ValueError("comment reported success without a saved write outcome")


def execute(repo, kind, number, items, all_pending, operation, approval, automation):
    prepared = review(repo, kind, number, items, all_pending, operation, check=False)
    if prepared["approval"] != approval:
        raise ValueError("action proposal changed or approval does not match exact review")

    results, completed_batch = [], {}
    for selected in prepared["plan"]["proposals"]:
        path = proposal_path(selected["kind"], selected["number"])
        with locked(path):
            value = load(path, repo)
            if value["checksum"] != selected["checkpoint"] or value["status"] != "pending":
                raise ValueError("action proposal changed during execution")

            receipt = DATA_DIR / "writes" / (value["request_id"] + ".json")
            new_attempt = not receipt.exists()
            definition = None
            if new_attempt:
                check_current(value, completed_batch)
                if automation:
                    definition = automation_policy(repo, value)

            outcome, ok = call_comment(repo, value)
            value["outcome"] = dict(request_id=value["request_id"], comment=outcome["comment"], state_change=outcome["state_change"])
            if automation and new_attempt:
                value["outcome"]["authorization"] = dict(source="repository-policy", action=value["action"], definition_sha256=definition)
            state_ok = value["operation"] == "comment" or outcome["state_change"]["status"] == "succeeded"
            value["status"] = "executed" if ok and outcome["comment"]["status"] == "succeeded" and state_ok else "uncertain"
            save(path, value)
            result = dict(kind=value["kind"], number=value["number"], status=value["status"], outcome=value["outcome"])
            results.append(result)
            if value["status"] != "executed":
                print(canonical(dict(results=results)))
                raise ValueError("write outcome uncertain; inspect GitHub and the saved record")
            if new_attempt:
                completed_batch[value["request_id"]] = value["target"]

    return dict(results=results) if all_pending or items else results[0]


def reject(repo, kind, number, checkpoint, by, reason):
    if not valid_short_text(by, 200) or len(reason) > 10000 or any((ord(char) < 32 and char not in "\n\t") or 127 <= ord(char) <= 159 for char in reason):
        raise ValueError("rejection needs an author and a short reason")

    path = proposal_path(kind, number)
    with locked(path):
        value = load(path, repo)
        if value["checksum"] != checkpoint or value["status"] != "pending" or (DATA_DIR / "writes" / (value["request_id"] + ".json")).exists():
            raise ValueError("action proposal changed or has a write attempt")

        previous = {key: item for key, item in value.items() if key != "history"}
        value["history"] = value.get("history", []) + [previous]
        value["status"] = "rejected"
        value["rejection"] = dict(proposal_checkpoint=checkpoint, by=by, at=now_iso(), reason=reason)
        save(path, value)

    return row(value, local_state(repo))


def change(repo, action, kind, number, checkpoint):
    value = load(proposal_path(kind, number), repo)
    if value["checksum"] != checkpoint:
        raise ValueError("action proposal changed; reopen Notifications")

    path = DATA_DIR / "local" / "action-proposals-state.json"
    with locked(path):
        state = local_state(repo)
        entry = state["rows"].setdefault(f"{kind}:{number}", {})
        entry["viewed_checkpoint" if action == "view" else "dismissed_checkpoint"] = checkpoint
        with atomic_writer(path) as out:
            out.write(json.dumps(state, indent=2, ensure_ascii=False) + "\n")

    return row(value, state)


def context(repo, kind, number, checkpoint, offset=0, context_checkpoint=None):
    value = load(proposal_path(kind, number), repo)
    if value["checksum"] != checkpoint:
        raise ValueError("action proposal changed; reopen Notifications")

    current, reason = False, None
    if value["status"] == "pending":
        try:
            check_current(value)
            current = True
        except ValueError as error:
            reason = str(error)
    else:
        reason = f"proposal is {value['status']}"

    item = read_item_context(kind, number, offset=offset, limit=10, checkpoint=context_checkpoint)
    rejection = next((event for event in reversed(proposal_feedback(kind, number, repo)["events"]) if event["kind"] == "rejection"), None)
    return dict(repository=repo, kind=kind, number=number, proposal_checkpoint=checkpoint,
                current=current, reason=reason, item_context=item, latest_rejection=rejection, requests=0)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-repo", required=True)
    commands = parser.add_subparsers(dest="command", required=True)
    add = commands.add_parser("propose")
    add.add_argument("--kind", choices=("issue", "pr"), required=True)
    add.add_argument("--number", type=int, required=True)
    add.add_argument("--action")
    add.add_argument("--operation", choices=("comment", "close", "reopen"), help="for a PR closure recommendation without a saved ledger action")
    add.add_argument("--title", required=True)
    add.add_argument("--host", default="github.com")
    add.add_argument("--observed-state", choices=("open", "closed"), required=True)
    add.add_argument("--updated-at", required=True)
    add.add_argument("--head-sha")
    add.add_argument("--comment-file", type=Path, required=True)
    add.add_argument("--by", required=True)
    add.add_argument("--context-checkpoint", required=True)
    add.add_argument("--evidence", action="append", default=[])
    add.add_argument("--evidence-gap", action="append", default=[])
    add.add_argument("--replace-checkpoint")
    add.add_argument("--reconsideration-reason")
    add.add_argument("--decision-question", help="hold this proposal until a person resolves a specific decision")
    add.add_argument("--reference-kind", choices=("issue", "pr"))
    add.add_argument("--reference-number", type=int)
    add.add_argument("--group-id")
    add.add_argument("--member-context", action="append", default=[])
    edit_text = commands.add_parser("edit")
    edit_text.add_argument("--kind", choices=("issue", "pr"), required=True)
    edit_text.add_argument("--number", type=int, required=True)
    edit_text.add_argument("--checkpoint", required=True)
    edit_text.add_argument("--comment-file", type=Path, required=True)
    edit_text.add_argument("--by", required=True)
    answer_question = commands.add_parser("answer", help="attribute an answer to one exact staged action question")
    answer_question.add_argument("--kind", choices=("issue", "pr"), required=True)
    answer_question.add_argument("--number", type=int, required=True)
    answer_question.add_argument("--checkpoint", required=True)
    answer_question.add_argument("--by", required=True)
    answer_question.add_argument("--answer", required=True)
    read = commands.add_parser("inspect")
    read.add_argument("--kind", choices=("issue", "pr"), required=True)
    read.add_argument("--number", type=int, required=True)
    read.add_argument("--host", default="github.com")
    commands.add_parser("list")
    for command in ("review", "execute", "context", "view", "dismiss", "reject"):
        selected = commands.add_parser(command)
        selected.add_argument("--kind", choices=("issue", "pr"), required=command not in ("review", "execute"))
        selected.add_argument("--number", type=int, required=command not in ("review", "execute"))
        if command in ("review", "execute"):
            selected.add_argument("--item", action="append", default=[])
            selected.add_argument("--all", action="store_true")
            selected.add_argument("--operation", choices=("comment", "close", "reopen"))
        if command in ("context", "view", "dismiss", "reject"):
            selected.add_argument("--checkpoint", required=True)
        if command == "context":
            selected.add_argument("--offset", type=int, default=0)
            selected.add_argument("--context-checkpoint")
        if command == "reject":
            selected.add_argument("--by", required=True)
            selected.add_argument("--reason", default="")
        if command == "execute":
            selected.add_argument("--publish", action="store_true")
            selected.add_argument("--approve")
            selected.add_argument("--automation", action="store_true")

    args = parser.parse_args()
    repo = read_repo()
    if args.expected_repo != repo:
        raise ValueError("configured repository changed; reopen action proposals")

    if args.command == "propose":
        result = propose(args, repo)
    elif args.command == "edit":
        result = edit(args, repo)
    elif args.command == "answer":
        result = answer(repo, args.kind, args.number, args.checkpoint, args.by, args.answer)
    elif args.command == "inspect":
        result = inspect(repo, args.host, args.kind, args.number)
    elif args.command == "list":
        state = local_state(repo)
        result = dict(repository=repo, rows=[row(value, state) for value in all_proposals(repo)], requests=0)
    elif args.command == "review" or args.command == "execute" and not args.publish:
        result = review(repo, args.kind, args.number, args.item, args.all, args.operation)
    elif args.command == "execute":
        if not args.approve:
            raise ValueError("publishing needs the exact reviewed proposal approval")
        result = execute(repo, args.kind, args.number, args.item, args.all, args.operation, args.approve, args.automation)
    elif args.command == "reject":
        result = reject(repo, args.kind, args.number, args.checkpoint, args.by, args.reason)
    elif args.command in ("view", "dismiss"):
        result = change(repo, args.command, args.kind, args.number, args.checkpoint)
    else:
        result = context(repo, args.kind, args.number, args.checkpoint, args.offset, args.context_checkpoint)

    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError, subprocess.TimeoutExpired) as error:
        sys.exit(f"error: {error}")
