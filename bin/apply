#!/usr/bin/env python3
"""
Apply a filled-in decisions file (from bin/batch) back into the ledger, or apply a single item's decision directly from flags.

Usage:
    bin/apply data/<owner>/<repo>/batches/<batch_id>.decisions.jsonl [--by NAME] [--only-untriaged]
    bin/apply --number N --kind issue|pr [--action A] [--proposed-label NAME ...] \\
        [--replace-proposed-labels] [--reason TEXT] [--agent-notes TEXT] [--by NAME] [--batch-id ID]
    bin/apply --number N --kind issue|pr --agent-notes TEXT
    bin/apply (--number N --kind issue|pr | --key issue:N ...) --clear
    any of the above with --dry-run to validate and report without writing the ledger

Each decisions row needs number and kind. Add only fields to edit: proposed_labels, action, reason and agent_notes. Omitted fields preserve saved values; proposed_labels: [] clears proposals and an empty string clears a text field. An identity-only row, including one with only proposed_by metadata, changes nothing. proposed_labels must contain distinct names from this repository's observed GitHub label catalog; observed GitHub labels are separate. Text fields must be strings. null is not an omitted field.

--replace-proposed-labels explicitly replaces the label set in single-item mode, including with an empty set when no --proposed-label is given. --action '' clears the action independently; action 'none' records an assessed choice of no conversation or state operation. Omitted action, reason and notes preserve their saved values. Notes-only rows and --agent-notes alone preserve decision attribution; editing any decision field records who and when, using --by or the row's proposed_by (default agent).

This records an attributed local decision. It does not authorize a GitHub write or add the item to Pending review; bin/review-request owns that explicit queue.

--number/--kind is a single-item alternative to a decisions file, for callers (e.g. the triage-o-mator TUI) applying one decision per call rather than writing a batch file.

--key KIND:NUMBER (repeatable) clears several decisions in one ledger write.

--clear takes back the decision: the item is untriaged again (proposed labels, action, reason, who and when, and its batch are blanked). Agent notes, maintainer notes and an explicit Pending review request remain. Items with no decision are skipped. The ledger's git diff records what was taken back.

--agent-notes on its own (no decision-field flags) only replaces the item's agent_notes, leaving its decision untouched: how prompts/review-pr.md attaches a code review to a PR someone already triaged.

--batch-id stamps a single-item decision with the batch it was made in (default "tui"), so decisions made while working through a batch in the TUI stay attributable to that batch. --only-untriaged skips decisions-file rows whose item already has proposed labels or an action, and edits already recorded from that batch, so applying an agent's proposals never overwrites a decision someone already saved.

--expected-repo refuses the operation if the install's configured repository changed after the caller selected it.

--expected-fields binds current values of the fields edited in single-item mode. The owning ledger transaction refuses an edit when one of those values changed, so independent TUI confirmations cannot overwrite newer guidance.
"""

import argparse
import json
import sys
from contextlib import nullcontext
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))  # absolute, never resolve: see work_root() in bin/_install.py
from _triage import LEDGER_PATH, REPO, TRIAGE_DEFAULTS, DECISION_FIELDS, proposal_fulfilled, action_operation, has_decision, here, load_jsonl, load_ledger, load_taxonomy, now_iso, observed_catalog, parse_key, save_ledger
from _storage import locked


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("decisions_path", type=Path, nargs="?", default=None)
    ap.add_argument("--number", type=int, help="single-item mode: item number")
    ap.add_argument(
        "--kind", choices=["issue", "pr"], help="single-item mode: item kind"
    )
    ap.add_argument("--proposed-label", action="append", dest="proposed_labels", help="repeat to propose GitHub labels separately from observed labels")
    ap.add_argument("--replace-proposed-labels", action="store_true", help="single-item mode: replace proposed labels, including with an empty set and a blank action")
    ap.add_argument("--action", help="single-item mode: action")
    ap.add_argument("--reason")
    ap.add_argument(
        "--agent-notes",
        default=None,
        help="single-item mode: agent's longer evidence/review notes (omit to keep existing notes)",
    )
    ap.add_argument(
        "--clear",
        action="store_true",
        help="take back a decision: the item is untriaged again (notes and explicit Pending review stay)",
    )
    ap.add_argument(
        "--by",
        default=None,
        help="decision author (default: a row's proposed_by, else agent)",
    )
    ap.add_argument(
        "--batch-id",
        default="tui",
        help="single-item mode: batch_id to stamp (default: tui)",
    )
    ap.add_argument(
        "--only-untriaged",
        action="store_true",
        help="decisions-file mode: skip triaged items and edits already recorded from this batch",
    )
    ap.add_argument(
        "--key",
        action="append",
        default=[],
        metavar="KIND:NUMBER",
        help="with --clear: an item to act on, e.g. issue:12 (repeatable)",
    )
    ap.add_argument(
        "--dry-run",
        action="store_true",
        help="validate and print what would be applied, without writing the ledger",
    )
    ap.add_argument("--expected-repo", help="refuse to write if config/repo differs from this repository")
    ap.add_argument("--expected-fields", help="single-item mode: JSON object binding the current values of fields being edited")
    args = ap.parse_args()

    if args.expected_repo is not None and args.expected_repo != REPO:
        ap.error(f"repository changed: expected {args.expected_repo!r}, found {REPO!r}")

    single_edits = {field: getattr(args, field) for field in ("action", "reason", "agent_notes") if getattr(args, field) is not None}
    if args.proposed_labels is not None or args.replace_proposed_labels:
        single_edits["proposed_labels"] = args.proposed_labels or []

    expected = None
    if args.expected_fields is not None:
        try:
            expected = json.loads(args.expected_fields)
        except json.JSONDecodeError:
            ap.error("--expected-fields must be a JSON object")

        if args.number is None or args.clear or args.decisions_path is not None or not isinstance(expected, dict) or not set(expected).issubset(single_edits):
            ap.error("--expected-fields binds only edited fields in single-item mode")

    if args.clear and (args.decisions_path is not None or single_edits):
        sys.exit("error: --clear only takes --number/--kind or --key (plus --by, --dry-run)")

    if args.key:
        if not args.clear or args.number is not None or args.decisions_path is not None or single_edits:
            sys.exit("error: --key only goes with --clear (and not with --number or a decisions file)")

        decisions = []
        for value in args.key:
            key = parse_key(value)
            if key is None:
                sys.exit(f"error: --key {value!r} should look like issue:12 or pr:34")

            decisions.append({"number": key[1], "kind": key[0]})

        batch_id = args.batch_id
    elif args.decisions_path is not None:
        if args.number is not None or single_edits:
            sys.exit(
                "error: pass a decisions file OR --number/--kind (+ flags), not both"
            )

        if not args.decisions_path.exists():
            sys.exit(f"error: {args.decisions_path} not found")

        decisions = load_jsonl(args.decisions_path)
        batch_id = args.decisions_path.stem.replace(".decisions", "")
    elif args.number is not None:
        if not args.kind:
            sys.exit("error: --number requires --kind")

        if not args.clear and not single_edits:
            sys.exit("error: --number requires --action, --proposed-label, --replace-proposed-labels, --reason, --clear, or --agent-notes")

        decisions = [{"number": args.number, "kind": args.kind, **single_edits}]

        batch_id = args.batch_id
    else:
        sys.exit("error: pass a decisions file or --number/--kind")

    taxonomy = load_taxonomy()
    valid_actions = set(taxonomy["actions"])
    catalog = observed_catalog(taxonomy)
    catalog_names = [row.get("name") for row in catalog["labels"] if isinstance(row, dict)] if catalog else []

    with nullcontext() if args.dry_run else locked(LEDGER_PATH):
        ledger = load_ledger()
        by_key = {(r["kind"], r["number"]): r for r in ledger}

        if expected is not None:
            selected = by_key.get((args.kind, args.number))
            if selected is None or any(selected.get(field, TRIAGE_DEFAULTS[field]) != value for field, value in expected.items()):
                sys.exit("error: the selected form fields changed; reopen the item before confirming")

        ts = now_iso()
        applied, blank, kept, recorded, warnings, nothing = 0, [], [], [], [], []

        for d in decisions:
            if not isinstance(d, dict) or d.get("kind") not in ("issue", "pr") or type(d.get("number")) is not int:
                sys.exit("error: each decisions row needs kind issue|pr and an integer number")

            for field in ("action", "reason", "agent_notes", "proposed_by"):
                if field in d and not isinstance(d[field], str):
                    sys.exit(f"error: #{d['number']} {field} must be a string")

            if "proposed_labels" in d:
                proposed = d["proposed_labels"]
                if not isinstance(proposed, list) or any(not isinstance(name, str) or not name for name in proposed) or len(set(proposed)) != len(proposed):
                    sys.exit(f"error: #{d['number']} proposed_labels must be a list of distinct label names")

                if proposed and not catalog_names:
                    sys.exit(f"error: #{d['number']} cannot propose labels until this repository's label catalog is observed")

                unknown = set(proposed) - set(catalog_names)
                if unknown:
                    sys.exit(f"error: #{d['number']} proposed labels are absent from the current catalog: {sorted(unknown)}")

        for d in decisions:
            key = (d.get("kind"), d.get("number"))
            if key not in by_key:
                sys.exit(here(f"error: {key} is not in the ledger — run bin/sync first"))

            rec = by_key[key]

            if args.clear:
                if not has_decision(rec):
                    nothing.append(key)

                    continue

                for field in DECISION_FIELDS + ("labels_reviewed", "triaged_at", "triaged_by", "batch_id"):
                    rec[field] = TRIAGE_DEFAULTS[field]

                applied += 1

                continue

            edits = set(d).intersection(DECISION_FIELDS + ("agent_notes",))
            if not edits:
                blank.append(key)

                continue

            if args.only_untriaged and has_decision(rec):
                kept.append(key)

                continue

            if args.only_untriaged and proposal_fulfilled(d, rec, batch_id):
                recorded.append(key)

                continue

            action = d.get("action", "")
            if action and action not in valid_actions:
                warnings.append(f"#{d['number']}: unrecognized action {action!r}")
            elif action and not action_operation(taxonomy, action):
                warnings.append(f"#{d['number']}: action {action!r} has no GitHub operation in taxonomy.json")

            for field in edits:
                rec[field] = [name for name in catalog_names if name in d[field]] if field == "proposed_labels" else d[field]

            if not edits.intersection(DECISION_FIELDS):
                applied += 1

                continue

            by = args.by or d.get("proposed_by") or "agent"
            rec["triaged_at"] = ts
            rec["triaged_by"] = by
            rec["batch_id"] = batch_id

            applied += 1

        if not args.dry_run and applied:
            save_ledger(list(by_key.values()))

    label = (
        str(args.decisions_path)
        if args.decisions_path
        else f"#{args.number} ({args.kind})"
    )
    if args.key:
        label = ", ".join(args.key)

    verb = "Cleared" if args.clear else "Applied"
    if args.dry_run:
        verb = {"Cleared": "Would clear", "Applied": "Would apply"}[verb]

    print(f"{verb} {applied} decisions ({label}).{' Dry run: ledger not written.' if args.dry_run else ''}")
    if nothing:
        print(f"Skipped {len(nothing)} not triaged, nothing to take back: {nothing[:10]}{' ...' if len(nothing) > 10 else ''}")
    if blank:
        print(
            f"Skipped {len(blank)} rows without edits: {blank[:10]}{' ...' if len(blank) > 10 else ''}"
        )

    if kept:
        print(
            f"Kept {len(kept)} existing decisions (--only-untriaged): {kept[:10]}{' ...' if len(kept) > 10 else ''}"
        )

    if recorded:
        print(f"Skipped {len(recorded)} edits already recorded (--only-untriaged): {recorded[:10]}{' ...' if len(recorded) > 10 else ''}")

    for w in warnings:
        print(f"warning: {w}")


if __name__ == "__main__":
    main()
