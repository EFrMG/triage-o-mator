#!/usr/bin/env python3
"""
Apply a filled-in decisions file (from bin/batch) back into the ledger, or apply a single item's decision directly from flags.

Usage:
    bin/apply data/<owner>/<repo>/batches/<batch_id>.decisions.jsonl [--by NAME] [--only-untriaged]
    bin/apply --number N --kind issue|pr [--action A] [--proposed-label NAME ...] \\
        [--replace-proposed-labels] [--confidence L] [--reason TEXT] [--agent-notes TEXT] [--by NAME] [--batch-id ID]
    bin/apply --number N --kind issue|pr --agent-notes TEXT
    bin/apply (--number N --kind issue|pr | --key issue:N ...) --clear
    any of the above with --dry-run to validate and report without writing the ledger

Each line in the decisions file needs number, kind and an action field, which may be blank when labels are proposed before an action is assessed. It may carry `proposed_labels` (a list of names from this repository's observed GitHub label catalog), confidence, reason, agent_notes and proposed_by. Observed GitHub `labels` are separate from these local proposals. A row without `proposed_labels` leaves the item's proposal unchanged; an empty list clears it. `--replace-proposed-labels` does the same in single-item mode, including when no `--proposed-label` is given. Unknown proposed labels are refused until the catalog is refreshed. A row without `agent_notes` leaves the item's existing notes alone.

This records an attributed local decision. It does not authorize a GitHub write or add the item to Pending review; bin/review-request owns that explicit queue.

--number/--kind is a single-item alternative to a decisions file, for callers (e.g. the triage-o-mator TUI) applying one decision per call rather than writing a batch file.

--key KIND:NUMBER (repeatable) clears several decisions in one ledger write.

--clear takes back the decision: the item is untriaged again (proposed labels, action, confidence, reason, who and when, and its batch are blanked). Agent notes, maintainer notes and an explicit Pending review request remain. Items with no decision are skipped. The ledger's git diff records what was taken back.

--agent-notes on its own (no --action/--proposed-label) only replaces the item's agent_notes, leaving its decision untouched: how prompts/review-pr.md attaches a code review to a PR someone already triaged.

--batch-id stamps a single-item decision with the batch it was made in (default "tui"), so decisions made while working through a batch in the TUI stay attributable to that batch. --only-untriaged skips decisions-file rows whose item already has proposed labels or an action, so applying an agent's proposals never overwrites a decision someone already saved.

--expected-repo refuses the operation if the install's configured repository changed after the caller selected it.
"""

import argparse
import sys
from contextlib import nullcontext
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))  # absolute, never resolve: see work_root() in bin/_install.py
from _triage import LEDGER_PATH, REPO, TRIAGE_DEFAULTS, action_operation, has_decision, here, load_jsonl, load_ledger, load_taxonomy, now_iso, observed_catalog, parse_key, save_ledger
from _storage import locked

DECISION_FIELDS = ("proposed_labels", "action", "confidence", "reason")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("decisions_path", type=Path, nargs="?", default=None)
    ap.add_argument("--number", type=int, help="single-item mode: item number")
    ap.add_argument(
        "--kind", choices=["issue", "pr"], help="single-item mode: item kind"
    )
    ap.add_argument("--proposed-label", action="append", dest="proposed_labels", help="repeat to propose GitHub labels separately from observed labels")
    ap.add_argument("--replace-proposed-labels", action="store_true", help="replace the proposed label set, including with an empty set")
    ap.add_argument("--action", help="single-item mode: action")
    ap.add_argument("--confidence", choices=["low", "medium", "high"])
    ap.add_argument("--reason")
    ap.add_argument(
        "--agent-notes",
        default=None,
        help="single-item mode: agent's longer evidence/review notes (omit to keep existing notes)",
    )
    ap.add_argument(
        "--clear",
        action="store_true",
        help="take back a decision: the item is untriaged again (notes and explicit Pending review stay)",
    )
    ap.add_argument(
        "--by",
        default=None,
        help="decision author (default: a row's proposed_by, else agent)",
    )
    ap.add_argument(
        "--batch-id",
        default="tui",
        help="single-item mode: batch_id to stamp (default: tui)",
    )
    ap.add_argument(
        "--only-untriaged",
        action="store_true",
        help="decisions-file mode: skip rows whose item already has proposed labels or an action",
    )
    ap.add_argument(
        "--key",
        action="append",
        default=[],
        metavar="KIND:NUMBER",
        help="with --clear: an item to act on, e.g. issue:12 (repeatable)",
    )
    ap.add_argument(
        "--dry-run",
        action="store_true",
        help="validate and print what would be applied, without writing the ledger",
    )
    ap.add_argument("--expected-repo", help="refuse to write if config/repo differs from this repository")
    args = ap.parse_args()

    if args.expected_repo is not None and args.expected_repo != REPO:
        ap.error(f"repository changed: expected {args.expected_repo!r}, found {REPO!r}")

    if args.clear and (args.decisions_path is not None or args.action or args.proposed_labels is not None or args.replace_proposed_labels or args.agent_notes is not None):
        sys.exit("error: --clear only takes --number/--kind or --key (plus --by, --dry-run)")

    if args.key:
        if not args.clear or args.number is not None or args.decisions_path is not None or args.action or args.proposed_labels is not None or args.replace_proposed_labels:
            sys.exit("error: --key only goes with --clear (and not with --number or a decisions file)")

        decisions = []
        for value in args.key:
            key = parse_key(value)
            if key is None:
                sys.exit(f"error: --key {value!r} should look like issue:12 or pr:34")

            decisions.append({"number": key[1], "kind": key[0]})

        batch_id = args.batch_id
    elif args.decisions_path is not None:
        if args.number is not None or args.action or args.proposed_labels is not None or args.replace_proposed_labels or args.agent_notes is not None:
            sys.exit(
                "error: pass a decisions file OR --number/--kind (+ flags), not both"
            )

        if not args.decisions_path.exists():
            sys.exit(f"error: {args.decisions_path} not found")

        decisions = load_jsonl(args.decisions_path)
        batch_id = args.decisions_path.stem.replace(".decisions", "")
    elif args.number is not None:
        if not args.kind:
            sys.exit("error: --number requires --kind")

        if args.clear:
            decisions = [{"number": args.number, "kind": args.kind}]
        elif args.action or args.proposed_labels is not None or args.replace_proposed_labels:
            decisions = [
                {
                    "number": args.number,
                    "kind": args.kind,
                    **({"proposed_labels": args.proposed_labels or []} if args.proposed_labels is not None or args.replace_proposed_labels else {}),
                    **({"action": args.action} if args.action is not None else {}),
                    **({"confidence": args.confidence} if args.confidence is not None else {}),
                    **({"reason": args.reason} if args.reason is not None else {}),
                }
            ]
        elif args.agent_notes is not None:
            decisions = [{"number": args.number, "kind": args.kind, "agent_notes": args.agent_notes, "notes_only": True}]
        else:
            sys.exit(
                "error: --number requires --action, --proposed-label, --clear, or --agent-notes"
            )

        if args.agent_notes is not None and not decisions[0].get("notes_only"):
            decisions[0]["agent_notes"] = args.agent_notes

        batch_id = args.batch_id
    else:
        sys.exit("error: pass a decisions file or --number/--kind")

    taxonomy = load_taxonomy()
    valid_actions = set(taxonomy["actions"])
    catalog = observed_catalog(taxonomy)
    catalog_names = [row.get("name") for row in catalog["labels"] if isinstance(row, dict)] if catalog else []

    with nullcontext() if args.dry_run else locked(LEDGER_PATH):
        ledger = load_ledger()
        by_key = {(r["kind"], r["number"]): r for r in ledger}

        ts = now_iso()
        applied, blank, kept, warnings, nothing = 0, [], [], [], []

        for d in decisions:
            key = (d.get("kind"), d.get("number"))
            if key not in by_key:
                sys.exit(here(f"error: {key} is not in the ledger — run bin/sync first"))

            rec = by_key[key]

            if args.clear:
                if not has_decision(rec):
                    nothing.append(key)

                    continue

                for field in DECISION_FIELDS + ("triaged_at", "triaged_by", "batch_id"):
                    rec[field] = TRIAGE_DEFAULTS[field]

                applied += 1

                continue

            if d.get("notes_only"):
                rec["agent_notes"] = d["agent_notes"]
                applied += 1

                continue

            if "action" not in d:
                d = {**d, "action": rec.get("action") or ""}

            if not d.get("action") and not d.get("proposed_labels"):
                blank.append((d["kind"], d["number"]))

                continue

            if args.only_untriaged and has_decision(rec):
                kept.append((d["kind"], d["number"]))

                continue

            if d["action"] and d["action"] not in valid_actions:
                warnings.append(f"#{d['number']}: unrecognized action {d['action']!r}")
            elif d["action"] and not action_operation(taxonomy, d["action"]):
                warnings.append(f"#{d['number']}: action {d['action']!r} has no GitHub operation in taxonomy.json")

            desired_labels = rec.get("proposed_labels", [])
            if "proposed_labels" in d:
                proposed = d["proposed_labels"]
                if not isinstance(proposed, list) or any(not isinstance(name, str) or not name for name in proposed) or len(set(proposed)) != len(proposed):
                    sys.exit(f"error: #{d['number']} proposed_labels must be a list of distinct label names")
                if proposed and not catalog_names:
                    sys.exit(f"error: #{d['number']} cannot propose labels until this repository's label catalog is observed")
                unknown = set(proposed) - set(catalog_names)
                if unknown:
                    sys.exit(f"error: #{d['number']} proposed labels are absent from the current catalog: {sorted(unknown)}")
                desired_labels = [name for name in catalog_names if name in proposed]

            if "proposed_labels" in d:
                rec["proposed_labels"] = desired_labels
            rec["action"] = d["action"]
            rec["confidence"] = d.get("confidence", rec.get("confidence", ""))
            rec["reason"] = d.get("reason", rec.get("reason", ""))
            if "agent_notes" in d:
                rec["agent_notes"] = d["agent_notes"] or ""

            by = args.by or d.get("proposed_by") or "agent"
            rec["triaged_at"] = ts
            rec["triaged_by"] = by
            rec["batch_id"] = batch_id

            applied += 1

        if not args.dry_run:
            save_ledger(list(by_key.values()))

    label = (
        str(args.decisions_path)
        if args.decisions_path
        else f"#{args.number} ({args.kind})"
    )
    if args.key:
        label = ", ".join(args.key)

    verb = "Cleared" if args.clear else "Applied"
    if args.dry_run:
        verb = {"Cleared": "Would clear", "Applied": "Would apply"}[verb]

    print(f"{verb} {applied} decisions ({label}).{' Dry run: ledger not written.' if args.dry_run else ''}")
    if nothing:
        print(f"Skipped {len(nothing)} not triaged, nothing to take back: {nothing[:10]}{' ...' if len(nothing) > 10 else ''}")
    if blank:
        print(
            f"Skipped {len(blank)} rows still blank: {blank[:10]}{' ...' if len(blank) > 10 else ''}"
        )

    if kept:
        print(
            f"Kept {len(kept)} existing decisions (--only-untriaged): {kept[:10]}{' ...' if len(kept) > 10 else ''}"
        )

    for w in warnings:
        print(f"warning: {w}")


if __name__ == "__main__":
    main()
