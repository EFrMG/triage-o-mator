#!/usr/bin/env python3
"""Save PR closure proposals offline; execute only a human-approved exact review through bin/comment-plus."""

import argparse
import json
import re
import subprocess
import sys
import uuid
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).absolute().parent))

from _evidence import canonical, digest, validate_payload
from _auto_close_records import feedback as proposal_feedback, load, proposal_path
from _item_context import ContextIndex, read as read_item_context
from _groups import load_group
from _storage import atomic_writer, locked
from _triage import DATA_DIR, load_taxonomy, now_iso, read_repo


def state_path():
    return DATA_DIR / "local" / "auto-close-state.json"


def guarded_lock(path):
    if path.parent.is_symlink() or (path.parent / "local").is_symlink():
        raise ValueError("invalid proposal storage path")

    return locked(path)


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    value.pop("checksum", None)
    value["checksum"] = digest(canonical(value))
    with atomic_writer(path) as out:
        out.write(canonical(value) + "\n")


def proposals(repo):
    directory = DATA_DIR / "auto-close"
    if not directory.exists():
        return []
    if directory.is_symlink() or not directory.is_dir():
        raise ValueError("invalid proposal directory")
    rows = []
    for path in sorted(directory.iterdir()):
        if path.name == "local":
            continue
        if not re.fullmatch(r"pr-[1-9][0-9]*\.json", path.name):
            raise ValueError(f"unrecognized proposal file: {path.name}")
        rows.append(load(path, repo))

    return rows


def local_state(repo):
    path = state_path()
    if path.parent.is_symlink() or path.is_symlink():
        raise ValueError("invalid local proposal state path")
    if not path.exists():
        return dict(repository=repo, rows={})
    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("repository") != repo or not isinstance(value.get("rows"), dict):
        raise ValueError("invalid local proposal state")

    return value


def visible(proposal, state):
    return state["rows"].get(str(proposal["number"]), {}).get("dismissed_checkpoint") != proposal["checksum"]


def row(proposal, state):
    presentation = state["rows"].get(str(proposal["number"]), {})
    active = proposal["status"] == "pending" and "inputs" in proposal and visible(proposal, state)
    needs = active and presentation.get("viewed_checkpoint") != proposal["checksum"]
    result = dict(number=proposal["number"], title=proposal["title"], target=proposal["target"], comment=proposal["comment"], reference=proposal["reference"], head_sha=proposal["head_sha"], updated_at=proposal["updated_at"], status=proposal["status"], checkpoint=proposal["checksum"], active=active, needs_attention=needs, dismissed=not visible(proposal, state), outcome=proposal.get("outcome"))
    if "rationale" in proposal:
        result["rationale"] = proposal["rationale"]
    if "action" in proposal:
        result["action"] = proposal["action"]
    result["inputs"] = proposal.get("inputs")
    result["legacy_unbound"] = "inputs" not in proposal
    if "reconsideration" in proposal:
        result["reconsideration"] = proposal["reconsideration"]
    if proposal["status"] == "rejected":
        result["rejection"] = proposal["rejection"]

    return result


def choose(repo, numbers, all_pending):
    state = local_state(repo)
    all_rows = proposals(repo)
    if all_pending:
        chosen = [p for p in all_rows if p["status"] == "pending" and "inputs" in p and visible(p, state)]
    else:
        if not numbers or len(set(numbers)) != len(numbers):
            raise ValueError("choose one or more distinct PR numbers")
        by_number = {p["number"]: p for p in all_rows}
        chosen = []
        for number in numbers:
            p = by_number.get(number)
            if p is None or p["status"] != "pending" or "inputs" not in p or not visible(p, state):
                raise ValueError(f"PR #{number} has no actionable pending proposal")
            chosen.append(p)
    if not chosen:
        raise ValueError("no actionable pending proposals")

    return chosen


def selected_evidence(cache, kind, number, snapshot_id):
    manifest = cache.load_manifest(snapshot_id)
    record = next((item for item in manifest["items"] if (item["identity"]["kind"], item["identity"]["number"]) == (kind, number)), None)
    if record is None:
        raise ValueError("selected evidence item is absent from its snapshot")

    for name, component in record["components"].items():
        if component["object"] is not None:
            payload = cache.read_object(component["object"])
            validate_payload(name, component, kind, payload)

    return dict(kind=kind, number=number, snapshot_id=snapshot_id, repository=manifest["repository"],
                identity=record["identity"], revision=record["revision"],
                components={name: dict(status=component["status"], object=component["object"]) for name, component in record["components"].items()})


def check_current_context(proposal, completed_batch=None):
    inputs = proposal["inputs"]
    index = ContextIndex(completed_batch=completed_batch)
    target = index.collect("pr", proposal["number"], include_rows=False)
    if target["checkpoint"] != inputs["context_checkpoint"]:
        raise ValueError(f"local context changed for PR #{proposal['number']}; prepare a fresh proposal and review")

    handoff = inputs["group"]
    if handoff is not None:
        group = load_group(handoff["id"])
        if group["status"] == "archived" or group["revision"] != handoff["revision"]:
            raise ValueError(f"group handoff changed for PR #{proposal['number']}; export it and review again")

        members = [(member["kind"], member["number"]) for member in group["members"]]
        declared = [(member["kind"], member["number"]) for member in handoff["members"]]
        if members != declared or ("pr", proposal["number"]) not in members:
            raise ValueError(f"group handoff members changed for PR #{proposal['number']}; export it and review again")

        for member in handoff["members"]:
            current = index.collect(member["kind"], member["number"], include_rows=False)
            if current["checkpoint"] != member["checkpoint"]:
                raise ValueError(f"group member context changed for {member['kind']} #{member['number']}; prepare a fresh proposal and review")

    if inputs["evidence"]:
        from _cache import EvidenceCache
        from _evidence import repository

        cache = EvidenceCache(repository(proposal["repo"], host=proposal["host"]))
        for selected in inputs["evidence"]:
            try:
                verified = selected_evidence(cache, selected["kind"], selected["number"], selected["snapshot_id"])
            except (OSError, ValueError, KeyError, TypeError) as error:
                raise ValueError(f"selected evidence for {selected['kind']} #{selected['number']} is unavailable; restore or replace the proposal") from error
            if verified != selected:
                raise ValueError(f"selected evidence for {selected['kind']} #{selected['number']} changed; replace the proposal")


def context(repo, number, checkpoint, offset, context_checkpoint):
    proposal = load(proposal_path(number), repo)
    if proposal["checksum"] != checkpoint:
        raise ValueError("proposal changed; reopen Notifications")

    current = False
    reason = None
    if proposal["status"] == "pending" and "inputs" in proposal:
        try:
            check_current_context(proposal)
            current = True
        except ValueError as error:
            reason = str(error)
    elif proposal["status"] == "pending":
        reason = "older proposal has no declared context; replace it before review"
    else:
        reason = f"proposal is {proposal['status']}"

    item = read_item_context("pr", number, offset=offset, limit=10, checkpoint=context_checkpoint)
    rejection = next((event for event in reversed(proposal_feedback(number, repo)["events"]) if event["kind"] == "rejection"), None)
    return dict(repository=repo, number=number, proposal_checkpoint=checkpoint, current=current, reason=reason,
                item_context=item, latest_rejection=rejection, requests=0)


def review(repo, numbers, all_pending, check_context=True):
    chosen = choose(repo, numbers, all_pending)
    if check_context:
        for proposal in chosen:
            check_current_context(proposal)

    rows = [row(p, local_state(repo)) for p in chosen]
    plan = dict(version=1, repo=repo, operation="comment-and-close-pr", proposals=rows)

    return dict(plan=plan, approval=digest(canonical(plan)))


def declared_inputs(args, repo):
    index = ContextIndex()
    target = index.collect("pr", args.number, include_rows=False)
    if args.context_checkpoint != target["checkpoint"]:
        raise ValueError("local context changed; read item-context again before proposing")

    group_input = None
    if args.group_id is not None:
        group = load_group(args.group_id)
        if group["status"] == "archived" or not any(member["kind"] == "pr" and member["number"] == args.number for member in group["members"]):
            raise ValueError("selected PR is not in an active handoff group")

        declared = {}
        for token in args.member_context:
            parts = token.split(":", 2)
            if len(parts) != 3 or parts[0] not in ("pr", "issue") or not parts[1].isdigit() or int(parts[1]) < 1 or (parts[0], int(parts[1])) in declared:
                raise ValueError("invalid or repeated --member-context; expected KIND:NUMBER:CHECKPOINT")
            declared[(parts[0], int(parts[1]))] = parts[2]

        members = {(member["kind"], member["number"]) for member in group["members"]}
        if set(declared) != members:
            raise ValueError("declared group members differ from the current handoff")

        contexts = []
        for member in group["members"]:
            context = index.collect(member["kind"], member["number"], include_rows=False)
            if declared[(member["kind"], member["number"])] != context["checkpoint"]:
                raise ValueError("group member context changed; export the group again")
            contexts.append(dict(kind=member["kind"], number=member["number"], context_revision=context["context_revision"],
                                 feedback_checkpoint=context["feedback_checkpoint"], checkpoint=context["checkpoint"]))

        group_input = dict(id=group["id"], revision=group["revision"], members=contexts)
    elif args.member_context:
        raise ValueError("--member-context requires --group-id")

    evidence = []
    if args.evidence:
        from _cache import EvidenceCache
        from _evidence import repository

        cache = EvidenceCache(repository(repo, host=args.host))
        seen = set()
        for token in args.evidence:
            parts = token.split(":", 2)
            if len(parts) != 3 or parts[0] not in ("pr", "issue") or not parts[1].isdigit() or int(parts[1]) < 1:
                raise ValueError("invalid --evidence; expected KIND:NUMBER:SNAPSHOT_ID")
            key = (parts[0], int(parts[1]), parts[2])
            if key in seen:
                raise ValueError("repeated evidence selection")
            seen.add(key)

            evidence.append(selected_evidence(cache, *key))

    if not evidence and not args.evidence_gap:
        raise ValueError("declare selected --evidence or an explicit --evidence-gap")
    if any(not gap.strip() or len(gap) > 2000 for gap in args.evidence_gap):
        raise ValueError("evidence gaps must be nonempty text of at most 2000 characters")

    return dict(context_revision=target["context_revision"], feedback_checkpoint=target["feedback_checkpoint"],
                context_checkpoint=target["checkpoint"], group=group_input, evidence=evidence, evidence_gaps=args.evidence_gap)


def propose(args, repo):
    if args.number < 1 or not re.fullmatch(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", args.host) or not re.fullmatch(r"[0-9a-f]{40}", args.head_sha):
        raise ValueError("invalid PR number, host or head SHA")
    if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", args.updated_at):
        raise ValueError("updated-at must be a UTC GitHub timestamp")
    if bool(args.reference_kind) != bool(args.reference_number) or args.reference_number is not None and args.reference_number < 1:
        raise ValueError("reference kind and positive number must be supplied together")
    comment = args.comment_file.read_text(encoding="utf-8")
    if not comment.strip() or len(comment) > 65536 or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in comment):
        raise ValueError("comment must contain valid text of at most 65536 characters")
    if not args.title.strip() or not args.by.strip() or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in args.title + args.by):
        raise ValueError("title and proposer are required")
    if args.rationale is not None and (not args.rationale.strip() or len(args.rationale) > 10000 or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in args.rationale)):
        raise ValueError("supplied legacy rationale must be valid text of at most 10000 characters")
    reference = dict(kind=args.reference_kind, number=args.reference_number) if args.reference_kind else None
    inputs = declared_inputs(args, repo)
    if args.action is not None:
        taxonomy = load_taxonomy()
        if args.action not in taxonomy.get("actions", []) or taxonomy.get("action_operations", {}).get(args.action) != "close":
            raise ValueError("selected action is not a configured close type")
        guidance = ContextIndex().collect("pr", args.number, include_rows=False)["ledger_guidance"]
        if guidance is None or guidance["action"] != args.action:
            raise ValueError("selected action differs from the saved PR decision")

    value = dict(schema_version=1, artifact="auto-close-proposal", repo=repo, host=args.host, number=args.number,
                 target=f"https://{args.host}/{repo}/pull/{args.number}", title=args.title,
                 comment=comment, reference=reference, head_sha=args.head_sha, updated_at=args.updated_at,
                 proposed_by=args.by, proposed_at=now_iso(), request_id=str(uuid.uuid4()), status="pending", inputs=inputs)
    if args.action is not None:
        value["action"] = args.action
    if args.rationale is not None:
        value["rationale"] = args.rationale
    path = proposal_path(args.number)
    if path.parent.is_symlink():
        raise ValueError("invalid proposal directory")
    with guarded_lock(path):
        if path.exists():
            previous = load(path, repo)
            if args.replace_checkpoint != previous["checksum"] or previous["status"] not in ("pending", "rejected") or (DATA_DIR / "writes" / (previous["request_id"] + ".json")).exists():
                raise ValueError("proposal exists or has a write attempt; inspect it before replacing")
            if previous["status"] == "rejected":
                reason = args.reconsideration_reason
                if reason is None or not reason.strip() or len(reason) > 10000 or len(args.by) > 200 or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in reason):
                    raise ValueError("reconsidering a rejected proposal requires a valid explanation")
                value["reconsideration"] = dict(by=args.by, at=value["proposed_at"], reason=reason,
                                                rejected_checkpoint=previous["checksum"])
            elif args.reconsideration_reason is not None:
                raise ValueError("a reconsideration explanation requires a rejected proposal")
            elif "reconsideration" in previous:
                value["reconsideration"] = previous["reconsideration"]
            value["history"] = previous.get("history", []) + [{key: val for key, val in previous.items() if key != "history"}]
        elif args.replace_checkpoint is not None:
            raise ValueError("there is no proposal at the specified checkpoint")
        elif args.reconsideration_reason is not None:
            raise ValueError("a reconsideration explanation requires a rejected proposal")
        save(path, value)

    return row(value, local_state(repo))


def edit(args, repo):
    previous = load(proposal_path(args.number), repo)
    if previous["checksum"] != args.checkpoint or previous["status"] != "pending" or "inputs" not in previous:
        raise ValueError("proposal changed or has no editable pending context; reopen Notifications")
    if (DATA_DIR / "writes" / (previous["request_id"] + ".json")).exists():
        raise ValueError("proposal has a write attempt; reconcile it before editing")

    comment = args.comment_file.read_text(encoding="utf-8")
    if comment == previous["comment"] and (args.rationale is None or args.rationale == previous.get("rationale")):
        raise ValueError("proposal text is unchanged")

    inputs = previous["inputs"]
    handoff = inputs["group"]
    reference = previous["reference"] or {}
    replacement = argparse.Namespace(number=args.number, title=previous["title"], host=previous["host"],
                                     head_sha=previous["head_sha"], updated_at=previous["updated_at"],
                                     rationale=args.rationale, comment_file=args.comment_file, by=args.by,
                                     reference_kind=reference.get("kind"), reference_number=reference.get("number"),
                                     context_checkpoint=inputs["context_checkpoint"],
                                     group_id=handoff["id"] if handoff else None,
                                     member_context=[f"{member['kind']}:{member['number']}:{member['checkpoint']}" for member in handoff["members"]] if handoff else [],
                                     evidence=[f"{item['kind']}:{item['number']}:{item['snapshot_id']}" for item in inputs["evidence"]],
                                     evidence_gap=inputs["evidence_gaps"], replace_checkpoint=args.checkpoint,
                                     reconsideration_reason=None, action=previous.get("action"))
    return propose(replacement, repo)


def inspect(repo, host, number):
    if number < 1 or not re.fullmatch(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", host):
        raise ValueError("invalid PR number or host")

    def get(endpoint):
        result = subprocess.run(["gh", "api", "--hostname", host, "--method", "GET", endpoint], capture_output=True, text=True, timeout=60)
        if result.returncode:
            raise ValueError(result.stderr.strip() or "GitHub read failed")

        return json.loads(result.stdout)

    target = f"https://{host}/{repo}/pull/{number}"
    pull = get(f"repos/{repo}/pulls/{number}")
    issue = get(f"repos/{repo}/issues/{number}")
    head = (pull.get("head") or {}).get("sha") if isinstance(pull, dict) else None
    updated = issue.get("updated_at") if isinstance(issue, dict) else None
    if not isinstance(pull, dict) or pull.get("html_url") != target or pull.get("number") != number or not isinstance(pull.get("title"), str) or not pull["title"].strip() or pull.get("state") not in ("open", "closed") or type(pull.get("merged")) is not bool or not re.fullmatch(r"[0-9a-f]{40}", head or "") or not isinstance(issue, dict) or issue.get("html_url") != target or issue.get("number") != number or issue.get("state") != pull["state"] or "pull_request" not in issue or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", updated or ""):
        raise ValueError("live PR and issue identities or revisions differ from the configured target")

    return dict(repo=repo, host=host, number=number, target=target, title=pull.get("title"), state=pull.get("state"), merged=pull.get("merged"), head_sha=head, updated_at=updated, pr_updated_at=pull.get("updated_at"), requests=2)


def change(repo, action, number, checkpoint):
    path = proposal_path(number)
    proposal = load(path, repo)
    if proposal["checksum"] != checkpoint:
        raise ValueError("proposal changed; reopen Notifications")
    path = state_path()
    with guarded_lock(path):
        state = local_state(repo)
        presentation = state["rows"].setdefault(str(number), dict(viewed_checkpoint=None, dismissed_checkpoint=None))
        if action == "view":
            presentation["viewed_checkpoint"] = checkpoint
        else:
            presentation["dismissed_checkpoint"] = checkpoint
        with atomic_writer(path) as out:
            out.write(canonical(state) + "\n")

    return dict(number=number, action=action)


def reject(repo, number, checkpoint, by, reason):
    if number < 1 or not by.strip() or len(by) > 200 or len(reason) > 10000 or any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in by + reason):
        raise ValueError("rejection requires a positive PR number and contributor; any supplied reason must be valid")

    path = proposal_path(number)
    with guarded_lock(path):
        proposal = load(path, repo)
        if proposal["checksum"] != checkpoint or proposal["status"] != "pending":
            raise ValueError("proposal changed or is not pending; inspect it before rejecting")
        if (DATA_DIR / "writes" / (proposal["request_id"] + ".json")).exists():
            raise ValueError("proposal has a write attempt; reconcile it before changing feedback")

        previous = {key: value for key, value in proposal.items() if key != "history"}
        proposal["history"] = proposal.get("history", []) + [previous]
        proposal["status"] = "rejected"
        proposal["rejection"] = dict(proposal_checkpoint=checkpoint, by=by, at=now_iso(), reason=reason)
        save(path, proposal)

    return row(proposal, local_state(repo))


def call_comment(repo, proposal):
    script = Path(__file__).absolute().with_name("comment-plus")
    base = [str(script), "--expected-repo", repo, "--host", proposal["host"], "--kind", "pr", "--number", str(proposal["number"]),
            "--body=" + proposal["comment"], "--close", "--request-id", proposal["request_id"], "--expected-head", proposal["head_sha"],
            "--expected-updated-at", proposal["updated_at"]]
    preview = subprocess.run(base, capture_output=True, text=True)
    if preview.returncode:
        raise ValueError(preview.stderr.strip() or "comment plan failed")
    planned = json.loads(preview.stdout)
    if planned["plan"]["target"] != proposal["target"] or planned["plan"]["body"] != proposal["comment"] or planned["plan"]["operation"] != "close":
        raise ValueError("comment plan differs from proposal")
    result = subprocess.run(base + ["--publish", "--approve", planned["approval"]], capture_output=True, text=True)
    receipt = DATA_DIR / "writes" / (proposal["request_id"] + ".json")
    if receipt.exists():
        outcome = json.loads(receipt.read_text(encoding="utf-8"))
        if outcome.get("approval") != planned["approval"]:
            raise ValueError("saved write outcome does not match proposal")
        return outcome, result.returncode == 0
    if result.returncode:
        raise ValueError(result.stderr.strip() or "comment request failed before writing")

    raise ValueError("comment reported success without a saved write outcome")


def automation_policy(repo, proposal):
    action = proposal.get("action")
    if not action:
        raise ValueError("older PR closure proposal has no saved action type; stage it for human review")
    inputs = proposal.get("inputs") or {}
    evidence = inputs.get("evidence") or []
    complete_target = any(selected["kind"] == "pr" and selected["number"] == proposal["number"] and
                          all(component["status"] in ("complete", "not_applicable") for component in selected["components"].values())
                          for selected in evidence)
    if not complete_target or inputs.get("evidence_gaps") or proposal.get("reconsideration"):
        raise ValueError("direct PR closure needs complete selected target evidence and no unresolved gap or rejection")

    result = subprocess.run([str(Path(__file__).absolute().with_name("action-policy")), "status", "--expected-repo", repo], capture_output=True, text=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or "could not read action automation policy")
    rows = json.loads(result.stdout)["actions"]
    selected = next((row for row in rows if row["name"] == action), None)
    if selected is None or selected["operation"] != "close" or selected["mode"] != "execute" or not selected["configured"]:
        raise ValueError(f"{action} is not enabled for direct execution in this repository")

    return selected["definition_sha256"]


def execute(repo, numbers, all_pending, approval, automation=False):
    # Approval still binds the saved plan when a prior attempt needs reconciliation; fresh context is checked per item below.
    prepared = review(repo, numbers, all_pending, check_context=False)
    if approval != prepared["approval"]:
        raise ValueError("proposals changed or approval does not match the exact review")
    results = []
    completed_batch = {}
    for selected in prepared["plan"]["proposals"]:
        path = proposal_path(selected["number"])
        with guarded_lock(path):
            proposal = load(path, repo)
            if proposal["checksum"] != selected["checkpoint"] or proposal["status"] != "pending":
                raise ValueError("proposal changed during execution; stop and review remaining proposals")
            receipt = DATA_DIR / "writes" / (proposal["request_id"] + ".json")
            new_attempt = not receipt.exists()
            if new_attempt:
                check_current_context(proposal, completed_batch)
                definition = automation_policy(repo, proposal) if automation else None

            outcome, ok = call_comment(repo, proposal)
            proposal["outcome"] = dict(request_id=proposal["request_id"], comment=outcome["comment"], state_change=outcome["state_change"])
            if automation and new_attempt:
                proposal["outcome"]["authorization"] = dict(source="repository-policy", action=proposal["action"], definition_sha256=definition)
            proposal["status"] = "executed" if ok and outcome["comment"]["status"] == "succeeded" and outcome["state_change"]["status"] == "succeeded" else "uncertain"
            save(path, proposal)
            results.append(dict(number=proposal["number"], status=proposal["status"], outcome=proposal["outcome"]))
            if proposal["status"] != "executed":
                print(canonical(dict(results=results)))
                raise ValueError("write outcome uncertain; inspect GitHub and the saved record before any new proposal")
            if new_attempt:
                completed_batch[proposal["request_id"]] = proposal["target"]

    return dict(results=results)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-repo", required=True)
    commands = parser.add_subparsers(dest="command", required=True)
    add = commands.add_parser("propose")
    add.add_argument("--number", type=int, required=True)
    add.add_argument("--title", required=True)
    add.add_argument("--host", default="github.com")
    add.add_argument("--head-sha", required=True)
    add.add_argument("--updated-at", required=True)
    add.add_argument("--rationale", help="optional legacy assessment retained for compatibility")
    add.add_argument("--comment-file", type=Path, required=True)
    add.add_argument("--reference-kind", choices=("issue", "pr"))
    add.add_argument("--reference-number", type=int)
    add.add_argument("--by", required=True)
    add.add_argument("--action", help="saved ledger close type for a repository-enabled action pass")
    add.add_argument("--context-checkpoint", required=True, help="checkpoint from item-context read for this PR")
    add.add_argument("--group-id", help="active group whose exported member context informed this proposal")
    add.add_argument("--member-context", action="append", default=[], help="KIND:NUMBER:CHECKPOINT for every exported group member")
    add.add_argument("--evidence", action="append", default=[], help="KIND:NUMBER:SNAPSHOT_ID for selected immutable evidence")
    add.add_argument("--evidence-gap", action="append", default=[], help="explicitly missing evidence or a reason no snapshot was selected")
    add.add_argument("--replace-checkpoint", help="replace this exact pending or rejected revision after inspecting it; retains prior versions")
    add.add_argument("--reconsideration-reason", help="explain changed guidance or human resolution when replacing a rejected revision")
    change_text = commands.add_parser("edit", help="replace one pending proposal's exact comment from its current checkpoint")
    change_text.add_argument("--number", type=int, required=True)
    change_text.add_argument("--checkpoint", required=True)
    change_text.add_argument("--rationale", help="optional legacy assessment retained for compatibility")
    change_text.add_argument("--comment-file", type=Path, required=True)
    change_text.add_argument("--by", required=True)
    local_context = commands.add_parser("context", help="read bounded local guidance and check one saved proposal without GitHub")
    local_context.add_argument("--number", type=int, required=True)
    local_context.add_argument("--checkpoint", required=True)
    local_context.add_argument("--offset", type=int, default=0)
    local_context.add_argument("--context-checkpoint", help="pin the item-context revision when reading later pages")
    read = commands.add_parser("inspect", help="read one PR and its issue revision with two REST GETs; no writes")
    read.add_argument("--number", type=int, required=True)
    read.add_argument("--host", default="github.com")
    commands.add_parser("list")
    for action in ("view", "dismiss"):
        command = commands.add_parser(action)
        command.add_argument("--number", type=int, required=True)
        command.add_argument("--checkpoint", required=True)
    rejection = commands.add_parser("reject", help="retain attributed rejection of one exact pending proposal; no GitHub write")
    rejection.add_argument("--number", type=int, required=True)
    rejection.add_argument("--checkpoint", required=True)
    rejection.add_argument("--by", required=True)
    rejection.add_argument("--reason", default="")
    for action in ("review", "execute"):
        command = commands.add_parser(action)
        selection = command.add_mutually_exclusive_group(required=True)
        selection.add_argument("--number", type=int, action="append")
        selection.add_argument("--all", action="store_true")
        if action == "execute":
            command.add_argument("--publish", action="store_true")
            command.add_argument("--approve")
            command.add_argument("--automation", action="store_true", help="recheck repository policy for every selected action")
    args = parser.parse_args()
    repo = read_repo()
    if args.expected_repo != repo:
        raise ValueError("configured repository changed; reopen the proposals")
    if args.command == "propose":
        result = propose(args, repo)
    elif args.command == "edit":
        result = edit(args, repo)
    elif args.command == "inspect":
        result = inspect(repo, args.host, args.number)
    elif args.command == "list":
        state = local_state(repo)
        result = dict(repository=repo, rows=[row(p, state) for p in proposals(repo)], requests=0)
    elif args.command == "context":
        result = context(repo, args.number, args.checkpoint, args.offset, args.context_checkpoint)
    elif args.command in ("view", "dismiss"):
        result = change(repo, args.command, args.number, args.checkpoint)
    elif args.command == "reject":
        result = reject(repo, args.number, args.checkpoint, args.by, args.reason)
    elif args.command == "review" or not args.publish:
        result = review(repo, args.number, args.all)
    else:
        if not args.approve:
            raise ValueError("publishing requires approval of the exact reviewed proposal set")
        result = execute(repo, args.number, args.all, args.approve, args.automation)
    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        sys.exit(f"error: {exc}")
