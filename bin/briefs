#!/usr/bin/env python3
"""Plan, list, read, and mark this install's maintainer briefs without a GitHub request."""

import argparse
import hashlib
import json
import math
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))  # absolute, never resolve: see work_root() in bin/_install.py
from _briefed import BATCH_BRIEF_RE, BRIEF_DATE, ITEM_BRIEF_RE, READ_SUFFIX, active_name, read_name, visible_batch_briefs
from _storage import locked
from _triage import DATA_DIR, REPO, REPORTS_DIR, WORK_ROOT


MASTER = re.compile(rf"^({BRIEF_DATE})-(?:master(?:-[A-Za-z0-9_-]+)?-brief|brief)\.md$")
GROUP = re.compile(rf"^({BRIEF_DATE})-(?:ready-groups|group-[A-Za-z0-9_-]+)-brief\.md$")
MAX_BRIEFS = 5000
MAX_BRIEF_BYTES = 1024 * 1024
DEFAULT_PLAN_LIMIT = 10


def category(name):
    if match := MASTER.fullmatch(name):
        return "master", "master", match.group(1)

    if match := ITEM_BRIEF_RE.fullmatch(name):
        return "item", match.group(2), match.group(1)

    if match := GROUP.fullmatch(name):
        return "work", "group", match.group(1)

    if match := BATCH_BRIEF_RE.fullmatch(name):
        return "work", "batch", match.group(1)

    return None


def heading(path):
    with path.open(encoding="utf-8", errors="replace") as source:
        for _ in range(20):
            line = source.readline(4096)
            if not line:
                break

            if line.startswith("# "):
                title = re.sub(r"[\x00-\x1f\x7f]", " ", line[2:]).strip()
                if title:
                    return title[:240]

    return path.stem.replace("-", " ")


def record(path):
    kind = category(path.name)
    if kind is None or path.is_symlink() or not path.is_file():
        raise ValueError("brief path is missing or outside the supported report names")

    section, brief_type, date = kind
    return dict(id=path.name, section=section, type=brief_type, date=date, title=heading(path))


def reports_dir():
    if not REPORTS_DIR.resolve().is_relative_to(WORK_ROOT.resolve()):
        raise ValueError("reports path leaves this install")

    return REPORTS_DIR


def list_briefs():
    directory = reports_dir()
    if not directory.is_dir():
        return []

    paths = [
        path for path in directory.iterdir()
        if category(path.name) is not None and path.is_file() and not path.is_symlink()
    ]
    if len(paths) > MAX_BRIEFS:
        raise ValueError(f"more than {MAX_BRIEFS} briefs; narrow or archive the report directory")

    rows = [record(path) for path in paths]
    group_order = {"group": 0, "batch": 1}
    rows.sort(key=lambda row: (row["date"], row["id"]), reverse=True)
    rows.sort(key=lambda row: ("master", "item", "work").index(row["section"]))
    rows.sort(key=lambda row: group_order.get(row["type"], 0) if row["section"] == "work" else -1)
    return rows


def read_brief(name):
    if Path(name).name != name or category(name) is None:
        raise ValueError("invalid brief ID")

    path = reports_dir() / name
    row = record(path)
    if path.stat().st_size > MAX_BRIEF_BYTES:
        raise ValueError("brief exceeds the 1 MiB reader limit")

    content = path.read_text(encoding="utf-8")
    if not content.strip():
        raise ValueError("brief is empty")

    return dict(record=row, content=content)


def planned_path(value):
    requested = Path(value)
    directory = reports_dir()
    relative = Path("reports") / REPO / requested.name
    if requested.is_absolute():
        if requested.parent != directory:
            raise ValueError("brief is outside this repository's reports directory")
    elif requested != Path(requested.name) and requested != relative:
        raise ValueError("brief is outside this repository's reports directory")

    name = requested.name
    base = active_name(name)
    kind = category(base)
    path = directory / name
    if kind is None or kind[1] not in ("batch", "group", "issue", "pr") or path.is_symlink() or not path.is_file():
        raise ValueError(f"not a supported source brief: {value}")

    return path, kind, name != base


def plan_briefs(names, all_briefs, include_read, limit):
    if names and (all_briefs or include_read or limit is not None):
        raise ValueError("--brief cannot be combined with --all, --include-read, or --limit")

    if all_briefs and limit is not None:
        raise ValueError("--all cannot be combined with --limit")

    limit = DEFAULT_PLAN_LIMIT if limit is None else limit
    if not 1 <= limit <= MAX_BRIEFS:
        raise ValueError(f"--limit must be between 1 and {MAX_BRIEFS}")

    if names:
        selected = [planned_path(name) for name in names]
    else:
        sources = visible_batch_briefs()
        if include_read:
            sources += [path.name for path in reports_dir().glob("*" + READ_SUFFIX) if BATCH_BRIEF_RE.fullmatch(active_name(path.name))]

        selected = [planned_path(name) for name in sources]
        selected.sort(key=lambda source: (source[1][2], source[0].name), reverse=True)
        if not all_briefs:
            selected = selected[:limit]

    if len(selected) > MAX_BRIEFS or len({active_name(path.name) for path, _, _ in selected}) != len(selected):
        raise ValueError("brief selection is too large or contains duplicates")

    rows = [dict(id=path.name, path=(Path("reports") / REPO / path.name).as_posix(), type=kind[1], date=kind[2], read=is_read)
            for path, kind, is_read in selected]
    count = len(rows)
    target = math.ceil(2 + 2 * math.log2(count)) if count else 0
    return dict(selection="explicit" if names else "all" if all_briefs else "recent", source_count=count, target_decisions=target, briefs=rows)


def mark_read_preview(names):
    if not names or len(names) > MAX_BRIEFS or len(set(names)) != len(names):
        raise ValueError("select one or more distinct brief IDs")

    directory = reports_dir()
    renames = []
    for name in names:
        if Path(name).name != name or category(name) is None:
            raise ValueError(f"invalid brief ID: {name}")

        source = directory / name
        target = directory / read_name(name)
        if source.is_symlink() or not source.is_file() or target.exists() or target.is_symlink():
            raise ValueError(f"brief changed or read destination already exists: {name}")

        digest = hashlib.sha256()
        with source.open("rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(block)

        renames.append(dict(source=name, target=target.name, content_sha256=digest.hexdigest()))

    payload = dict(repository=REPO, renames=renames)
    token = hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    return dict(renames=renames, preview_sha256=token)


def mark_read(names, apply, preview_sha256):
    if not apply:
        return dict(applied=False, **mark_read_preview(names))

    if not re.fullmatch(r"[0-9a-f]{64}", preview_sha256 or ""):
        raise ValueError("--apply requires the exact --preview-sha256 from a dry run")

    with locked(DATA_DIR / "briefs"):
        preview = mark_read_preview(names)
        if preview["preview_sha256"] != preview_sha256:
            raise ValueError("brief selection or content changed since preview; preview again")

        directory = reports_dir()
        for row in preview["renames"]:
            os.rename(directory / row["source"], directory / row["target"])

    return dict(applied=True, **preview)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-repo", help="refuse a changed install target")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list", help="list supported master, item, group and batch briefs")
    read = commands.add_parser("read", help="read one supported brief by filename")
    read.add_argument("id")
    plan = commands.add_parser("plan", help="select source briefs and calculate a master-brief size target")
    plan.add_argument("--brief", action="append", default=[], help="use this exact source brief ID or reports path; repeat for a named set")
    plan.add_argument("--all", action="store_true", help="select every visible batch brief")
    plan.add_argument("--include-read", action="store_true", help="include batch briefs marked read in an automatic selection")
    plan.add_argument("--limit", type=int, help=f"newest visible batch briefs for an ordinary plan (default: {DEFAULT_PLAN_LIMIT})")
    mark = commands.add_parser("mark-read", help="preview exact _READ.md renames; --apply needs the preview checksum")
    mark.add_argument("ids", nargs="+", help="supported brief filenames shown in the menu")
    mark.add_argument("--apply", action="store_true")
    mark.add_argument("--preview-sha256")
    args = parser.parse_args()
    if args.expected_repo is not None and args.expected_repo != REPO:
        parser.error("configured repository does not match --expected-repo")

    if args.command == "list":
        result = dict(schema_version=1, repository=REPO, records=list_briefs())
    elif args.command == "read":
        result = dict(schema_version=1, repository=REPO, **read_brief(args.id))
    elif args.command == "plan":
        result = dict(schema_version=1, repository=REPO, **plan_briefs(args.brief, args.all, args.include_read, args.limit))
    else:
        result = dict(schema_version=1, repository=REPO, **mark_read(args.ids, args.apply, args.preview_sha256))

    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except (OSError, UnicodeError, ValueError) as error:
        sys.exit(f"error: {error}")
