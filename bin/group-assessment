#!/usr/bin/env python3
"""Record a bounded group-discovery scope and its created-group or no-group result."""

import argparse
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _assessment_evidence import selected_item
from _candidates import create_from_packet
from _evidence import canonical, digest
from _groups import load_group
from _storage import atomic_writer, locked
from _triage import DATA_DIR, REPO, load_ledger, now_iso, parse_key


RECORDS = DATA_DIR / "group-assessments"
MAX_RECORDS = 5000
MAX_RECORD_BYTES = 65536
MAX_PACKET_BYTES = 4 * 1024 * 1024


def topic_scope(args):
    if not args.topic or not args.topic.strip() or len(args.topic) > 200 or not 2 <= len(args.evidence) <= 30:
        raise ValueError("topic scopes need a short topic and two to thirty selected evidence references")
    if args.candidate_file or args.candidate:
        raise ValueError("topic scope cannot include a candidate packet")

    selected = {}
    for value in args.evidence:
        parts = value.split(":", 2)
        key = parse_key(":".join(parts[:2])) if len(parts) == 3 else None
        if key is None or key in selected or not re.fullmatch(r"[0-9a-f]{64}", parts[2]):
            raise ValueError("use distinct --evidence KIND:NUMBER:SNAPSHOT_ID references")

        selected[key] = parts[2]

    ledger = {(row["kind"], row["number"]): row for row in load_ledger()}
    references = []
    gaps = []
    for key in sorted(selected):
        if key not in ledger:
            raise ValueError(f"{key[0]}:{key[1]} is absent from the ledger")

        reference = selected_item(*key, selected[key], host=args.host)
        references.append(reference)
        if reference["revision"]["updated_at"] != ledger[key].get("updated_at"):
            gaps.append(f"{key[0]}:{key[1]}: selected revision differs from the ledger")
        if reference["coverage"].get("summary") != "complete":
            gaps.append(f"{key[0]}:{key[1]}: summary is not complete")

    return dict(type="topic", topic=args.topic.strip(), member_keys=[f"{kind}:{number}" for kind, number in sorted(selected)],
                evidence=references), gaps


def candidate_scope(args):
    if not args.candidate_file or not args.candidate or args.topic or args.evidence:
        raise ValueError("candidate scopes need a packet and candidate ID, without topic evidence flags")
    path = args.candidate_file
    if path.is_symlink() or not path.is_file() or path.stat().st_size > MAX_PACKET_BYTES:
        raise ValueError("candidate packet is missing, a symlink or too large")

    group = create_from_packet(json.loads(path.read_text(encoding="utf-8")), args.candidate, args.by.strip())
    origin = group["candidate_origin"]
    return dict(type="candidate-set", topic=group["title"], member_keys=[f"pr:{row['number']}" for row in group["members"]],
                source=origin["source"], options=origin["options"], checkpoint=origin["checkpoint"], suggestion=origin["suggestion"]), []


def assess(args):
    if not args.by.strip() or len(args.by) > 200 or not args.reason.strip() or len(args.reason) > 2000:
        raise ValueError("an attributed short assessment reason is required")
    if len(args.gap) > 20 or any(not gap.strip() or len(gap) > 500 for gap in args.gap):
        raise ValueError("evidence gaps must be short and bounded")
    if (args.outcome == "no-group") != (args.group_id is None):
        raise ValueError("created or extended results need --group-id; no-group must omit it")

    scope, automatic_gaps = topic_scope(args) if args.scope_type == "topic" else candidate_scope(args)
    group = None
    if args.group_id:
        saved = load_group(args.group_id)
        members = {f"{row['kind']}:{row['number']}" for row in saved["members"]}
        if not members or not members <= set(scope["member_keys"]):
            raise ValueError("group members are outside the examined scope")
        if args.scope_type == "candidate" and saved.get("candidate_origin", {}).get("suggestion", {}).get("id") != scope["suggestion"]["id"]:
            raise ValueError("group has a different pinned candidate origin")

        group = dict(id=saved["id"], revision=saved["revision"], checksum=digest(canonical(saved)), member_keys=sorted(members))

    content = dict(repository=REPO, scope=scope, outcome=args.outcome, reason=args.reason.strip(), gaps=[*args.gap, *automatic_gaps],
                   group=group, assessed_by=args.by.strip())
    assessment_id = digest(canonical(content))
    path = RECORDS / f"{assessment_id}.json"
    if RECORDS.is_symlink():
        raise ValueError("invalid group assessment directory")

    with locked(RECORDS):
        if path.exists() or path.is_symlink():
            prior = read(assessment_id)
            if all(prior.get(field) == content[field] for field in content):
                return prior

            raise ValueError("group assessment ID has conflicting contents")

        record = dict(schema_version=1, artifact="group-assessment", assessment_id=assessment_id, assessed_at=now_iso(), **content)
        record["checksum"] = digest(canonical(record))
        RECORDS.mkdir(parents=True, exist_ok=True)
        with atomic_writer(path) as output:
            output.write(canonical(record) + "\n")

    return record


def read(assessment_id):
    if not re.fullmatch(r"[0-9a-f]{64}", assessment_id):
        raise ValueError("invalid group assessment ID")

    path = RECORDS / f"{assessment_id}.json"
    if RECORDS.is_symlink() or path.is_symlink() or not path.is_file() or path.stat().st_size > MAX_RECORD_BYTES:
        raise ValueError("group assessment is missing or invalid")

    record = json.loads(path.read_text(encoding="utf-8"))
    checksum = record.pop("checksum", None)
    content = {field: record[field] for field in ("repository", "scope", "outcome", "reason", "gaps", "group", "assessed_by")}
    if (record.get("schema_version") != 1 or record.get("artifact") != "group-assessment" or record.get("repository") != REPO or
            record.get("assessment_id") != assessment_id or digest(canonical(content)) != assessment_id or digest(canonical(record)) != checksum):
        raise ValueError("group assessment identity or contents changed")

    record["checksum"] = checksum
    return record


def current(record):
    group = record["group"]
    if group is None:
        group_current = None
    else:
        try:
            saved = load_group(group["id"])
        except FileNotFoundError:
            group_current = False
        else:
            group_current = digest(canonical(saved)) == group["checksum"]

    if record["scope"]["type"] == "topic":
        ledger = {(row["kind"], row["number"]): row for row in load_ledger()}
        sources = [dict(key=f"{reference['identity']['kind']}:{reference['identity']['number']}",
                        ledger_revision_current=reference["revision"]["updated_at"] == ledger.get((reference["identity"]["kind"], reference["identity"]["number"]), {}).get("updated_at"))
                   for reference in record["scope"]["evidence"]]
    else:
        sources = []

    return dict(group_current=group_current, sources=sources)


def list_records(limit):
    if not 1 <= limit <= MAX_RECORDS:
        raise ValueError(f"limit must be between 1 and {MAX_RECORDS}")
    if not RECORDS.exists():
        return []
    if RECORDS.is_symlink() or not RECORDS.is_dir():
        raise ValueError("invalid group assessment directory")

    paths = sorted(RECORDS.glob("*.json"))
    if len(paths) > MAX_RECORDS:
        raise ValueError("too many group assessments")

    records = [read(path.stem) for path in paths]
    records.sort(key=lambda row: (row["assessed_at"], row["assessment_id"]), reverse=True)
    return [dict(assessment_id=row["assessment_id"], scope_type=row["scope"]["type"], topic=row["scope"]["topic"],
                 outcome=row["outcome"], group_id=(row["group"] or {}).get("id"), assessed_at=row["assessed_at"]) for row in records[:limit]]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-repo", required=True)
    commands = parser.add_subparsers(dest="command", required=True)
    saving = commands.add_parser("record")
    saving.add_argument("--scope-type", choices=("topic", "candidate"), required=True)
    saving.add_argument("--topic")
    saving.add_argument("--evidence", action="append", default=[])
    saving.add_argument("--host", default="github.com")
    saving.add_argument("--candidate-file", type=Path)
    saving.add_argument("--candidate")
    saving.add_argument("--outcome", choices=("no-group", "created", "extended"), required=True)
    saving.add_argument("--group-id")
    saving.add_argument("--reason", required=True)
    saving.add_argument("--gap", action="append", default=[])
    saving.add_argument("--by", required=True)
    showing = commands.add_parser("show")
    showing.add_argument("assessment_id")
    listing = commands.add_parser("list")
    listing.add_argument("--limit", type=int, default=100)
    args = parser.parse_args()

    if args.expected_repo != REPO:
        raise ValueError("selected repository changed")

    if args.command == "record":
        result = assess(args)
    elif args.command == "show":
        record = read(args.assessment_id)
        result = dict(record=record, current=current(record))
    else:
        result = dict(repository=REPO, records=list_records(args.limit))

    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        sys.exit(f"error: {error}")
