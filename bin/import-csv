#!/usr/bin/env python3
"""Import a human-edited CSV from bin/export-csv with per-row stale-export checks.

Usage: bin/import-csv PATH [--by NAME]

Editable columns: proposed_labels (a JSON list), action, confidence, reason, reviewed, reviewed_by, reviewer_notes.
Keep kind, number, and review_revision from the export. Export again after any ledger change.
"""

import argparse
import csv
import getpass
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _csv_revision import review_revision
from _triage import LEDGER_PATH, REPO, has_decision, load_ledger, load_taxonomy, now_iso, observed_catalog, save_ledger
from _storage import locked

DECISION = ("proposed_labels", "action", "confidence", "reason")
EDITABLE = (*DECISION, "reviewed", "reviewed_by", "reviewer_notes")
TRUE = {"true", "1", "yes", "y"}
FALSE = {"false", "0", "no", "n", ""}
REQUIRED = {"kind", "number", "review_revision"}


def fail(message):
    sys.exit(f"error: {message}")


def parse_reviewed(value, line):
    normalized = value.strip().lower()
    if normalized in TRUE:
        return True

    if normalized in FALSE:
        return False

    fail(f"CSV row {line}: invalid reviewed value {value!r}")


def parse_proposed_labels(value, line):
    try:
        labels = json.loads(value)
    except ValueError:
        fail(f"CSV row {line}: proposed_labels must be a JSON list")

    if not isinstance(labels, list) or any(not isinstance(name, str) or not name for name in labels) or len(set(labels)) != len(labels):
        fail(f"CSV row {line}: proposed_labels must contain distinct label names")

    return labels


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("csv_path", type=Path)
    ap.add_argument("--by", default=getpass.getuser())
    args = ap.parse_args()

    if not args.csv_path.exists():
        fail(f"{args.csv_path} not found")

    args.by = args.by.strip()

    with locked(LEDGER_PATH):
        ledger = load_ledger()
        by_key = {(r["kind"], r["number"]): r for r in ledger}
        catalog = observed_catalog(load_taxonomy())
        proposed = []
        seen = set()
        approvals_cleared = 0
        with args.csv_path.open(newline="", encoding="utf-8-sig") as f:
            reader = csv.DictReader(f)
            headers = reader.fieldnames or []
            if len(headers) != len(set(headers)):
                fail("duplicate CSV headers")

            if not REQUIRED.issubset(headers):
                fail("CSV needs kind, number, and review_revision; make a fresh export")

            for line, row in enumerate(reader, 2):
                if None in row or any(value is None for value in row.values()):
                    fail(f"CSV row {line}: malformed columns")

                try:
                    key = (row["kind"], int(row["number"]))
                except ValueError:
                    fail(f"CSV row {line}: invalid number")

                if key in seen:
                    fail(f"CSV row {line}: duplicate item {key}")

                seen.add(key)
                rec = by_key.get(key)
                if rec is None:
                    fail(f"CSV row {line}: {key} is not in the ledger")

                if row["review_revision"] != review_revision(rec):
                    fail(f"CSV row {line}: stale or missing review_revision for {key}; make a fresh export")

                updated = dict(rec)
                for field in EDITABLE:
                    if field in row:
                        if field == "reviewed":
                            updated[field] = parse_reviewed(row[field], line)
                        elif field == "proposed_labels":
                            updated[field] = parse_proposed_labels(row[field], line)
                        else:
                            updated[field] = row[field]

                if "proposed_labels" not in rec and updated.get("proposed_labels") == []:
                    updated.pop("proposed_labels", None)

                decision_changed = any(
                    updated.get(k, [] if k == "proposed_labels" else "")
                    != rec.get(k, [] if k == "proposed_labels" else "")
                    for k in DECISION
                )
                if decision_changed:
                    if not args.by:
                        fail(f"CSV row {line}: --by must name the person changing the decision")

                    if updated.get("proposed_labels", []) != rec.get("proposed_labels", []):
                        if catalog is None:
                            fail(f"CSV row {line}: refresh the repository label catalog before changing proposed labels")

                        names = {label.get("name") for label in catalog["labels"] if isinstance(label, dict)}
                        if set(updated["proposed_labels"]) - names:
                            fail(f"CSV row {line}: proposed labels are absent from the current catalog")

                    updated["triaged_by"] = args.by
                    updated["triaged_at"] = now_iso()
                    updated["batch_id"] = "csv:" + args.csv_path.stem

                if rec["reviewed"] and decision_changed:
                    updated["reviewed"] = False
                    updated["reviewed_by"] = ""
                    updated["reviewed_at"] = ""
                    approvals_cleared += 1
                elif updated["reviewed"]:
                    if not has_decision(updated):
                        fail(f"CSV row {line}: reviewed item needs proposed labels or an action")

                    if not rec["reviewed"]:
                        updated["reviewed_by"] = updated["reviewed_by"] or args.by
                        updated["reviewed_at"] = now_iso()

                    if not updated["reviewed_by"].strip():
                        fail(f"CSV row {line}: reviewer name required")
                else:
                    updated["reviewed_by"] = ""
                    updated["reviewed_at"] = ""

                proposed.append((key, updated))

        changed = 0
        for key, updated in proposed:
            if updated != by_key[key]:
                by_key[key] = updated
                changed += 1

        if changed:
            save_ledger(list(by_key.values()))

    print(f"Imported {args.csv_path.name}: {changed} rows changed.")
    if approvals_cleared:
        print(f"Cleared prior approval on {approvals_cleared} changed decision(s); export again to review them.")


if __name__ == "__main__":
    main()
