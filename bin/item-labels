#!/usr/bin/env python3
"""Preview and run bounded, repository-enabled GitHub item labeling from local proposals."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _evidence import value_digest
from _storage import atomic_writer, locked
from _triage import CONFIG_DIR, DATA_DIR, REPO, load_ledger, load_taxonomy, now_iso, observed_catalog, parse_key


POLICY_PATH = CONFIG_DIR / "label-application.json"
STATE_PATH = DATA_DIR / "local" / "item-labels-state.json"
OUTCOMES_PATH = DATA_DIR / "local" / "item-labels-outcomes.jsonl"
PASS_LOCK = DATA_DIR / "item-labels"


def fail(parser, message):
    parser.exit(1, f"error: {message}\n")


def read_json(path, fallback):
    if not path.exists():
        return fallback

    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")

    return value


def save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)

    with atomic_writer(path) as out:
        out.write(json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def policy():
    value = read_json(POLICY_PATH, {"version": 1, "repositories": {}})
    if value.get("version") != 1 or not isinstance(value.get("repositories"), dict):
        raise ValueError("label-application policy is malformed")

    for repo, setting in value["repositories"].items():
        if not isinstance(repo, str) or not isinstance(setting, dict) or type(setting.get("enabled")) is not bool:
            raise ValueError("label-application repository setting is malformed")

    return value


def enabled():
    return policy()["repositories"].get(REPO, {}).get("enabled", True) is True


def state():
    value = read_json(STATE_PATH, {"version": 1, "repository": REPO, "items": {}, "next_order": 0})
    if value.get("version") != 1 or value.get("repository") != REPO or not isinstance(value.get("items"), dict) or type(value.get("next_order", 0)) is not int or value.get("next_order", 0) < 0:
        raise ValueError("item-label state is malformed or belongs to another repository")

    for key, row in value["items"].items():
        if parse_key(key) is None or not isinstance(row, dict):
            raise ValueError("item-label state has an invalid item identity")

        for field in ("last_labels", "managed"):
            names = row.get(field, [])
            if not isinstance(names, list) or any(not isinstance(name, str) or not name for name in names) or len(names) != len(set(names)):
                raise ValueError(f"item-label state has invalid {field} for {key}")

        if not set(row.get("managed", [])).issubset(row.get("last_labels", [])):
            raise ValueError(f"item-label state has managed labels absent from its observation for {key}")

        if type(row.get("pending", False)) is not bool or type(row.get("paused", False)) is not bool:
            raise ValueError(f"item-label state has invalid control flags for {key}")

        if "checked_order" in row and (type(row["checked_order"]) is not int or row["checked_order"] < 1 or row["checked_order"] > value.get("next_order", 0)):
            raise ValueError(f"item-label state has an invalid checked order for {key}")

    return value


def status():
    saved = state()
    return {"repository": REPO, "enabled": enabled(), "tracked_items": len(saved["items"]),
            "pending_items": [key for key, row in saved["items"].items() if row.get("pending")],
            "paused_items": [key for key, row in saved["items"].items() if row.get("paused")]}


def policy_plan(enable):
    before = enabled()
    plan = {"repository": REPO, "operation": "enable" if enable else "disable", "before": before, "after": enable}
    plan["preview_sha256"] = value_digest(plan)
    return plan


def reset_plan(saved, kind, number, transport):
    key = f"{kind}:{number}"
    prior = saved["items"].get(key)
    if not isinstance(prior, dict):
        raise ValueError(f"no saved item-label state for {key}")

    live_state, live_labels = transport.item(number)
    plan = {"repository": REPO, "operation": "reset-item", "key": key, "before": prior,
            "current_state": live_state, "current_labels": live_labels,
            "after": {"last_labels": live_labels, "managed": [], "pending": False, "paused": False}}
    plan["preview_sha256"] = value_digest(plan)
    return plan


class Transport:
    def __init__(self, budget):
        self.budget = budget
        self.used = 0

    def api(self, method, endpoint, body=None):
        if self.used >= self.budget:
            raise ValueError("GitHub request budget exhausted")

        self.used += 1

        command = ["gh", "api", "--method", method, endpoint]
        if body is not None:
            command += ["--input", "-"]

        try:
            result = subprocess.run(command, input=json.dumps(body) if body is not None else None,
                                    capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ValueError(f"GitHub {method} may have been attempted for {endpoint}: {error}") from error

        if result.returncode:
            raise ValueError(f"GitHub {method} failed for {endpoint}: {result.stderr.strip() or 'gh api failed'}")

        if not result.stdout.strip():
            return None

        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ValueError(f"invalid GitHub response for {endpoint}: {error}") from error

    def item(self, number):
        value = self.api("GET", f"repos/{REPO}/issues/{number}")
        if not isinstance(value, dict) or value.get("number") != number or value.get("state") not in ("open", "closed") or not isinstance(value.get("labels"), list):
            raise ValueError(f"invalid GitHub item #{number} response")

        labels = []

        for row in value["labels"]:
            name = row.get("name") if isinstance(row, dict) else None
            if not isinstance(name, str) or not name or name in labels:
                raise ValueError(f"invalid GitHub labels for #{number}")

            labels.append(name)

        return value["state"], labels


def decision_digest(row):
    return value_digest({key: row.get(key) for key in ("kind", "number", "state", "proposed_labels")})


def candidates(saved, limit, selected_keys=()):
    def priority(row):
        key = f"{row['kind']}:{row['number']}"
        checked = saved["items"].get(key, {}).get("checked_order", 0)

        return (checked > 0, checked, bool(row.get("labels")), row["kind"], row["number"])

    rows = load_ledger()
    rows.sort(key=priority)
    chosen = []
    selected = set(selected_keys)

    for row in rows:
        key = f"{row['kind']}:{row['number']}"
        if selected and key not in selected:
            continue

        prior = saved["items"].get(key, {})
        if row.get("state") != "open":
            continue

        if row.get("proposed_labels") or prior.get("managed") or prior.get("pending"):
            chosen.append((key, row))

        if len(chosen) >= limit:
            break

    if selected and set(selected_keys) != {key for key, _ in chosen}:
        raise ValueError(f"selected items have no eligible label proposal: {sorted(selected - {key for key, _ in chosen})}")

    return chosen


def mark_checked(saved, key, row):
    saved["next_order"] = saved.get("next_order", 0) + 1
    saved["items"][key] = {**row, "checked_order": saved["next_order"]}
    save_json(STATE_PATH, saved)


def build_plan(saved, limit, transport, selected_keys=()):
    catalog = observed_catalog(load_taxonomy())
    if catalog is None:
        raise ValueError("this repository's label catalog is pending; sync Labels first")

    definitions = catalog["labels"]
    if any(not isinstance(row, dict) or type(row.get("id")) is not int or not isinstance(row.get("name"), str) or not row["name"] for row in definitions):
        raise ValueError("this repository's label catalog is malformed")

    names = {row["name"] for row in definitions}
    if len(names) != len(definitions) or len({row["id"] for row in definitions}) != len(definitions):
        raise ValueError("this repository's label catalog has duplicate label identities")

    rows = []

    for key, decision in candidates(saved, limit, selected_keys):
        desired = decision.get("proposed_labels") or []
        prior = saved["items"].get(key, {})
        item = {"kind": decision["kind"], "number": decision["number"], "decision_sha256": decision_digest(decision),
                "desired": desired, "managed_before": prior.get("managed", []), "status": "ready"}
        if not isinstance(desired, list) or any(not isinstance(name, str) or name not in names for name in desired) or len(desired) != len(set(desired)):
            item["status"] = "stale-proposal"
        elif prior.get("pending"):
            item["status"] = "uncertain-write"
        elif prior.get("paused"):
            item["status"] = "paused-after-correction"

        if item["status"] == "ready":
            live_state, live_labels = transport.item(decision["number"])
            item["observed_state"], item["observed_labels"] = live_state, live_labels
            if live_state != decision["state"]:
                item["status"] = "changed-state"
            elif "last_labels" in prior and set(live_labels) != set(prior["last_labels"]):
                item["status"] = "human-correction"
            else:
                item["add"] = [name for name in desired if name not in live_labels]
                item["remove"] = [name for name in prior.get("managed", []) if name not in desired and name in live_labels]
                if not item["add"] and not item["remove"]:
                    item["status"] = "no-change"

        rows.append(item)

    plan = {"repository": REPO, "enabled": enabled(), "limit": limit, "request_budget": transport.budget, "requests": transport.used,
            "selected_keys": list(selected_keys), "items": rows}
    plan["preview_sha256"] = value_digest(plan)
    return plan


def record_outcome(row):
    OUTCOMES_PATH.parent.mkdir(parents=True, exist_ok=True)

    with OUTCOMES_PATH.open("a", encoding="utf-8") as out:
        out.write(json.dumps({"repository": REPO, "at": now_iso(), **row}, ensure_ascii=False) + "\n")
        out.flush()
        os.fsync(out.fileno())


def run_pass(parser, args):
    with locked(PASS_LOCK):
        saved = state()
        transport = Transport(args.request_budget)
        plan = build_plan(saved, args.limit, transport, args.keys)
        if plan["preview_sha256"] != args.preview_sha256:
            fail(parser, "the selected decisions or GitHub labels changed; preview the pass again")

        if not enabled():
            fail(parser, "Labeling is OFF for this repository in Settings → Automations")

        remaining = sum(2 + 2 * bool(row.get("add")) + 2 * len(row.get("remove", [])) for row in plan["items"] if row["status"] in ("ready", "no-change"))
        if transport.used + remaining > transport.budget:
            fail(parser, "request budget cannot cover revalidation and outcomes for this preview")

        outcomes = []

        for row in plan["items"]:
            key = f"{row['kind']}:{row['number']}"
            if row["status"] not in ("ready", "no-change"):
                prior = saved["items"].get(key, {})
                if row["status"] == "human-correction":
                    prior = {**prior, "paused": True}

                mark_checked(saved, key, prior)
                record_outcome({"key": key, "status": row["status"], "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": row["status"]})
                continue

            fresh = next((item for item in load_ledger() if item.get("kind") == row["kind"] and item.get("number") == row["number"]), None)
            if fresh is None or decision_digest(fresh) != row["decision_sha256"]:
                mark_checked(saved, key, saved["items"].get(key, {}))
                record_outcome({"key": key, "status": "changed-decision", "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "changed-decision"})
                continue

            live_state, live_labels = transport.item(row["number"])
            if live_state != row.get("observed_state") or set(live_labels) != set(row.get("observed_labels", [])):
                mark_checked(saved, key, saved["items"].get(key, {}))
                record_outcome({"key": key, "status": "changed-on-github", "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "changed-on-github"})
                continue

            prior = saved["items"].get(key, {})
            if row["status"] == "no-change":
                mark_checked(saved, key, {"last_labels": live_labels, "managed": prior.get("managed", []), "pending": False})
                record_outcome({"key": key, "status": "no-change", "labels": live_labels, "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "no-change"})
                continue

            mark_checked(saved, key, {"last_labels": live_labels, "managed": prior.get("managed", []), "pending": True,
                                      "attempt": {"add": row["add"], "remove": row["remove"], "preview_sha256": args.preview_sha256}})
            record_outcome({"key": key, "status": "attempting", "add": row["add"], "remove": row["remove"], "preview_sha256": args.preview_sha256})
            endpoint = f"repos/{REPO}/issues/{row['number']}/labels"

            try:
                expected = set(live_labels)
                if row["add"]:
                    transport.api("POST", endpoint, {"labels": row["add"]})
                    _, added_state = transport.item(row["number"])
                    if set(added_state) != expected | set(row["add"]):
                        raise ValueError("GitHub label state changed during addition")

                    expected = set(added_state)

                for name in row["remove"]:
                    _, before_remove = transport.item(row["number"])
                    if set(before_remove) != expected:
                        raise ValueError("GitHub labels changed before removal")

                    transport.api("DELETE", endpoint + "/" + quote(name, safe=""))
                    expected.discard(name)

                _, after = transport.item(row["number"])
                if set(after) != expected or any(name not in after for name in row["add"]) or any(name in after for name in row["remove"]):
                    raise ValueError("GitHub did not report the requested label state after the write")
            except ValueError as error:
                record_outcome({"key": key, "status": "uncertain", "reason": str(error), "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "uncertain", "reason": str(error)})
                break

            managed = [name for name in dict.fromkeys([*prior.get("managed", []), *row["add"]]) if name not in row["remove"]]
            saved["items"][key] = {"last_labels": after, "managed": managed, "pending": False, "checked_order": saved["next_order"]}
            save_json(STATE_PATH, saved)
            record_outcome({"key": key, "status": "written", "before": live_labels, "after": after, "managed": managed, "preview_sha256": args.preview_sha256})
            outcomes.append({"key": key, "status": "written", "before": live_labels, "after": after})

        print(json.dumps({"repository": REPO, "requests": transport.used, "outcomes": outcomes}, indent=2, ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["status", "enable", "disable", "preview", "run", "reset-item"])
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--kind", choices=["issue", "pr"])
    parser.add_argument("--number", type=int)
    parser.add_argument("--key", action="append", default=[], help="with preview/run: restrict the pass to KIND:NUMBER (repeatable)")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--request-budget", type=int, default=100)
    parser.add_argument("--apply", action="store_true", help="commit a previewed enable/disable change")
    parser.add_argument("--preview-sha256", help="exact preview hash required for a write")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        parser.error("configured repository changed; reopen Settings")

    if not 1 <= args.limit <= 50 or not 1 <= args.request_budget <= 500:
        parser.error("limit must be 1–50 and request budget 1–500")

    if args.key and args.command not in ("preview", "run"):
        parser.error("--key is only for preview and run")

    if len(set(args.key)) != len(args.key) or any(parse_key(key) is None for key in args.key):
        parser.error("--key requires distinct KIND:NUMBER values")

    if len(args.key) > args.limit:
        parser.error("selected keys exceed --limit")

    args.keys = tuple(sorted(args.key))
    if args.command == "reset-item" and (args.kind is None or args.number is None or args.number <= 0):
        parser.error("reset-item requires --kind and a positive --number")

    if args.command != "reset-item" and (args.kind is not None or args.number is not None):
        parser.error("--kind and --number are only for reset-item")

    if args.command == "status" and (args.apply or args.preview_sha256):
        parser.error("status never writes or accepts a preview hash")

    if args.command in ("enable", "disable") and args.apply != (args.preview_sha256 is not None):
        parser.error("--apply requires --preview-sha256, and a preview hash requires --apply")

    try:
        if args.command == "status":
            print(json.dumps(status(), indent=2, ensure_ascii=False))
        elif args.command in ("enable", "disable"):
            plan = policy_plan(args.command == "enable")
            if not args.apply:
                print(json.dumps(plan, indent=2, ensure_ascii=False))
            else:
                if args.preview_sha256 != plan["preview_sha256"]:
                    fail(parser, "Settings policy changed; preview it again")

                with locked(POLICY_PATH):
                    if policy_plan(args.command == "enable")["preview_sha256"] != args.preview_sha256:
                        fail(parser, "Settings policy changed; preview it again")

                    value = policy()
                    value["repositories"][REPO] = {"enabled": args.command == "enable", "updated_at": now_iso()}
                    save_json(POLICY_PATH, value)

                print(json.dumps(status(), indent=2, ensure_ascii=False))
        elif args.command == "preview":
            if args.apply or args.preview_sha256:
                parser.error("preview never writes")

            transport = Transport(args.request_budget)
            print(json.dumps(build_plan(state(), args.limit, transport, args.keys), indent=2, ensure_ascii=False))
        elif args.command == "reset-item":
            if not args.apply:
                print(json.dumps(reset_plan(state(), args.kind, args.number, Transport(args.request_budget)), indent=2, ensure_ascii=False))
            else:
                if not args.preview_sha256:
                    parser.error("reset-item --apply requires --preview-sha256")

                with locked(PASS_LOCK):
                    saved = state()
                    plan = reset_plan(saved, args.kind, args.number, Transport(args.request_budget))
                    if plan["preview_sha256"] != args.preview_sha256:
                        fail(parser, "item-label state or GitHub labels changed; preview reset-item again")

                    saved["items"][plan["key"]] = plan["after"]
                    save_json(STATE_PATH, saved)
                    record_outcome({"key": plan["key"], "status": "reset-by-human", "labels": plan["current_labels"], "preview_sha256": args.preview_sha256})

                print(json.dumps({"repository": REPO, "reset": plan["key"]}))
        else:
            if args.apply or not args.preview_sha256:
                parser.error("run requires --preview-sha256 and no --apply")

            run_pass(parser, args)
    except (OSError, ValueError, KeyError, TypeError) as error:
        fail(parser, str(error))


if __name__ == "__main__":
    main()
