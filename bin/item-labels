#!/usr/bin/env python3
"""Preview and run bounded GitHub labeling passes, or publish one explicitly confirmed maintainer label selection with edit."""

import argparse
import json
import os
import subprocess
import sys
import uuid
from pathlib import Path
from urllib.parse import quote

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _evidence import repository, value_digest
from _storage import atomic_writer, locked
from _triage import CONFIG_DIR, DATA_DIR, LEDGER_PATH, REPO, load_ledger, load_taxonomy, now_iso, observed_catalog, parse_key, save_ledger


POLICY_PATH = CONFIG_DIR / "label-application.json"
STATE_PATH = DATA_DIR / "local" / "item-labels-state.json"
OUTCOMES_PATH = DATA_DIR / "local" / "item-labels-outcomes.jsonl"
PASS_LOCK = DATA_DIR / "item-labels"


def fail(parser, message):
    parser.exit(1, f"error: {message}\n")


def read_json(path, fallback):
    if not path.exists():
        return fallback

    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")

    return value


def save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)

    with atomic_writer(path) as out:
        out.write(json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def policy():
    value = read_json(POLICY_PATH, {"version": 1, "repositories": {}})
    if value.get("version") != 1 or not isinstance(value.get("repositories"), dict):
        raise ValueError("label-application policy is malformed")

    for repo, setting in value["repositories"].items():
        if not isinstance(repo, str) or not isinstance(setting, dict) or type(setting.get("enabled")) is not bool:
            raise ValueError("label-application repository setting is malformed")

    return value


def enabled():
    return policy()["repositories"].get(REPO, {}).get("enabled", True) is True


class LabelIdentityChanged(ValueError):
    pass


def label_pairs(value):
    if not isinstance(value, list) or any(not isinstance(row, dict) or type(row.get("id")) is not int or row["id"] <= 0 or not isinstance(row.get("name"), str) or not row["name"] for row in value):
        raise ValueError("label identities must contain positive IDs and nonempty names")

    if len({row["id"] for row in value}) != len(value) or len({row["name"].casefold() for row in value}) != len(value):
        raise ValueError("label identities must have distinct IDs and names")

    return sorted(({"id": row["id"], "name": row["name"]} for row in value), key=lambda row: row["name"])


def label_names(value):
    return [row["name"] for row in value]


def state():
    value = read_json(STATE_PATH, {"version": 2, "repository": REPO, "items": {}, "next_order": 0})
    if value.get("version") != 2 or value.get("repository") != REPO or not isinstance(value.get("items"), dict) or type(value.get("next_order", 0)) is not int or value.get("next_order", 0) < 0:
        raise ValueError("item-label state is malformed or belongs to another repository")

    for key, row in value["items"].items():
        if parse_key(key) is None or not isinstance(row, dict):
            raise ValueError("item-label state has an invalid item identity")

        for field in ("last_labels", "managed"):
            if label_pairs(row.get(field, [])) != row.get(field, []):
                raise ValueError(f"item-label state has invalid {field} for {key}")

        if any(label not in row.get("last_labels", []) for label in row.get("managed", [])):
            raise ValueError(f"item-label state has managed labels absent from its observation for {key}")

        if type(row.get("pending", False)) is not bool or type(row.get("paused", False)) is not bool:
            raise ValueError(f"item-label state has invalid control flags for {key}")

        if "checked_order" in row and (type(row["checked_order"]) is not int or row["checked_order"] < 1 or row["checked_order"] > value.get("next_order", 0)):
            raise ValueError(f"item-label state has an invalid checked order for {key}")

    return value


def status():
    saved = state()
    return {"repository": REPO, "enabled": enabled(), "tracked_items": len(saved["items"]),
            "pending_items": [key for key, row in saved["items"].items() if row.get("pending")],
            "paused_items": [key for key, row in saved["items"].items() if row.get("paused")]}


def policy_plan(enable):
    before = enabled()
    plan = {"repository": REPO, "operation": "enable" if enable else "disable", "before": before, "after": enable}
    plan["preview_sha256"] = value_digest(plan)
    return plan


def reset_plan(saved, kind, number, transport):
    key = f"{kind}:{number}"
    prior = saved["items"].get(key)
    if not isinstance(prior, dict):
        raise ValueError(f"no saved item-label state for {key}")

    live_state, live_labels = transport.item(number)
    plan = {"repository": REPO, "host": transport.host, "operation": "reset-item", "key": key, "before": prior,
            "current_state": live_state, "current_labels": live_labels,
            "after": {"last_labels": live_labels, "managed": [], "pending": False, "paused": False}}
    plan["preview_sha256"] = value_digest(plan)
    return plan


class Transport:
    def __init__(self, budget, host):
        self.budget = budget
        self.used = 0
        self.host = host

    def api(self, method, endpoint, body=None):
        if self.used >= self.budget:
            raise ValueError("GitHub request budget exhausted")

        self.used += 1

        command = ["gh", "api", "--hostname", self.host, "--method", method, endpoint]
        if body is not None:
            command += ["--input", "-"]

        try:
            result = subprocess.run(command, input=json.dumps(body) if body is not None else None,
                                    capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ValueError(f"GitHub {method} may have been attempted for {endpoint}: {error}") from error

        if result.returncode:
            raise ValueError(f"GitHub {method} failed for {endpoint}: {result.stderr.strip() or 'gh api failed'}")

        if not result.stdout.strip():
            return None

        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ValueError(f"invalid GitHub response for {endpoint}: {error}") from error

    def item(self, number):
        value = self.api("GET", f"repos/{REPO}/issues/{number}")
        # The selected host answers for this item only when GitHub reports it at that host's repository URL.
        if not isinstance(value, dict) or value.get("number") != number or not str(value.get("html_url", "")).startswith(f"https://{self.host}/{REPO}/") or value.get("state") not in ("open", "closed") or not isinstance(value.get("labels"), list):
            raise ValueError(f"invalid GitHub item #{number} response")

        return value["state"], label_pairs(value["labels"])

    def validate_labels(self, labels):
        for label in labels:
            value = self.api("GET", f"repos/{REPO}/labels/{quote(label['name'], safe='')}")
            if label_pairs([value]) != [label]:
                raise LabelIdentityChanged(f"GitHub label identity changed for {label['name']!r}; sync Labels and preview again")


def decision_digest(row):
    return value_digest({key: row.get(key) for key in ("kind", "number", "state", "proposed_labels")})


def candidates(saved, limit, selected_keys=()):
    def priority(row):
        key = f"{row['kind']}:{row['number']}"
        checked = saved["items"].get(key, {}).get("checked_order", 0)

        return (checked > 0, checked, bool(row.get("labels")), row["kind"], row["number"])

    rows = load_ledger()
    rows.sort(key=priority)
    chosen = []
    selected = set(selected_keys)

    for row in rows:
        key = f"{row['kind']}:{row['number']}"
        if selected and key not in selected:
            continue

        prior = saved["items"].get(key, {})
        if row.get("state") != "open":
            continue

        if row.get("proposed_labels") or prior.get("managed") or prior.get("pending"):
            chosen.append((key, row))

        if len(chosen) >= limit:
            break

    if selected and set(selected_keys) != {key for key, _ in chosen}:
        raise ValueError(f"selected items have no eligible label proposal: {sorted(selected - {key for key, _ in chosen})}")

    return chosen


def mark_checked(saved, key, row):
    saved["next_order"] = saved.get("next_order", 0) + 1
    saved["items"][key] = {**row, "checked_order": saved["next_order"]}
    save_json(STATE_PATH, saved)


def build_plan(saved, limit, transport, selected_keys=()):
    catalog = observed_catalog(load_taxonomy())
    if catalog is None:
        raise ValueError("this repository's label catalog is pending; sync Labels first")

    definitions = catalog["labels"]
    identities = {row["name"]: row for row in label_pairs(definitions)}
    names = set(identities)

    rows = []

    for key, decision in candidates(saved, limit, selected_keys):
        desired = decision.get("proposed_labels") or []
        prior = saved["items"].get(key, {})
        item = {"kind": decision["kind"], "number": decision["number"], "decision_sha256": decision_digest(decision),
                "desired": desired, "managed_before": prior.get("managed", []), "status": "ready"}
        if not isinstance(desired, list) or any(not isinstance(name, str) or name not in names for name in desired) or len(desired) != len(set(desired)):
            item["status"] = "stale-proposal"
        elif prior.get("pending"):
            item["status"] = "uncertain-write"
        elif prior.get("paused"):
            item["status"] = "paused-after-correction"

        if item["status"] == "ready":
            bindings = label_pairs([identities[name] for name in desired])
            for label in prior.get("managed", []):
                if label not in bindings:
                    bindings.append(label)

            item["label_bindings"] = label_pairs(bindings)
            live_state, live_labels = transport.item(decision["number"])
            item["observed_state"], item["observed_labels"] = live_state, live_labels
            if live_state != decision["state"]:
                item["status"] = "changed-state"
            elif "last_labels" in prior and live_labels != prior["last_labels"]:
                item["status"] = "human-correction"
            else:
                transport.validate_labels(item["label_bindings"])
                item["add"] = [name for name in desired if name not in label_names(live_labels)]
                item["remove"] = [label["name"] for label in prior.get("managed", []) if label["name"] not in desired and label in live_labels]
                if not item["add"] and not item["remove"]:
                    item["status"] = "no-change"

        rows.append(item)

    plan = {"repository": REPO, "host": transport.host, "enabled": enabled(), "limit": limit, "request_budget": transport.budget, "requests": transport.used,
            "selected_keys": list(selected_keys), "items": rows}
    plan["preview_sha256"] = value_digest(plan)
    return plan


def record_outcome(row):
    OUTCOMES_PATH.parent.mkdir(parents=True, exist_ok=True)

    with OUTCOMES_PATH.open("a", encoding="utf-8") as out:
        out.write(json.dumps({"repository": REPO, "at": now_iso(), **row}, ensure_ascii=False) + "\n")
        out.flush()
        os.fsync(out.fileno())


def edit_names(value):
    names = json.loads(value)
    if not isinstance(names, list) or any(not isinstance(name, str) or not name for name in names) or len(set(names)) != len(names):
        raise ValueError("label selections must be JSON arrays of distinct label names")

    return sorted(names)


def edit_plan(args):
    identity = repository(REPO, host=args.host)
    desired, expected = edit_names(args.labels), edit_names(args.expected_labels)
    proposed = edit_names(args.expected_proposals)
    catalog = observed_catalog(load_taxonomy())
    if catalog is None:
        raise ValueError("sync the repository label catalog before editing labels")

    identities = {row["name"]: row for row in label_pairs(catalog["labels"])}
    missing = (set(desired) | set(expected)) - identities.keys()
    if missing:
        raise ValueError(f"labels are absent from the catalog; sync Labels first: {sorted(missing)}")

    request_id = args.request_id or uuid.uuid4().hex
    if len(request_id) > 80 or not request_id or any(char not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for char in request_id):
        raise ValueError("invalid label-edit request ID")

    plan = dict(repository=identity, operation="edit-labels", kind=args.kind, number=args.number,
                expected_state=args.expected_state, expected_labels=[identities[name] for name in expected],
                labels=[identities[name] for name in desired], expected_proposals=proposed,
                by=args.by, batch_id=args.batch_id, request_id=request_id)
    return dict(plan=plan, approval=value_digest(plan))


def publish_edit(args, preview):
    plan, approval = preview["plan"], preview["approval"]
    if not args.request_id or args.approve != approval:
        raise ValueError("publication requires approval of the exact label selection and request ID")

    key = f"{args.kind}:{args.number}"
    receipt_path = DATA_DIR / "local" / "item-label-edits" / f"{args.request_id}.json"
    with locked(PASS_LOCK):
        receipt = read_json(receipt_path, {})
        if receipt:
            if receipt.get("approval") != approval:
                raise ValueError("this label-edit request ID belongs to another selection")
            if receipt.get("status") != "succeeded":
                raise ValueError("this label edit has an uncertain outcome; inspect GitHub before another attempt")

            return receipt

        saved = state()
        prior = saved["items"].get(key, {})
        if prior.get("pending"):
            raise ValueError("an earlier label write is uncertain; inspect GitHub and reset this item before editing")

        row = next((row for row in load_ledger() if (row["kind"], row["number"]) == (args.kind, args.number)), None)
        if row is None or sorted(row.get("proposed_labels") or []) != plan["expected_proposals"]:
            raise ValueError("the local label suggestion changed; reopen the item before confirming")

        transport = Transport(args.request_budget, args.host)
        endpoint = f"repos/{REPO}/issues/{args.number}"

        def read_item():
            item = transport.api("GET", endpoint)
            path = "pull" if args.kind == "pr" else "issues"
            if not isinstance(item, dict) or item.get("number") != args.number or item.get("html_url") != f"https://{args.host}/{REPO}/{path}/{args.number}" or ("pull_request" in item) != (args.kind == "pr") or item.get("state") != args.expected_state:
                raise ValueError("the GitHub item identity or state changed; refresh before editing labels")

            return label_pairs(item.get("labels"))

        before = read_item()
        if before != plan["expected_labels"]:
            raise ValueError("GitHub labels changed; refresh before confirming the selection")

        bindings = label_pairs(list({label["name"]: label for label in [*plan["expected_labels"], *plan["labels"]]}.values()))
        if transport.used + len(bindings) + 3 > transport.budget:
            raise ValueError("request budget cannot cover label identity checks, publication and verification")

        transport.validate_labels(bindings)
        if read_item() != before:
            raise ValueError("GitHub labels changed while checking the selection; refresh before confirming")

        receipt = dict(approval=approval, plan=plan, status="attempting", at=now_iso())
        save_json(receipt_path, receipt)
        # Ownership survives only for labels still on GitHub, so the pending record stays valid for status and reset-item if this write fails.
        mark_checked(saved, key, {**prior, "last_labels": before, "managed": [label for label in prior.get("managed", []) if label in before], "pending": True})
        record_outcome(dict(key=key, status="attempting", operation="edit-labels", request_id=args.request_id))

        try:
            if before != plan["labels"]:
                transport.api("PUT", endpoint + "/labels", {"labels": [label["name"] for label in plan["labels"]]})

            after = read_item()
            if after != plan["labels"]:
                raise ValueError("GitHub did not report the confirmed label selection")

            with locked(LEDGER_PATH):
                ledger = load_ledger()
                row = next(row for row in ledger if (row["kind"], row["number"]) == (args.kind, args.number))
                row["labels"] = [label["name"] for label in after]
                if sorted(row.get("proposed_labels") or []) == plan["expected_proposals"]:
                    row["proposed_labels"] = []

                row.update(labels_reviewed=True, triaged_at=now_iso(), triaged_by=args.by, batch_id=args.batch_id)
                save_ledger(ledger)

            # A maintainer's confirmed set releases earlier automatic label ownership. Corrections to an already tracked set keep the agent pass paused; explicit maintainer edits remain available.
            corrected = bool(prior.get("paused") or "last_labels" in prior and (prior["last_labels"] != before or before != after))
            receipt.update(status="succeeded", labels=[label["name"] for label in after])
            save_json(receipt_path, receipt)
            mark_checked(saved, key, {"last_labels": after, "managed": [], "pending": False, "paused": corrected})
            record_outcome(dict(key=key, status="written", operation="edit-labels", request_id=args.request_id, before=before, after=after))
        except (OSError, ValueError, KeyError, StopIteration) as error:
            record_outcome(dict(key=key, status="uncertain", operation="edit-labels", request_id=args.request_id, reason=str(error)))
            raise ValueError(f"label edit may have been published; inspect GitHub before retrying: {error}") from error

        return receipt


def run_pass(parser, args):
    with locked(PASS_LOCK):
        saved = state()
        transport = Transport(args.request_budget, args.host)
        plan = build_plan(saved, args.limit, transport, args.keys)
        if plan["preview_sha256"] != args.preview_sha256:
            fail(parser, "the selected decisions or GitHub labels changed; preview the pass again")

        if not enabled():
            fail(parser, "Labeling is OFF for this repository in Settings → Automations")

        remaining = sum(2 + (2 + len(row.get("label_bindings", []))) * bool(row.get("add")) + 3 * len(row.get("remove", [])) for row in plan["items"] if row["status"] in ("ready", "no-change"))
        if transport.used + remaining > transport.budget:
            fail(parser, "request budget cannot cover revalidation and outcomes for this preview")

        outcomes = []

        for row in plan["items"]:
            key = f"{row['kind']}:{row['number']}"
            if row["status"] not in ("ready", "no-change"):
                prior = saved["items"].get(key, {})
                if row["status"] == "human-correction":
                    prior = {**prior, "paused": True}

                mark_checked(saved, key, prior)
                record_outcome({"key": key, "status": row["status"], "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": row["status"]})
                continue

            fresh = next((item for item in load_ledger() if item.get("kind") == row["kind"] and item.get("number") == row["number"]), None)
            if fresh is None or decision_digest(fresh) != row["decision_sha256"]:
                mark_checked(saved, key, saved["items"].get(key, {}))
                record_outcome({"key": key, "status": "changed-decision", "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "changed-decision"})
                continue

            live_state, live_labels = transport.item(row["number"])
            if live_state != row.get("observed_state") or live_labels != row.get("observed_labels", []):
                mark_checked(saved, key, saved["items"].get(key, {}))
                record_outcome({"key": key, "status": "changed-on-github", "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "changed-on-github"})
                continue

            prior = saved["items"].get(key, {})
            if row["status"] == "no-change":
                mark_checked(saved, key, {"last_labels": live_labels, "managed": prior.get("managed", []), "pending": False})
                record_outcome({"key": key, "status": "no-change", "labels": live_labels, "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": "no-change"})
                continue

            endpoint = f"repos/{REPO}/issues/{row['number']}/labels"
            attempted = False

            def begin_write():
                nonlocal attempted
                if attempted:
                    return

                mark_checked(saved, key, {"last_labels": live_labels, "managed": prior.get("managed", []), "pending": True,
                                          "attempt": {"add": row["add"], "remove": row["remove"], "label_bindings": row["label_bindings"], "preview_sha256": args.preview_sha256}})
                record_outcome({"key": key, "status": "attempting", "add": row["add"], "remove": row["remove"], "label_bindings": row["label_bindings"], "preview_sha256": args.preview_sha256})
                attempted = True

            try:
                expected = live_labels
                if row["add"]:
                    transport.validate_labels(row["label_bindings"])
                    begin_write()
                    transport.api("POST", endpoint, {"labels": row["add"]})
                    _, added_state = transport.item(row["number"])
                    additions = [label for label in row["label_bindings"] if label["name"] in row["add"]]
                    if added_state != label_pairs([*expected, *additions]):
                        raise ValueError("GitHub label state changed during addition")

                    expected = added_state

                for name in row["remove"]:
                    _, before_remove = transport.item(row["number"])
                    if before_remove != expected:
                        raise ValueError("GitHub labels changed before removal")

                    transport.validate_labels([label for label in row["label_bindings"] if label["name"] == name])
                    begin_write()
                    transport.api("DELETE", endpoint + "/" + quote(name, safe=""))
                    expected = [label for label in expected if label["name"] != name]

                _, after = transport.item(row["number"])
                if after != expected:
                    raise ValueError("GitHub did not report the requested label state after the write")
            except ValueError as error:
                if attempted:
                    outcome = "uncertain"
                elif isinstance(error, LabelIdentityChanged):
                    outcome = "changed-catalog"
                else:
                    outcome = "pre-write-stopped"

                if not attempted:
                    mark_checked(saved, key, prior)

                record_outcome({"key": key, "status": outcome, "reason": str(error), "preview_sha256": args.preview_sha256})
                outcomes.append({"key": key, "status": outcome, "reason": str(error)})
                break

            added = [label for label in row["label_bindings"] if label["name"] in row["add"]]
            managed = label_pairs([label for label in [*prior.get("managed", []), *added] if label["name"] not in row["remove"]])
            saved["items"][key] = {"last_labels": after, "managed": managed, "pending": False, "checked_order": saved["next_order"]}
            save_json(STATE_PATH, saved)
            record_outcome({"key": key, "status": "written", "before": live_labels, "after": after, "managed": managed, "preview_sha256": args.preview_sha256})
            outcomes.append({"key": key, "status": "written", "before": live_labels, "after": after})

        print(json.dumps({"repository": REPO, "requests": transport.used, "outcomes": outcomes}, indent=2, ensure_ascii=False))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["status", "enable", "disable", "preview", "run", "reset-item", "edit"])
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--kind", choices=["issue", "pr"])
    parser.add_argument("--number", type=int)
    parser.add_argument("--key", action="append", default=[], help="with preview/run: restrict the pass to KIND:NUMBER (repeatable)")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--request-budget", type=int, default=100)
    parser.add_argument("--apply", action="store_true", help="commit a previewed enable/disable change")
    parser.add_argument("--preview-sha256", help="exact preview hash required for a write")
    parser.add_argument("--labels", help="edit: exact selected names as a JSON array")
    parser.add_argument("--expected-labels", help="edit: displayed GitHub names as a JSON array")
    parser.add_argument("--expected-proposals", default="[]", help="edit: displayed local suggestion as a JSON array")
    parser.add_argument("--expected-state", choices=["open", "closed"], default="open")
    parser.add_argument("--host", default="github.com")
    parser.add_argument("--by", default="human")
    parser.add_argument("--batch-id", default="tui")
    parser.add_argument("--publish", action="store_true", help="edit: publish an explicitly approved selection")
    parser.add_argument("--request-id")
    parser.add_argument("--approve")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        parser.error("configured repository changed; reopen Settings")

    if not 1 <= args.limit <= 50 or not 1 <= args.request_budget <= 500:
        parser.error("limit must be 1–50 and request budget 1–500")

    if args.key and args.command not in ("preview", "run"):
        parser.error("--key is only for preview and run")

    if len(set(args.key)) != len(args.key) or any(parse_key(key) is None for key in args.key):
        parser.error("--key requires distinct KIND:NUMBER values")

    if len(args.key) > args.limit:
        parser.error("selected keys exceed --limit")

    args.keys = tuple(sorted(args.key))
    if args.command == "reset-item" and (args.kind is None or args.number is None or args.number <= 0):
        parser.error("reset-item requires --kind and a positive --number")

    if args.command not in ("reset-item", "edit") and (args.kind is not None or args.number is not None):
        parser.error("--kind and --number are only for reset-item and edit")

    if args.command == "edit" and (args.kind is None or args.number is None or args.number <= 0 or args.labels is None or args.expected_labels is None or args.apply or args.preview_sha256):
        parser.error("edit requires --kind, a positive --number, --labels and --expected-labels; use --publish with --request-id and --approve to write")

    if args.command != "edit" and (args.publish or args.approve or args.request_id or args.labels is not None or args.expected_labels is not None):
        parser.error("label selections and publication flags are only for edit")

    if args.command == "edit" and not args.publish and args.approve:
        parser.error("--approve requires --publish")

    if args.command == "status" and (args.apply or args.preview_sha256):
        parser.error("status never writes or accepts a preview hash")

    if args.command in ("enable", "disable") and args.apply != (args.preview_sha256 is not None):
        parser.error("--apply requires --preview-sha256, and a preview hash requires --apply")

    try:
        if args.command == "edit":
            preview = edit_plan(args)
            print(json.dumps(publish_edit(args, preview) if args.publish else preview, indent=2, ensure_ascii=False))
        elif args.command == "status":
            print(json.dumps(status(), indent=2, ensure_ascii=False))
        elif args.command in ("enable", "disable"):
            plan = policy_plan(args.command == "enable")
            if not args.apply:
                print(json.dumps(plan, indent=2, ensure_ascii=False))
            else:
                if args.preview_sha256 != plan["preview_sha256"]:
                    fail(parser, "Settings policy changed; preview it again")

                with locked(POLICY_PATH):
                    if policy_plan(args.command == "enable")["preview_sha256"] != args.preview_sha256:
                        fail(parser, "Settings policy changed; preview it again")

                    value = policy()
                    value["repositories"][REPO] = {"enabled": args.command == "enable", "updated_at": now_iso()}
                    save_json(POLICY_PATH, value)

                print(json.dumps(status(), indent=2, ensure_ascii=False))
        elif args.command == "preview":
            if args.apply or args.preview_sha256:
                parser.error("preview never writes")

            transport = Transport(args.request_budget, args.host)
            print(json.dumps(build_plan(state(), args.limit, transport, args.keys), indent=2, ensure_ascii=False))
        elif args.command == "reset-item":
            if not args.apply:
                print(json.dumps(reset_plan(state(), args.kind, args.number, Transport(args.request_budget, args.host)), indent=2, ensure_ascii=False))
            else:
                if not args.preview_sha256:
                    parser.error("reset-item --apply requires --preview-sha256")

                with locked(PASS_LOCK):
                    saved = state()
                    plan = reset_plan(saved, args.kind, args.number, Transport(args.request_budget, args.host))
                    if plan["preview_sha256"] != args.preview_sha256:
                        fail(parser, "item-label state or GitHub labels changed; preview reset-item again")

                    saved["items"][plan["key"]] = plan["after"]
                    save_json(STATE_PATH, saved)
                    record_outcome({"key": plan["key"], "status": "reset-by-human", "labels": plan["current_labels"], "preview_sha256": args.preview_sha256})

                print(json.dumps({"repository": REPO, "reset": plan["key"]}))
        else:
            if args.apply or not args.preview_sha256:
                parser.error("run requires --preview-sha256 and no --apply")

            run_pass(parser, args)
    except (OSError, ValueError, KeyError, TypeError) as error:
        fail(parser, str(error))


if __name__ == "__main__":
    main()
