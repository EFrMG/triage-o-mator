#!/usr/bin/env python3
"""Record a source-bound 0–5 quality/readiness assessment without changing triage or approval."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _assessment_evidence import selected_item
from _cache import EvidenceCache
from _evidence import repository, validate_payload
from _storage import locked
from _triage import LEDGER_PATH, REPO, SCORE_RUBRIC, current_score, load_ledger, now_iso, save_ledger, score_assessment_current


DIMENSIONS = {
    "issue": (("clarity", 2), ("support", 2), ("actionability", 1)),
    "pr": (("correctness", 2), ("safeguards", 2), ("reviewability", 1)),
}


def parser():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--expected-repo", required=True)
    commands = ap.add_subparsers(dest="command", required=True)
    for name in ("show", "set"):
        command = commands.add_parser(name)
        command.add_argument("--kind", choices=("issue", "pr"), required=True)
        command.add_argument("--number", type=int, required=True)

    setting = commands.choices["set"]
    setting.add_argument("--snapshot")
    setting.add_argument("--host", default="github.com")
    setting.add_argument("--unassessed", action="store_true", help="record a gap instead of a number; --snapshot may pin incomplete evidence")
    for dimensions in DIMENSIONS.values():
        for name, _ in dimensions:
            setting.add_argument("--" + name, type=int)
    setting.add_argument("--reason", required=True, help="rubric explanation or evidence gap (max 500 characters)")
    setting.add_argument("--suggestion", default="", help="one next check or decision (max 250 characters)")
    setting.add_argument("--by", required=True)
    return ap


def selected_record(kind, number, snapshot, host):
    cache = EvidenceCache(repository(REPO, host=host))
    manifest = cache.load_manifest(snapshot)
    record = next((row for row in manifest["items"] if (row["identity"]["kind"], row["identity"]["number"]) == (kind, number)), None)
    if record is None:
        raise ValueError(f"{kind} #{number} is not in selected snapshot")

    # Verify only the scored item's payloads; a corpus snapshot can hold thousands of other items.
    for name, component in record["components"].items():
        if component["object"] is not None:
            validate_payload(name, component, kind, cache.read_object(component["object"]))

    required = ("summary",) if kind == "issue" else ("summary", "files", "diff")
    missing = [name for name in required if (record["components"].get(name) or {}).get("status") != "complete"]
    if missing:
        raise ValueError("cannot assign a number without complete " + ", ".join(missing))

    if kind == "issue":
        summary = json.loads(cache.read_object(record["components"]["summary"]["object"]))
        if not (summary.get("body") or "").strip():
            raise ValueError("issue body is missing; record unassessed")
    elif not cache.read_object(record["components"]["diff"]["object"]).strip():
        raise ValueError("PR diff is empty; record unassessed")

    return record, manifest["repository"]


def dimensions_for(args):
    expected = DIMENSIONS[args.kind]
    other = DIMENSIONS["pr" if args.kind == "issue" else "issue"]
    if any(getattr(args, name) is not None for name, _ in other):
        raise ValueError("dimensions do not match item kind")

    values = {}
    for name, maximum in expected:
        value = getattr(args, name)
        if value is None or value < 0 or value > maximum:
            raise ValueError(f"--{name} must be between 0 and {maximum}")

        values[name] = value

    if args.kind == "pr" and values["correctness"] == 0 and sum(values.values()) > 2:
        raise ValueError("a PR with a central correctness defect cannot score above 2")

    return values


def validate_dimension_reason(kind, dimensions, reason):
    markers = [(name.capitalize(), f"{name.capitalize()} {dimensions[name]}:") for name, _ in DIMENSIONS[kind]]
    positions = []
    cursor = 0
    for label, marker in markers:
        position = reason.casefold().find(marker.casefold(), cursor)
        if position < 0 or not positions and position != 0:
            raise ValueError(f"numeric reason must start with {markers[0][1]} and explain {label} in rubric order")

        positions.append(position)
        cursor = position + len(marker)

    for index, (label, marker) in enumerate(markers):
        end = positions[index + 1] if index + 1 < len(positions) else len(reason)
        if not reason[positions[index] + len(marker):end].strip():
            raise ValueError(f"numeric reason must explain {label}")


def main():
    args = parser().parse_args()
    if args.expected_repo != REPO:
        sys.exit("error: selected repository changed")
    if args.number < 1:
        sys.exit("error: item number must be positive")

    if args.command == "show":
        row = next((row for row in load_ledger() if (row["kind"], row["number"]) == (args.kind, args.number)), None)
        if row is None:
            sys.exit("error: item is absent from the ledger")

        score = row.get("item_score")
        print(json.dumps(dict(repository=REPO, kind=args.kind, number=args.number, score=score, current=current_score(row) is not None,
                              assessment_current=score_assessment_current(row),
                              ledger_updated_at=row.get("updated_at")), ensure_ascii=False, indent=2))
        return

    if not args.by.strip() or not args.reason.strip():
        sys.exit("error: assessor and reason are required")
    if len(args.reason) > 500 or len(args.suggestion) > 250:
        sys.exit("error: reason or suggestion is too long")

    try:
        if args.unassessed:
            if any(getattr(args, name) is not None for dimensions in DIMENSIONS.values() for name, _ in dimensions):
                raise ValueError("unassessed entries have no numeric dimensions")

            source = selected_item(args.kind, args.number, args.snapshot, host=args.host) if args.snapshot else None

            score = dict(rubric=SCORE_RUBRIC, value=None, dimensions={}, reason=args.reason.strip(), suggestion=args.suggestion.strip(),
                         snapshot_id=args.snapshot, source_repository=source["repository"] if source else None,
                         revision=source["revision"] if source else None, coverage=source["coverage"] if source else {},
                         assessed_at=now_iso(), assessed_by=args.by.strip())
        else:
            if not args.snapshot:
                raise ValueError("a numeric score requires --snapshot")

            dimensions = dimensions_for(args)
            validate_dimension_reason(args.kind, dimensions, args.reason.strip())
            record, source_repository = selected_record(args.kind, args.number, args.snapshot, args.host)
            score = dict(rubric=SCORE_RUBRIC, value=sum(dimensions.values()), dimensions=dimensions, reason=args.reason.strip(),
                         suggestion=args.suggestion.strip(), snapshot_id=args.snapshot, source_repository=source_repository,
                         revision=record["revision"], coverage={name: component["status"] for name, component in record["components"].items()},
                         assessed_at=now_iso(), assessed_by=args.by.strip())

        with locked(LEDGER_PATH):
            ledger = load_ledger()
            row = next((row for row in ledger if (row["kind"], row["number"]) == (args.kind, args.number)), None)
            if row is None:
                raise ValueError("item is absent from the ledger")
            if args.unassessed and not args.snapshot:
                score["revision"] = dict(updated_at=row.get("updated_at"), base_sha=None, head_sha=None)
            if score["revision"] is not None and score["revision"]["updated_at"] != row.get("updated_at"):
                raise ValueError("selected evidence revision differs from the ledger; sync or choose current evidence")

            if args.kind == "issue" and score["revision"] is not None:
                # New comments are what returns an issue to the scoring queue, so the result binds the count it was given at.
                score["revision"] = dict(score["revision"], comments=row.get("comments_count"))

            row["item_score"] = score
            save_ledger(ledger)
    except (ValueError, OSError, KeyError, TypeError) as error:
        sys.exit(f"error: {error}")

    print(json.dumps(dict(repository=REPO, kind=args.kind, number=args.number, score=score), ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
