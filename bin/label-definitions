#!/usr/bin/env python3
"""Preview and explicitly apply GitHub label definition changes for the selected repository."""

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _install import now_iso, read_github_labels, reconcile_label_catalog
from _storage import atomic_writer, locked
from _triage import REPO, TAXONOMY_PATH


NEW_LABEL_COLOR = "ededed"
STARTER_LABELS = [
    {"name": "bug", "description": "Something is not working as expected", "color": "d73a4a"},
    {"name": "enhancement", "description": "A proposed improvement or new capability", "color": "a2eeef"},
    {"name": "documentation", "description": "Documentation needs to be added or improved", "color": "0075ca"},
    {"name": "question", "description": "A request for information or clarification", "color": "d876e3"},
    {"name": "duplicate", "description": "Substantially overlaps another item", "color": "cfd3d7"},
    {"name": "needs-info", "description": "More information is needed to assess this item", "color": "fbca04"},
    {"name": "verified", "description": "The reported result or proposed change has been checked", "color": "0e8a16"},
    {"name": "ready", "description": "Ready for a maintainer decision or next step", "color": "7057ff"},
]


def fail(parser, message):
    parser.exit(1, f"error: {message}\n")


def plan_change(parser, args, labels):
    if args.label_id is None:
        if any(row["name"].casefold() == args.name.casefold() for row in labels):
            fail(parser, "a label with this name already exists; refresh Labels")

        current = None
        proposed = {"name": args.name, "description": args.description, "color": NEW_LABEL_COLOR}
        method, endpoint = "POST", f"repos/{REPO}/labels"
    else:
        matches = [row for row in labels if row["id"] == args.label_id]
        if len(matches) != 1 or matches[0]["name"] != args.expected_name or matches[0]["description"] != args.expected_description:
            fail(parser, "the GitHub label changed; refresh Labels before editing")

        if any(row["id"] != args.label_id and row["name"].casefold() == args.name.casefold() for row in labels):
            fail(parser, "another label already uses this name")

        current = matches[0]
        proposed = {"name": args.name, "description": args.description, "color": current["color"]}
        method, endpoint = "PATCH", f"repos/{REPO}/labels/{quote(current['name'], safe='')}"

    plan = {"repository": REPO, "operation": "create" if current is None else "edit", "method": method,
            "endpoint": endpoint, "current": current, "proposed": proposed}
    plan["preview_sha256"] = plan_hash(plan)
    return plan


def plan_hash(plan):
    encoded = json.dumps(plan, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    return hashlib.sha256(encoded).hexdigest()


def plan_defaults(labels):
    existing = {row["name"].casefold() for row in labels}
    plan = {"repository": REPO, "operation": "initialize-defaults", "current": labels,
            "create": [row for row in STARTER_LABELS if row["name"].casefold() not in existing]}
    plan["preview_sha256"] = plan_hash(plan)
    return plan


def local_catalog(parser):
    try:
        original = TAXONOMY_PATH.read_bytes()
        taxonomy = json.loads(original)
        catalog = taxonomy["label_catalog"]
        rows = catalog["labels"]
        if catalog["repository"] != REPO or catalog["status"] != "observed" or not isinstance(rows, list):
            raise ValueError("the selected repository needs an observed local label catalog")

        ids, names = set(), set()

        for row in rows:
            label_id, name, color, description = row["id"], row["name"], row["color"], row["description"]
            valid_id = type(label_id) is int and label_id > 0
            valid_name = isinstance(name, str) and bool(name) and "\n" not in name and "\x00" not in name
            valid_color = isinstance(color, str) and len(color) == 6 and all(char in "0123456789abcdefABCDEF" for char in color)
            valid_description = isinstance(description, str) and len(description) <= 100 and "\n" not in description and "\x00" not in description
            if not all((valid_id, valid_name, valid_color, valid_description)):
                raise ValueError("invalid saved label definition")

            if label_id in ids or name.casefold() in names:
                raise ValueError("duplicate saved label identity")

            ids.add(label_id)
            names.add(name.casefold())
    except (OSError, KeyError, TypeError, ValueError) as error:
        fail(parser, f"could not use the saved local catalog: {error}")

    return hashlib.sha256(original).hexdigest(), rows


def plan_local(parser, labels):
    local_sha256, desired = local_catalog(parser)
    live_by_id = {row["id"]: row for row in labels}
    live_by_name = {row["name"].casefold(): row for row in labels}
    matched = set()
    create, update = [], []

    for row in desired:
        proposed = {"name": row["name"], "description": row["description"], "color": row["color"].lower()}
        current = live_by_id.get(row["id"]) or live_by_name.get(row["name"].casefold())
        if current is None:
            create.append(proposed)
            continue

        conflict = live_by_name.get(row["name"].casefold())
        if current["id"] in matched or conflict is not None and conflict["id"] != current["id"]:
            fail(parser, f"saved label {row['name']} conflicts with a live GitHub label; resolve the conflicting names before reconciling")

        matched.add(current["id"])
        if any(current[key] != proposed[key] for key in ("name", "description", "color")):
            update.append({"current": current, "proposed": proposed})

    plan = {"repository": REPO, "operation": "reconcile-local", "local_sha256": local_sha256, "current": labels,
            "create": create, "update": update, "delete": [row for row in labels if row["id"] not in matched]}
    plan["preview_sha256"] = plan_hash(plan)
    return plan


def save_catalog(parser, labels, expected_local_sha256=None):
    with locked(TAXONOMY_PATH):
        try:
            original = TAXONOMY_PATH.read_bytes()
            if expected_local_sha256 is not None and hashlib.sha256(original).hexdigest() != expected_local_sha256:
                raise ValueError("saved local catalog changed during the GitHub writes")

            taxonomy = json.loads(original)
            if not isinstance(taxonomy, dict):
                raise ValueError("taxonomy is not a JSON object")

            catalog = taxonomy.get("label_catalog")
            prior_rows = catalog.get("labels", []) if isinstance(catalog, dict) else []
            old_by_name = {row["name"].casefold(): row for row in prior_rows if isinstance(row, dict) and isinstance(row.get("name"), str)}
            reconcile_label_catalog(taxonomy, REPO, labels, now_iso())
            if expected_local_sha256 is not None:
                for row in taxonomy["label_catalog"]["labels"]:
                    old = old_by_name.get(row["name"].casefold())
                    if old is not None:
                        row["guidance"] = old.get("guidance", "")

            with atomic_writer(TAXONOMY_PATH) as out:
                out.write(json.dumps(taxonomy, indent=2, ensure_ascii=False) + "\n")
        except (OSError, ValueError) as error:
            fail(parser, f"GitHub labels may have changed, but local refresh failed: {error}; inspect GitHub and preview again")


def write_label(parser, method, endpoint, body):
    try:
        response = subprocess.run(["gh", "api", "--method", method, endpoint, "--input", "-"],
                                  input=json.dumps(body, ensure_ascii=False), capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(parser, f"GitHub label write may have been attempted: {error}; inspect GitHub and preview again")

    if response.returncode:
        fail(parser, f"GitHub label write failed: {response.stderr.strip() or 'gh api failed'}; inspect GitHub and preview again")

    try:
        written = json.loads(response.stdout)
        if not isinstance(written, dict) or type(written.get("id")) is not int or written["id"] <= 0:
            raise ValueError("unexpected label response")

        return written
    except (ValueError, TypeError, json.JSONDecodeError) as error:
        fail(parser, f"GitHub may have saved the label, but its response was invalid: {error}; inspect GitHub and preview again")


def apply_defaults(parser, plan):
    created = []
    labels = plan["current"]

    for proposed in plan["create"]:
        if any(row["name"].casefold() == proposed["name"].casefold() for row in labels):
            fail(parser, f"{proposed['name']} now exists; preview Initialize defaults again")

        written = write_label(parser, "POST", f"repos/{REPO}/labels", proposed)

        try:
            labels = read_github_labels(REPO)
            if not any(row["id"] == written["id"] and all(row[key] == proposed[key] for key in ("name", "description", "color")) for row in labels):
                raise ValueError(f"{proposed['name']} is absent or changed in the refreshed GitHub list")
        except ValueError as error:
            fail(parser, f"GitHub may have saved {proposed['name']}, but refresh failed: {error}; sync Labels before retrying")

        save_catalog(parser, labels)
        created.append({"id": written["id"], **proposed})

    if not created:
        save_catalog(parser, labels)

    return created


def verify_live_labels(parser, expected):
    try:
        actual = read_github_labels(REPO)
    except ValueError as error:
        fail(parser, f"could not verify live GitHub labels: {error}; inspect GitHub and preview again")

    if actual != sorted(expected, key=lambda row: (row["name"].casefold(), row["id"])):
        fail(parser, "GitHub labels changed during the operation; inspect GitHub and preview again")

    return actual


def delete_label(parser, label):
    endpoint = f"repos/{REPO}/labels/{quote(label['name'], safe='')}"

    try:
        response = subprocess.run(["gh", "api", "--method", "DELETE", endpoint], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(parser, f"GitHub label deletion may have been attempted: {error}; inspect GitHub and preview again")

    if response.returncode:
        fail(parser, f"GitHub label deletion may have failed: {response.stderr.strip() or 'gh api failed'}; inspect GitHub and preview again")


def apply_local(parser, plan):
    expected = plan["current"]
    results = {"created": [], "updated": [], "deleted": []}
    operations = [("update", row) for row in plan["update"]] + [("create", row) for row in plan["create"]] + [("delete", row) for row in plan["delete"]]

    for operation, row in operations:
        try:
            local_sha256 = hashlib.sha256(TAXONOMY_PATH.read_bytes()).hexdigest()
        except OSError as error:
            fail(parser, f"could not recheck the saved local catalog: {error}")

        if local_sha256 != plan["local_sha256"]:
            fail(parser, "saved local catalog changed during the operation; inspect GitHub and preview again")

        verify_live_labels(parser, expected)
        if operation == "update":
            current, proposed = row["current"], row["proposed"]
            endpoint = f"repos/{REPO}/labels/{quote(current['name'], safe='')}"
            written = write_label(parser, "PATCH", endpoint, {"new_name": proposed["name"], "description": proposed["description"], "color": proposed["color"]})
            if written["id"] != current["id"]:
                fail(parser, f"GitHub returned another identity for {current['name']}; inspect GitHub and preview again")

            expected = [{"id": current["id"], **proposed} if item["id"] == current["id"] else item for item in expected]
            results["updated"].append({"id": current["id"], **proposed})
        elif operation == "create":
            written = write_label(parser, "POST", f"repos/{REPO}/labels", row)
            expected = [*expected, {"id": written["id"], **row}]
            results["created"].append({"id": written["id"], **row})
        else:
            delete_label(parser, row)
            expected = [item for item in expected if item["id"] != row["id"]]
            results["deleted"].append(row)

        verify_live_labels(parser, expected)

    verify_live_labels(parser, expected)
    save_catalog(parser, expected, plan["local_sha256"])
    return results


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--name")
    parser.add_argument("--description")
    parser.add_argument("--initialize-defaults", action="store_true", help="preview or create only missing starter labels")
    parser.add_argument("--reconcile-local", action="store_true", help="preview or make GitHub match the saved local label catalog")
    parser.add_argument("--label-id", type=int)
    parser.add_argument("--expected-name")
    parser.add_argument("--expected-description")
    parser.add_argument("--apply", action="store_true", help="write only the previously previewed exact change")
    parser.add_argument("--preview-sha256")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        parser.error("configured repository changed; reopen Settings")

    if args.initialize_defaults and args.reconcile_local:
        parser.error("choose one label batch operation")

    if args.initialize_defaults or args.reconcile_local:
        if any(value is not None for value in (args.name, args.description, args.label_id, args.expected_name, args.expected_description)):
            parser.error("batch label operations do not accept an individual label change")
    else:
        if args.name is None or not args.name.strip() or args.name != args.name.strip() or "\n" in args.name or "\x00" in args.name:
            parser.error("label name must be a nonempty single line")

        if args.description is None or len(args.description) > 100 or "\n" in args.description or "\x00" in args.description:
            parser.error("GitHub label description must be one line and at most 100 characters")

    if args.label_id is not None and (args.label_id <= 0 or args.expected_name is None or args.expected_description is None):
        parser.error("editing requires the displayed label identity, name and description")

    if args.label_id is None and (args.expected_name is not None or args.expected_description is not None):
        parser.error("creating does not accept an existing label identity")

    if args.apply != (args.preview_sha256 is not None):
        parser.error("--apply requires --preview-sha256, and a preview hash requires --apply")

    try:
        labels = read_github_labels(REPO)
    except ValueError as error:
        fail(parser, str(error))

    plan = plan_defaults(labels) if args.initialize_defaults else plan_local(parser, labels) if args.reconcile_local else plan_change(parser, args, labels)
    if not args.apply:
        print(json.dumps(plan, indent=2, ensure_ascii=False))
        return

    if args.preview_sha256 != plan["preview_sha256"]:
        fail(parser, "the label change no longer matches its preview; preview it again")

    if args.initialize_defaults:
        created = apply_defaults(parser, plan)
        print(json.dumps({"created": created, "preview_sha256": plan["preview_sha256"]}, ensure_ascii=False))
        return

    if args.reconcile_local:
        result = apply_local(parser, plan)
        print(json.dumps({**result, "preview_sha256": plan["preview_sha256"]}, ensure_ascii=False))
        return

    body = {"name": args.name, "description": args.description, "color": NEW_LABEL_COLOR}
    if args.label_id is not None:
        body = {"new_name": args.name, "description": args.description}

    written = write_label(parser, plan["method"], plan["endpoint"], body)

    try:
        if written.get("name") != args.name or (written.get("description") or "") != args.description or args.label_id is not None and written["id"] != args.label_id:
            raise ValueError("unexpected label response")

        labels = read_github_labels(REPO)
        if not any(row["id"] == written["id"] and row["name"] == args.name and row["description"] == args.description for row in labels):
            raise ValueError("the written label is not present in the refreshed GitHub list")
    except (ValueError, TypeError, json.JSONDecodeError) as error:
        fail(parser, f"GitHub may have saved the label, but refresh failed: {error}; refresh Labels before retrying")

    save_catalog(parser, labels)

    print(json.dumps({"written": written["id"], "preview_sha256": plan["preview_sha256"]}))


if __name__ == "__main__":
    main()
