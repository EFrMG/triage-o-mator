#!/usr/bin/env python3
"""
Suggest what to do next, from the current local state. Read-only and offline: it never calls GitHub and never writes anything.

Usage:
    bin/next           numbered suggestions, most urgent first
    bin/next --json    the same, machine-readable, for agents

Each suggestion says who should do it: [agent] steps prepare evidence or proposals within the requested scope and may run repository-enabled bounded labeling or action passes; [human] steps need a person for review, Settings changes, or exact write approval. A suggestion is not authorization for an unbounded download or an unconfigured write. It points at the exact command or prompts/<name>.md playbook to follow. This is the answer to "what could be done next?" in AGENTS.md.
"""

import argparse
import json
import sys
from datetime import date, datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))  # absolute, never resolve: see work_root() in bin/_install.py
from _groups import list_groups
from _briefed import ITEM_BRIEF_RE, active_name, briefed_keys, load_records, saved_brief_exists, visible_batch_briefs
from _similar import TitleIndex
from _notdupes import TitleVerdicts
from _triage import here, BATCHES_DIR, DATA_DIR, RAW_DIR, REPO, REPORTS_DIR, action_operation, current_score, has_decision, load_jsonl, load_ledger, load_taxonomy, merge_ready

STALE_FETCH_HOURS = 6
STRONG_PAIR = 0.8
# Proposed labels, besides `ready`, that say a PR's code still needs to be read.
CODE_REVIEW_LABELS = ("trivial", "needs-revision")


def hours_since(iso):
    try:
        then = datetime.strptime(iso, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None

    return (datetime.now(timezone.utc) - then).total_seconds() / 3600


def batch_states(by_key):
    """Each batch's progress: how many proposals are filled in, and how many of those are still waiting to reach the ledger."""
    states = []
    for items_path in sorted(BATCHES_DIR.glob("*.items.jsonl")):
        batch_id = items_path.name[: -len(".items.jsonl")]
        items = load_jsonl(items_path)
        keys = [(r["kind"], r["number"]) for r in items]
        rows = load_jsonl(BATCHES_DIR / f"{batch_id}.decisions.jsonl")
        filled = [r for r in rows if has_decision(r)]
        waiting = [r for r in filled if not has_decision(by_key.get((r["kind"], r["number"])) or {})]
        done = sum(1 for k in keys if has_decision(by_key.get(k) or {}))
        states.append(dict(id=batch_id, items=len(keys), filled=len(filled), waiting=len(waiting), done=done,
                           briefing=bool(items) and all(r.get("briefing_batch") is True for r in items)))

    return states


def suggestions(ledger):
    by_key = {(r["kind"], r["number"]): r for r in ledger}
    open_items = [r for r in ledger if r["state"] == "open"]
    briefed_batches = load_records()
    taxonomy = load_taxonomy()
    covered_keys = briefed_keys(briefed_batches)
    out = []

    def add(who, what, do, why):
        do = here(do)  # pastable from wherever this was run
        out.append(dict(who=who, what=what, do=do, why=why))

    meta_path = RAW_DIR / "fetch_meta.json"
    meta = json.loads(meta_path.read_text()) if meta_path.exists() else {}
    age = hours_since(meta.get("synced_through") or meta.get("fetched_at"))
    if age is None or age > STALE_FETCH_HOURS:
        add("agent", "Refresh the ledger from GitHub", "bin/fetch && bin/sync",
            "never synced" if age is None else f"last sync was {age:.0f}h ago")

    batches = batch_states(by_key)
    for b in batches:
        if b["items"] == 0:
            add("human", f"Delete empty batch {b['id']}", f"bin/batch --delete {b['id']}",
                "no members remain to screen")
        elif b["briefing"]:
            if b["id"] not in briefed_batches:
                add("agent", f"Brief screening batch {b['id']} ({b['items']} items)",
                    f"prompts/maintainer-brief.md (batch {b['id']}; then bin/batch --mark-briefed {b['id']} --brief reports/{REPO}/<date>-batch-{b['id']}-brief.md)",
                    "screen every member and include only warranted calls or issue follow-ups; zero is valid")
            else:
                add("human", f"Delete briefed batch {b['id']}", f"bin/batch --delete {b['id']} (or d d in the TUI's Batches)",
                    "the batch screening checkpoint and brief are saved")
        elif b["filled"] == 0 and b["done"] < b["items"]:
            add("agent", f"Fill in batch {b['id']} ({b['items']} items)", "prompts/auto-triage.md (batch already made: skip creating one)",
                "its decisions file is still blank")
        elif b["waiting"]:
            add("human", f"Check the {b['waiting']} agent proposals in batch {b['id']}",
                f"TUI: Batches -> {b['id']} (review one by one, or A to apply the rest as unreviewed); or bin/apply data/{REPO}/batches/{b['id']}.decisions.jsonl --only-untriaged",
                "proposals only reach the review queue once applied")
        elif b["done"] == b["items"]:
            if b["id"] not in briefed_batches:
                add("agent", f"Brief finished batch {b['id']} ({b['items']} items)",
                    f"prompts/maintainer-brief.md (batch {b['id']}; then bin/batch --mark-briefed {b['id']} --brief reports/{REPO}/<date>-batch-{b['id']}-brief.md)",
                    "screen the whole batch; include warranted calls or issue follow-ups, even if there are none")
            else:
                add("human", f"Delete finished batch {b['id']}", f"bin/batch --delete {b['id']} (or d d in the TUI's Batches)",
                    "every item is in the ledger and the batch has a brief")

    pending = [r for r in open_items if has_decision(r) and not r["reviewed"]]
    if pending:
        closes = sum(1 for r in pending if action_operation(taxonomy, r["action"]) == "close")
        sample = ", ".join(f"{r['kind']} #{r['number']}" for r in pending[:3])
        add("human", f"Review {len(pending)} triaged decisions ({closes} suggest closing)",
            f"TUI: All Items (search {sample}, a confirms a saved call); or bin/export-csv --pending-review, edit, bin/import-csv --by <you>",
            "review remains separate from repository-enabled label automation and action-write approval")
        item_briefs = {match.group(2, 3) for path in REPORTS_DIR.glob("*-brief*") if (match := ITEM_BRIEF_RE.fullmatch(active_name(path.name)))}
        target = next((row for row in pending if (row["kind"], str(row["number"])) not in item_briefs), None)
        if target is not None:
            add("agent", f"Write a detailed brief for {target['kind']} #{target['number']}",
                f"prompts/item-brief.md (selected {target['kind']} #{target['number']})",
                "a focused case can help a maintainer resolve an unreviewed call")

    unreviewed_code = [r for r in open_items if r["kind"] == "pr" and (merge_ready(r) or any(name in CODE_REVIEW_LABELS for name in r.get("proposed_labels") or []))
                       and not r["reviewed"] and not (r.get("agent_notes") or "").strip()]
    if unreviewed_code:
        marked = sum(1 for r in unreviewed_code if merge_ready(r))
        sample = ", ".join(f"#{r['number']}" for r in sorted(unreviewed_code, key=lambda r: not merge_ready(r))[:5])
        add("agent", f"Code-review {len(unreviewed_code)} triaged PRs nobody has read the diff of ({marked} marked ready to merge)",
            f"prompts/review-pr.md (e.g. {sample})", "their code evidence has not been reviewed")

    open_prs = [r for r in open_items if r["kind"] == "pr"]
    if open_prs:
        add("agent", f"Assess a named PR for an explained closure proposal ({len(open_prs)} open PRs available)",
            "prompts/recommend-closure.md (select the PR; reuse cached evidence first)",
            "a scoped recommendation can keep the PR open; a saved proposal needs exact approval before any GitHub write")

    action_candidates = [r for r in ledger if action_operation(taxonomy, r.get("action")) in ("comment", "close", "reopen") and
                         (action_operation(taxonomy, r["action"]) == "reopen" and r["state"] == "closed" or r["state"] == "open")]
    if action_candidates:
        add("agent", f"Prepare a bounded action pass for {len(action_candidates)} suggested item actions",
            "prompts/automated-actions.md (select exact keys; reuse cached evidence first)",
            "each action follows its repository policy; incomplete or disputed cases stay staged")

    # An entry saved as unassessed stays out of the queue; a numeric score re-enters it once its revision is no longer current.
    unscored = [r for r in open_items if not isinstance(r.get("item_score"), dict) or
                r["item_score"].get("value") is not None and current_score(r) is None]
    if unscored:
        add("agent", f"Score a bounded selection of {len(unscored)} new or stale items",
            "prompts/score-items.md (select up to 20 exact item keys and saved snapshots)",
            "quality/readiness scores remain separate from triage confidence, review and GitHub approval")

    pairs = [p for p in TitleVerdicts().pairs(TitleIndex(ledger), min_score=STRONG_PAIR)
             if not has_decision(by_key[(p["item"]["kind"], p["item"]["number"])])]
    if pairs:
        sample = ", ".join(f"#{p['item']['number']}~#{p['original']['number']}" for p in pairs[:3])
        add("agent", f"Check {len(pairs)} near-identical title pairs for duplicates", f"prompts/find-duplicates.md (e.g. {sample})",
            f"titles score {STRONG_PAIR:.0%}+ and the newer item is untriaged")

    groups = list_groups()
    drafts = [g for g in groups if g["status"] == "draft" and g["members"]]
    ready = [g for g in groups if g["status"] == "ready"]
    for g in drafts:
        add("human", f"Finish group \"{g['title']}\" ({len(g['members'])} items) and mark it ready",
            f"TUI: b -> group -> e (status ready); or bin/group update {g['id']} --status ready --by <you>",
            "maintainers only see ready groups at the top of the report")

    for g in ready:
        unsettled = [m for m in g["members"] if not (by_key.get((m["kind"], m["number"])) or {}).get("reviewed")]
        if unsettled:
            add("human", f"Review the {len(unsettled)} unreviewed members of ready group \"{g['title']}\"",
                "TUI: b -> group -> Enter -> open each member", "a ready group reads best when its decisions are confirmed")

    group_brief = REPORTS_DIR / f"{date.today().isoformat()}-ready-groups-brief.md"
    if ready and not saved_brief_exists(group_brief):
        titles = ", ".join(f'"{g["title"]}"' for g in ready[:2])
        add("agent", f"Make the case for {len(ready)} ready group{'' if len(ready) == 1 else 's'}: {titles}", "prompts/maintainer-brief.md (focused brief for ready groups)",
            "the report lists ready groups; it doesn't argue them, and a maintainer has to decide")

    if pairs and not groups:
        add("agent", "Organize related items into review groups for maintainers", "prompts/organize-groups.md",
            "there are duplicate clusters and no groups yet")

    untriaged = [r for r in open_items if not has_decision(r)]
    if open_items:
        add("agent", "Prepare reusable evidence for a focused analysis", "prompts/prepare-analysis.md",
            "optional: inspect existing references offline first; choose a bounded script budget if downloading (cache coverage is not assessed here)")

    unlabeled = [r for r in open_items if not r.get("labels")]
    if unlabeled:
        add("agent", f"Prepare a bounded labeling pass for {len(unlabeled)} open items with no observed labels",
            "prompts/label-items.md (start with bin/batch 25 --unlabeled-first --include-triaged)",
            "the label pass is separate from the suggested Action; GitHub writes require this repository's Item labeling setting")

    if untriaged:
        fresh = [r for r in untriaged if (hours_since(r.get("first_seen_at")) or 1e9) < 24]
        if fresh:
            add("agent", f"Triage {len(fresh)} items first seen in the last 24h", "prompts/auto-triage.md with bin/batch 25 --order newest",
                "keeping up with inflow stops the backlog growing")

        add("agent", f"Triage the backlog ({len(untriaged)} untriaged open items)", "prompts/auto-triage.md with bin/batch 25",
            "oldest first clears the longest-waiting reports")

    unbriefed_open = [r for r in open_items if f"{r['kind']}:{r['number']}" not in covered_keys]
    if unbriefed_open and not any(b["id"] not in briefed_batches for b in batches):
        add("agent", f"Screen the next batch of {len(unbriefed_open)} not-yet-briefed open items",
            "bin/batch 25 --include-triaged --unbriefed --order updated; prompts/maintainer-brief.md",
            "each completed batch gets one concise brief, then its members leave the briefing queue")

    master_brief = REPORTS_DIR / f"{date.today().isoformat()}-master-brief.md"
    batch_briefs = len(visible_batch_briefs())
    if batch_briefs >= 2 and not saved_brief_exists(master_brief):
        add("agent", f"Polish selected batch briefs ({batch_briefs} available)",
            "bin/briefs plan; prompts/polish-briefs.md",
            "surface the most relevant decisions from completed batch passes")

    report = REPORTS_DIR / f"{date.today().isoformat()}.md"
    if not report.exists():
        add("agent", "Write today's maintainer report", "prompts/maintainer-brief.md (runs bin/report)",
            "no report yet today" if any(REPORTS_DIR.glob("*.md")) else "no report yet")

    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args()

    ledger = load_ledger()
    if not ledger:
        items = [dict(who="agent", what="Build the ledger", do=here("bin/fetch && bin/sync"), why="the ledger is empty")]
    else:
        items = suggestions(ledger)

    if any((DATA_DIR / "external-closures").glob("pr-*.json")) or any((DATA_DIR / "cache" / "watches").glob("pr-*.json")):
        items.insert(0, dict(
            who="agent",
            what="Inspect retained closure or watch context for a requested reassessment",
            do=here("prompts/review-appeal.md"),
            why="local record filenames exist; contents and attention status are not audited here; reading does not enroll, acknowledge, resolve or approve",
        ))

    if args.json:
        print(json.dumps(dict(repo=REPO, suggestions=items), ensure_ascii=False, indent=2))

        return

    print(f"Next steps for {REPO}:\n")
    for i, s in enumerate(items, 1):
        print(f"{i}. [{s['who']}] {s['what']}\n   do:  {s['do']}\n   why: {s['why']}")

    if not items:
        print("Nothing pending. Everything triaged is reviewed and every batch is applied.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, TypeError) as error:
        sys.exit(f"error: {error}")
