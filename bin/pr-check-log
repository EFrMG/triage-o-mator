#!/usr/bin/env python3
"""Capture one explicitly selected failed Actions job or read its retained log windows offline."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _acquire import ReadFailure
from _ci_logs import capture, fetch, locate, read
from _triage import REPO


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("capture", "locate", "fetch", "read"))
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--number", type=int, required=True)
    parser.add_argument("--snapshot", required=True)
    parser.add_argument("--host", default="github.com")
    parser.add_argument("--source-repo")
    parser.add_argument("--check-id", type=int)
    parser.add_argument("--run-id", type=int)
    parser.add_argument("--attempt", type=int)
    parser.add_argument("--job-id", type=int)
    parser.add_argument("--request-budget", type=int, default=20)
    parser.add_argument("--max-log-bytes", type=int, default=1048576)
    parser.add_argument("--log-object")
    parser.add_argument("--log-bytes", type=int)
    parser.add_argument("--start-line", type=int)
    parser.add_argument("--max-lines", type=int, default=80)
    args = parser.parse_args()
    if args.expected_repo != REPO:
        parser.error("selected repository changed")

    if args.command == "capture":
        if args.check_id is None or any(value is not None for value in (args.run_id, args.attempt, args.job_id, args.log_object, args.log_bytes)):
            parser.error("capture requires --check-id without a job, attempt or log reference")
        result = capture(args.number, args.snapshot, args.check_id, args.source_repo or REPO, host=args.host, budget=args.request_budget,
                         maximum=args.max_log_bytes, start_line=args.start_line)
    elif args.command == "locate":
        if args.check_id is None or any(value is not None for value in (args.run_id, args.attempt, args.job_id, args.log_object, args.log_bytes, args.start_line)):
            parser.error("locate requires --check-id without a job, attempt or log selection")
        result = locate(args.number, args.snapshot, args.check_id, args.source_repo or REPO, host=args.host, budget=args.request_budget)
    elif args.command == "fetch":
        if any(value is None for value in (args.check_id, args.run_id, args.attempt, args.job_id)) or args.log_object or args.log_bytes:
            parser.error("fetch requires exact check, run, attempt and job IDs, without an offline log reference")
        result = fetch(args.number, args.snapshot, args.check_id, args.source_repo or REPO, args.run_id, args.attempt, args.job_id,
                       host=args.host, budget=args.request_budget, maximum=args.max_log_bytes, start_line=args.start_line)
    else:
        if args.log_object is None or args.log_bytes is None:
            parser.error("read requires --log-object and --log-bytes from an exact saved reference")
        pins = dict(check_id=args.check_id, run_id=args.run_id, attempt=args.attempt, job_id=args.job_id)
        result = read(args.number, args.snapshot, args.log_object, args.log_bytes, host=args.host, start_line=args.start_line, max_lines=args.max_lines, pins=pins)
        if args.source_repo and result["packet"]["source_repository"]["full_name"] != args.source_repo:
            raise ValueError("CI log packet differs from the selected source repository")

    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, TypeError, KeyError, ReadFailure) as error:
        sys.exit(f"error: {error}")
