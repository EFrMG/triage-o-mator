#!/usr/bin/env python3
"""
Generate a markdown triage report from the ledger.

Usage:
    bin/report            writes reports/<owner>/<repo>/<date>.md and prints it
    bin/report --stdout    print only, don't write a file

Written for lead maintainers first: groups contributors marked ready, explicitly requested Pending review items, then suggested actions and the backlog. "[notes]" marks items whose ledger row has agent_notes (a code review or duplicate comparison) worth reading before acting.
"""

import argparse
import sys
from collections import Counter
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))  # absolute, never resolve: see work_root() in bin/_install.py
from _groups import list_groups
from _triage import REPO, REPORTS_DIR, action_operation, decision_text, has_decision, here, load_ledger, load_taxonomy, merge_ready


ACT_LIMIT = 20


def pct(n, total):
    return f"{(100 * n / total):.0f}%" if total else "0%"


def notes_mark(r):
    return " [notes]" if (r.get("agent_notes") or "").strip() else ""


def item_line(r, extra=""):
    return f"- [{r['kind']} #{r['number']}]({r['url']}) {r['title']}{extra}{notes_mark(r)}"


def ready_groups_section(groups, by_key):
    """Groups a contributor marked ready: the packets a lead maintainer can take in one sitting."""
    ready = [g for g in groups if g["status"] == "ready"]
    if not ready:
        return []

    lines = [f"## Ready for maintainers ({len(ready)} group{'' if len(ready) == 1 else 's'})", "", "Marked ready by contributors. Readiness means the group is organized for a decision; member decisions and GitHub writes remain separate.", ""]
    for g in ready:
        members = [(m, by_key.get((m["kind"], m["number"]))) for m in g["members"]]
        pending = sum(1 for _, r in members if r and r.get("review_request"))
        untriaged = sum(1 for _, r in members if r and not has_decision(r))
        flags = ", ".join(x for x in (f"{pending} pending review" if pending else "", f"{untriaged} untriaged" if untriaged else "") if x)
        lines.append(f"### {g['title']}")
        lines.append("")
        lines.append(f"Assignee: {g['assignee'] or '(unassigned)'} · {len(members)} items{' · ' + flags if flags else ''} · ID: `{g['id']}` (`bin/group export {g['id']}`)")
        lines.append("")
        if g["description"].strip():
            lines += [g["description"].strip(), ""]

        for m, r in members:
            if r is None:
                lines.append(f"- {m['kind']} #{m['number']} (missing from ledger)")

                continue

            decision = f"`{decision_text(r)}` {r['confidence']}".strip() if has_decision(r) else "untriaged"
            review = "pending review" if r.get("review_request") else ""
            note = f": {m['notes'].strip()}" if m["notes"].strip() else ""
            lines.append(f"- [{r['kind']} #{r['number']}]({r['url']}) {r['title']} ({r['state']}; {decision}{'; ' + review if review else ''}){notes_mark(r)}{note}")

        lines.append("")

    return lines


def render(ledger):
    taxonomy = load_taxonomy()
    open_items = [r for r in ledger if r["state"] == "open"]
    issues = [r for r in open_items if r["kind"] == "issue"]
    prs = [r for r in open_items if r["kind"] == "pr"]
    triaged = [r for r in open_items if has_decision(r)]
    untriaged = [r for r in open_items if not has_decision(r)]
    pending_review = [r for r in ledger if r.get("review_request")]

    lines = []
    lines.append(f"# Repository triage report. {date.today().isoformat()}")
    lines.append("")
    lines.append(f"Repo: `{REPO}`")
    lines.append("")
    lines.append("## Overview")
    lines.append("")
    lines.append(
        f"- Open issues: **{len(issues)}**, open PRs: **{len(prs)}** ({len(open_items)} total)"
    )
    lines.append(
        f"- Triaged: **{len(triaged)}** ({pct(len(triaged), len(open_items))})"
    )
    lines.append(f"- Pending review (explicit requests): **{len(pending_review)}**")
    lines.append(f"- Untriaged backlog: **{len(untriaged)}**")
    lines.append("")

    groups = list_groups()
    by_key = {(r["kind"], r["number"]): r for r in ledger}
    lines += ready_groups_section(groups, by_key)

    if pending_review:
        lines.append(f"## Pending review ({len(pending_review)})")
        lines.append("")
        lines.append("Items explicitly flagged for a person's attention. The request is not a ledger verdict or GitHub write approval.")
        lines.append("")
        for r in sorted(pending_review, key=lambda r: r["review_request"]["at"])[:ACT_LIMIT]:
            request = r["review_request"]
            lines.append(item_line(r, f" — {request['reason']} (requested by {request['by']})"))
        if len(pending_review) > ACT_LIMIT:
            lines.append(f"- ...and {len(pending_review) - ACT_LIMIT} more")
        lines.append("")

    actionable = [r for r in triaged if action_operation(taxonomy, r["action"]) not in ("", "none")]
    if actionable:
        lines.append(f"## Suggested actions ({len(actionable)})")
        lines.append("")
        lines.append("Local suggestions. Their exact GitHub writes use separate proposals, repository policy and approvals.")
        lines.append("")
        by_action = {}
        for r in actionable:
            by_action.setdefault(r["action"], []).append(r)

        for action, items in sorted(by_action.items(), key=lambda kv: -len(kv[1])):
            lines.append(f"### {action} ({len(items)})")
            lines.append("")
            for r in sorted(items, key=lambda r: r["created_at"])[:ACT_LIMIT]:
                lines.append(item_line(r, f" — {r['reason']}"))

            if len(items) > ACT_LIMIT:
                lines.append(f"- ...and {len(items) - ACT_LIMIT} more")

            lines.append("")

    unmapped = [r for r in triaged if r["action"] and not action_operation(taxonomy, r["action"])]
    if unmapped:
        lines.append(f"## Saved actions without a GitHub operation ({len(unmapped)})")
        lines.append("")
        lines.append("These saved decisions remain readable. Map their action titles in Settings before treating them as GitHub write recommendations.")
        lines.append("")
        for r in unmapped[:ACT_LIMIT]:
            lines.append(item_line(r, f" — `{r['action']}`: {r['reason']}"))
        if len(unmapped) > ACT_LIMIT:
            lines.append(f"- ...and {len(unmapped) - ACT_LIMIT} more")
        lines.append("")

    for kind, items in (("Issue", issues), ("PR", prs)):
        labels = Counter(name for r in items for name in (r.get("proposed_labels") or []))
        if labels:
            lines.append(f"## {kind} proposed labels")
            lines.append("")
            lines.append("Items may have several proposed labels; these counts are local decisions, not GitHub changes.")
            lines.append("")
            lines.append("| label | items | % of open |")
            lines.append("|---|---|---|")
            for name, n in labels.most_common():
                lines.append(f"| {name} | {n} | {pct(n, len(items))} |")
            lines.append("")

    merge_ready_items = [
        r
        for r in prs
        if merge_ready(r)
        and r["confidence"] == "high"
    ]
    if merge_ready_items:
        lines.append(
            f"## High-confidence merge-ready PR suggestions ({len(merge_ready_items)})"
        )
        lines.append("")
        for r in sorted(merge_ready_items, key=lambda r: r["created_at"])[:30]:
            lines.append(item_line(r, f" — {r['reason']}"))

        if len(merge_ready_items) > 30:
            lines.append(f"- ...and {len(merge_ready_items) - 30} more")

        lines.append("")

    close_candidates = [
        r
        for r in open_items
        if action_operation(taxonomy, r["action"]) == "close"
    ]
    if close_candidates:
        lines.append(f"## Close suggestions ({len(close_candidates)})")
        lines.append("")
        for r in sorted(close_candidates, key=lambda r: r["created_at"])[:30]:
            lines.append(item_line(r, f" — `{r['action']}`: {r['reason']}"))

        if len(close_candidates) > 30:
            lines.append(f"- ...and {len(close_candidates) - 30} more")

        lines.append("")

    if untriaged:
        lines.append(f"## Oldest untriaged items ({len(untriaged)} total, showing 15)")
        lines.append("")
        for r in sorted(untriaged, key=lambda r: r["created_at"])[:15]:
            lines.append(
                f"- [{r['kind']} #{r['number']}]({r['url']}) {r['title']} (opened {r['created_at'][:10]})"
            )

        lines.append("")

    other_groups = [g for g in groups if g["status"] != "ready"]
    if other_groups:
        lines += [
            "## Other review groups",
            "",
            "Drafts are still being organized; archived groups are kept for reference.",
            "",
        ]
        for group in other_groups:
            lines.append(
                f"- **{group['title']}** ({group['status']}, {len(group['members'])} items) — assignee: {group['assignee'] or '(unassigned)'}; ID: `{group['id']}`"
            )

        lines.append("")

    triagers = Counter(r["triaged_by"] or "(unknown)" for r in triaged)
    if triagers:
        lines += ["## Contributors (open items)", "", "| who | triaged |", "|---|---|"]
        for who, count in triagers.most_common():
            lines.append(f"| {who} | {count} |")

        lines.append("")

    return "\n".join(lines) + "\n"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--stdout", action="store_true", help="print only, don't write to reports/"
    )
    args = ap.parse_args()

    ledger = load_ledger()
    if not ledger:
        sys.exit(here("error: ledger is empty. Run bin/fetch && bin/sync first."))

    text = render(ledger)
    print(text)

    if not args.stdout:
        REPORTS_DIR.mkdir(parents=True, exist_ok=True)
        out_path = REPORTS_DIR / f"{date.today().isoformat()}.md"
        out_path.write_text(text)
        print(f"(written to {out_path})", file=sys.stderr)


if __name__ == "__main__":
    main()
