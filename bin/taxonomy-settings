#!/usr/bin/env python3
"""Edit local taxonomy actions and guidance or migrate old defaults; never write to GitHub."""

import argparse
import hashlib
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).absolute().parent))
from _storage import atomic_writer, locked
from _triage import LEGACY_ACTION_OPERATIONS, REPO, TAXONOMY_PATH


SIMPLE_ACTIONS = ["none", "comment", "close", "reopen"]
SIMPLE_GUIDANCE = {
    "none": "No conversation or state change is justified now. Proposed labels remain independent.",
    "comment": "Use Reason to say what to ask or explain. Draft the exact public comment during the action pass.",
    "close": "Use Reason to name the checkable closure basis. Publish an explanation before closing.",
    "reopen": "Use Reason to explain what remains unresolved. Publish an explanation before reopening.",
}
RETIRED_DEFAULTS = set(LEGACY_ACTION_OPERATIONS)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["set-guidance", "create-action", "update-action", "simplify-actions"])
    target = parser.add_mutually_exclusive_group()
    target.add_argument("--label-id", type=int)
    target.add_argument("--action")
    parser.add_argument("--value", help="legacy guidance text")
    parser.add_argument("--expected", help="the guidance shown when editing began")
    parser.add_argument("--expected-name", help="the GitHub label name shown when editing began")
    parser.add_argument("--name", help="new action title")
    parser.add_argument("--description", help="new action description")
    parser.add_argument("--operation", choices=["comment", "close", "reopen", "none"], help="GitHub operation for this action")
    parser.add_argument("--expected-operation", help="the operation shown when editing began")
    parser.add_argument("--expected-repo", required=True)
    parser.add_argument("--apply", action="store_true", help="apply the previewed action migration")
    parser.add_argument("--preview-sha256", help="checksum returned by a migration preview")
    args = parser.parse_args()
    if args.expected_repo != REPO:
        parser.error("configured repository changed; reopen Settings")
    if args.command == "set-guidance":
        if (args.label_id is None and args.action is None) or args.value is None or args.expected is None:
            parser.error("set-guidance requires a target, --value and --expected")
        if len(args.value) > 4000 or "\x00" in args.value:
            parser.error("guidance must be at most 4000 characters and contain no NUL")
    elif args.command != "simplify-actions":
        if args.label_id is not None or args.name is None or args.description is None or args.operation is None:
            parser.error("action changes require --name, --description and --operation, without --label-id")
        if args.command == "update-action" and (args.action is None or args.expected is None or args.expected_operation is None):
            parser.error("update-action requires --action, --expected and --expected-operation")
        if args.command == "create-action" and args.action is not None:
            parser.error("create-action does not accept --action")
        if not args.name.strip() or args.name != args.name.strip() or "\n" in args.name or "\x00" in args.name:
            parser.error("action title must be a nonempty single line")
        if len(args.description) > 4000 or "\x00" in args.description:
            parser.error("action description must be at most 4000 characters and contain no NUL")
    elif args.apply != bool(args.preview_sha256):
        parser.error("simplify-actions requires both --apply and --preview-sha256 to write")

    with locked(TAXONOMY_PATH):
        try:
            original = TAXONOMY_PATH.read_bytes()
            taxonomy = json.loads(original)
        except (OSError, ValueError) as error:
            parser.exit(1, f"error: could not read {TAXONOMY_PATH}: {error}\n")

        if not isinstance(taxonomy, dict):
            parser.exit(1, "error: taxonomy must be a JSON object\n")

        if args.command == "simplify-actions":
            actions = taxonomy.get("actions")
            guidance = taxonomy.get("action_guidance")
            operations = taxonomy.get("action_operations")
            if not isinstance(actions, list) or not all(isinstance(name, str) for name in actions) or len(set(actions)) != len(actions) or not isinstance(guidance, dict) or not isinstance(operations, dict):
                parser.exit(1, "error: actions, descriptions or operations are malformed; repair taxonomy.json before migrating\n")
            for name in SIMPLE_ACTIONS:
                if name in operations and operations[name] != name:
                    parser.exit(1, f"error: {name} has a conflicting operation; repair taxonomy.json before migrating\n")

            before = list(actions)
            taxonomy["actions"] = SIMPLE_ACTIONS + [name for name in actions if name not in RETIRED_DEFAULTS and name not in SIMPLE_ACTIONS]
            for name, operation in {**{name: name for name in SIMPLE_ACTIONS}, **LEGACY_ACTION_OPERATIONS}.items():
                operations.setdefault(name, operation)
            for name, description in SIMPLE_GUIDANCE.items():
                guidance.setdefault(name, description)

            preview_sha256 = hashlib.sha256(original).hexdigest()
            if args.apply:
                if args.preview_sha256 != preview_sha256:
                    parser.exit(1, "error: taxonomy changed since preview; preview again\n")
                if taxonomy["actions"] != before or taxonomy != json.loads(original):
                    with atomic_writer(TAXONOMY_PATH) as out:
                        out.write(json.dumps(taxonomy, indent=2, ensure_ascii=False) + "\n")

            print(json.dumps({"before": before, "after": taxonomy["actions"], "retained_legacy_mappings": sorted(RETIRED_DEFAULTS & operations.keys()), "updated": taxonomy != json.loads(original), "applied": args.apply, "preview_sha256": preview_sha256}))
            return

        if args.command != "set-guidance":
            actions = taxonomy.get("actions", [])
            guidance = taxonomy.setdefault("action_guidance", {})
            operations = taxonomy.setdefault("action_operations", {})
            if not isinstance(actions, list) or not all(isinstance(name, str) for name in actions) or not isinstance(guidance, dict) or not isinstance(operations, dict):
                parser.exit(1, "error: actions, descriptions or operations are malformed; repair taxonomy.json before editing\n")
            if any(name.casefold() == args.name.casefold() and name != args.action for name in actions):
                parser.exit(1, "error: an action with this title already exists\n")
            if args.command == "create-action":
                if args.name in actions:
                    parser.exit(1, "error: action already exists\n")
                actions.append(args.name)
                guidance[args.name] = args.description
                operations[args.name] = args.operation
                updated = True
            else:
                if args.action not in actions or guidance.get(args.action, "") != args.expected or operations.get(args.action, "") != args.expected_operation:
                    parser.exit(1, "error: action changed since editing began; reopen Settings\n")
                updated = args.name != args.action or args.description != args.expected or args.operation != args.expected_operation
                if updated:
                    actions[actions.index(args.action)] = args.name
                    if args.name != args.action:
                        guidance.pop(args.action, None)
                        operations.pop(args.action, None)
                    guidance[args.name] = args.description
                    operations[args.name] = args.operation
            if updated:
                with atomic_writer(TAXONOMY_PATH) as out:
                    out.write(json.dumps(taxonomy, indent=2, ensure_ascii=False) + "\n")
            print(json.dumps({"updated": updated}))
            return

        if args.label_id is not None:
            if args.expected_name is None:
                parser.error("--expected-name is required with --label-id")
            catalog = taxonomy.get("label_catalog", {})
            if not isinstance(catalog, dict) or not isinstance(catalog.get("labels"), list):
                parser.exit(1, "error: label catalog is malformed; repair taxonomy.json before editing\n")
            if catalog.get("repository") != REPO or catalog.get("status") != "observed":
                parser.exit(1, "error: label catalog is pending or belongs to another repository; sync it first\n")

            rows = [row for row in catalog["labels"] if isinstance(row, dict) and row.get("id") == args.label_id]
            if len(rows) != 1:
                parser.exit(1, "error: label was renamed, removed, or is absent; reopen Settings\n")

            row = rows[0]
            if row.get("name") != args.expected_name:
                parser.exit(1, "error: label name changed since editing began; reopen Settings\n")
            current = row.get("guidance", "")
        else:
            if args.action not in taxonomy.get("actions", []):
                parser.exit(1, "error: action is absent; reopen Settings\n")

            guidance = taxonomy.setdefault("action_guidance", {})
            if not isinstance(guidance, dict):
                parser.exit(1, "error: action guidance is malformed; repair taxonomy.json before editing\n")
            current = guidance.get(args.action, "")

        if current != args.expected:
            parser.exit(1, "error: guidance changed since editing began; reopen Settings\n")

        if args.value != current:
            if args.label_id is not None:
                row["guidance"] = args.value
            else:
                guidance[args.action] = args.value

            with atomic_writer(TAXONOMY_PATH) as out:
                out.write(json.dumps(taxonomy, indent=2, ensure_ascii=False) + "\n")

    print(json.dumps({"updated": args.value != current}))


if __name__ == "__main__":
    main()
